APP_ENV=local
APP_DEBUG=true

# Database Configuration
# For SQLite (default):
DB_PATH=database.sqlite
# For MySQL (production):
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=fratellanza_db
# DB_USERNAME=root
# DB_PASSWORD=secret

# TOTP 2FA Encryption Key (run: php bin/setup/generate_totp_key.php)
TOTP_ENCRYPTION_KEY=

# SMTP Email Configuration
SMTP_HOST=smtp.example.com
SMTP_USER=user@example.com
SMTP_PASS=secret
SMTP_PORT=587

