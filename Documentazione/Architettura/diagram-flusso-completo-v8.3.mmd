    subgraph FLOW4 [" 4️⃣ DOCUMENT VAULT FLOW "]
        START_VAULT([📁 Socio upload documento]):::startNode
        SELECT_FILE[Seleziona File:<br/>PDF, DOCX, JPG]:::processNode
