    %% =====================================================
    %% FLUSSO 6: SECURITY PIPELINE (Middleware Chain)
    %% =====================================================
    subgraph FLOW6 [" 6️⃣ SECURITY PIPELINE FLOW "]
        START_REQ([🌐 HTTP Request]):::startNode
        MW_HEADERS[SecurityHeadersMiddleware:<br/>Add CSP, HSTS, X-Frame]:::securityNode
        MW_RATE{RateLimitMiddleware:<br/>Redis Check<br/>Max 100 req/min}:::decisionNode
        MW_CORS[CORS Check:<br/>Origin allowed?]:::securityNode
        MW_CSRF{CsrfMiddleware:<br/>Token valido?}:::decisionNode
        MW_BODY[BodyParserMiddleware:<br/>Parse JSON/Form]:::processNode
        MW_AUTH{AuthMiddleware:<br/>Session valida?}:::decisionNode
        MW_2FA{2FA verificato?}:::decisionNode
        MW_RBAC{AdminMiddleware:<br/>Ha permesso?}:::decisionNode
        MW_AUDIT[AuditLogger:<br/>Log Request]:::securityNode
        CONTROLLER[Controller:<br/>Esegue Business Logic]:::processNode
        END_SEC([✅ Response 200 OK]):::endNode
        ERROR_401([❌ 401 Unauthorized]):::errorNode
        ERROR_403([❌ 403 Forbidden]):::errorNode
        ERROR_429([❌ 429 Too Many Requests]):::errorNode

        START_REQ --> MW_HEADERS --> MW_RATE
        MW_RATE -->|Limit Exceeded| ERROR_429
        MW_RATE -->|OK| MW_CORS --> MW_CSRF
        MW_CSRF -->|Invalid| ERROR_403
        MW_CSRF -->|Valid| MW_BODY --> MW_AUTH
        MW_AUTH -->|Guest| ERROR_401
        MW_AUTH -->|Authenticated| MW_2FA
        MW_2FA -->|Not Verified| ERROR_401
        MW_2FA -->|Verified| MW_RBAC
        MW_RBAC -->|Forbidden| ERROR_403
        MW_RBAC -->|Allowed| MW_AUDIT
        MW_AUDIT --> CONTROLLER --> END_SEC
    end

    %% =====================================================
