    subgraph FLOW1 [" 1️⃣ USER REGISTRATION FLOW "]
        START_REG([🚀 Utente visita Landing Page]):::startNode
        CLICK_DEMO[Clicca 'Richiedi Demo']:::processNode
        FILL_FORM[Compila Form Registrazione<br/>Nome, Email, Telefono, Organizzazione]:::processNode
