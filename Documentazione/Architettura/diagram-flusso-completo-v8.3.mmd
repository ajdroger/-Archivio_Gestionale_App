    %% FLUSSO 2: SOCIO CRUD COMPLETO
    %% =====================================================
    subgraph FLOW2 [" 2️⃣ SOCIO CREATE/UPDATE/DELETE FLOW "]
        START_CRUD([🎯 Admin apre Form Socio]):::startNode
        FILL_SOCIO[Compila Dati:<br/>Nome, CF, Email, Residenza]:::processNode
        CALC_CF[FiscalCodeCalculator:<br/>Calcola CF automatico]:::processNode
        VALIDATE_CF{CF valido?<br/>16 caratteri<br/>CIN corretto?}:::decisionNode
        VALIDATE_SOCIO[ValidationService:<br/>Valida tutti campi]:::processNode
        UPLOAD_DOC[Upload Documenti:<br/>Carta Identità, Foto]:::processNode
        VIRUS_SCAN[Security Scan:<br/>ClamAV check]:::securityNode
        VIRUS_FOUND{Virus<br/>rilevato?}:::decisionNode
        GEN_PDF[PdfGenerationService:<br/>Genera Modulo Iscrizione PDF]:::processNode
        START_TX[(Database:<br/>BEGIN TRANSACTION)]:::dataNode
        SAVE_SOCIO[(PDOSocioRepository:<br/>INSERT socio)]:::dataNode
        SAVE_DOCS[(PDODocumentoRepository:<br/>INSERT documenti)]:::dataNode
        AUDIT_LOG[AuditLogger:<br/>Log CREATE_SOCIO]:::securityNode
        COMMIT_TX[(Database:<br/>COMMIT)]:::dataNode
        ROLLBACK_TX[(Database:<br/>ROLLBACK)]:::dataNode
        SEND_WELCOME[EmailService:<br/>Invia Email Benvenuto + PDF]:::processNode
        END_CRUD([✅ Socio Creato]):::endNode
        ERROR_CRUD([❌ Errore Creazione]):::errorNode

        START_CRUD --> FILL_SOCIO --> CALC_CF
        CALC_CF --> VALIDATE_CF
        VALIDATE_CF -->|Invalid| ERROR_CRUD
        VALIDATE_CF -->|Valid| VALIDATE_SOCIO
        VALIDATE_SOCIO --> UPLOAD_DOC --> VIRUS_SCAN
        VIRUS_SCAN --> VIRUS_FOUND
        VIRUS_FOUND -->|Yes| ERROR_CRUD
        VIRUS_FOUND -->|No| GEN_PDF
        GEN_PDF --> START_TX --> SAVE_SOCIO
        SAVE_SOCIO --> SAVE_DOCS --> AUDIT_LOG
        AUDIT_LOG --> COMMIT_TX
        SAVE_SOCIO -.->|Error| ROLLBACK_TX
        SAVE_DOCS -.->|Error| ROLLBACK_TX
        ROLLBACK_TX --> ERROR_CRUD
        COMMIT_TX --> SEND_WELCOME --> END_CRUD
    end

