        DUP_CHECK{Duplicate Check<br/>Email già registrata?}:::decisionNode
        GEN_MATRICOLA[RegistrationService:<br/>Genera Matricola Univoca]:::processNode
        GEN_PASSWORD[PasswordHasher:<br/>Hash Password Bcrypt]:::processNode
        SAVE_DB[(PDOSocioRepository:<br/>Salva su Database)]:::dataNode
        SEND_EMAIL[EmailService:<br/>Invia Email Verifica]:::processNode
        EMAIL_VERIFY{Utente clicca<br/>link verifica?}:::decisionNode
        ACTIVATE_ACCOUNT[Attiva Account]:::processNode
        SETUP_2FA[TwoFactorController:<br/>Setup 2FA TOTP]:::securityNode
        GEN_QR[Genera QR Code<br/>Google Authenticator]:::processNode
        VERIFY_2FA{Verifica Codice<br/>6 cifre}:::decisionNode
        ENABLE_2FA[Abilita 2FA<br/>Cripta Secret AES-256-GCM]:::securityNode
        FIRST_LOGIN[Login con credenziali]:::processNode
        END_REG([✅ Registrazione Completa<br/>Accesso al Sistema]):::endNode
        ERROR_REG([❌ Errore Registrazione]):::errorNode

        START_REG --> CLICK_DEMO --> FILL_FORM --> VALIDATE_INPUT
        VALIDATE_INPUT -->|Valid| SANITIZE
        VALIDATE_INPUT -->|Invalid| ERROR_REG
        SANITIZE --> DUP_CHECK
        DUP_CHECK -->|Duplicate| ERROR_REG
        DUP_CHECK -->|Unique| GEN_MATRICOLA
        GEN_MATRICOLA --> GEN_PASSWORD --> SAVE_DB
        SAVE_DB --> SEND_EMAIL --> EMAIL_VERIFY
        EMAIL_VERIFY -->|No| ERROR_REG
        EMAIL_VERIFY -->|Yes| ACTIVATE_ACCOUNT
        ACTIVATE_ACCOUNT --> SETUP_2FA --> GEN_QR
        GEN_QR --> VERIFY_2FA
        VERIFY_2FA -->|Invalid| ERROR_REG
        VERIFY_2FA -->|Valid| ENABLE_2FA
        ENABLE_2FA --> FIRST_LOGIN --> END_REG
    end

