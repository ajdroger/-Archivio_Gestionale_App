{{> layout_header }}
<!-- Page Specific CSS -->
<link rel="stylesheet" href="{{base_url}}/css/pages/socio_create.css">

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-10">
            
            <!-- Header Dossier (Simplified for Public) -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h4 class="text-white fw-bold mb-1"><i class="fa-solid fa-user-plus text-primary me-2"></i>DOMANDA DI AMMISSIONE</h4>
                    <p class="text-secondary small mb-0 font-monospace text-uppercase opacity-75">MODULO DI ISCRIZIONE ONLINE / MCAG 2026</p>
                </div>
            </div>

            <form action="{{base_url}}/soci/salva" method="POST" id="dossierForm">
                <!-- Data Security -->
                <input type="hidden" name="csrf_name" value="{{csrf.name}}">
                <input type="hidden" name="csrf_value" value="{{csrf.value}}">

                <!-- Dossier Container -->
                <div class="card bg-dark border-secondary shadow-lg overflow-hidden position-relative">
                    <div class="position-absolute top-0 start-0 w-100 h-1 bg-gradient-primary"></div>
                    
                    <!-- Profile Type Selector -->
                    <div class="px-4 pt-4 pb-2 border-bottom border-secondary bg-dark bg-opacity-50">
                        <div class="row align-items-center">
                            <div class="col-md-4">
                                <label class="text-secondary text-xs fw-bold text-uppercase mb-1">Tipologia Iscrizione</label>
                                <select id="tipo_profilo" name="tipo_profilo" class="form-select bg-dark border-secondary text-white fw-bold text-uppercase">
                                    <option value="MILITARE" selected>&#xf0a3; Personale Militare</option>
                                    <option value="CIVILE">&#xf007; Civile / Familiare</option>
                                    <option value="SIMPATIZZANTE">&#xf1ae; Simpatizzante</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Tabs Navigation -->
                    <div class="card-header bg-dark border-bottom border-secondary pt-0 px-0">
                        <ul class="nav nav-tabs nav-justified dossier-tabs card-header-tabs m-0 border-0" id="dossierTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active rounded-0 py-3 text-uppercase fw-bold text-xs ls-1 border-end border-secondary" id="tab-anagrafica" data-bs-toggle="tab" data-bs-target="#panel-anagrafica" type="button" role="tab">
                                    <i class="fa-solid fa-id-card me-2 text-primary"></i>1. Dati Anagrafici
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link rounded-0 py-3 text-uppercase fw-bold text-xs ls-1 border-end border-secondary" id="tab-militare" data-bs-toggle="tab" data-bs-target="#panel-militare" type="button" role="tab">
                                    <i class="fa-solid fa-person-military-rifle me-2 text-warning"></i>2. Servizio (Se Militare)
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link rounded-0 py-3 text-uppercase fw-bold text-xs ls-1" id="tab-sanitario" data-bs-toggle="tab" data-bs-target="#panel-sanitario" type="button" role="tab">
                                    <i class="fa-solid fa-heart-pulse me-2 text-danger"></i>3. Info Sanitarie
                                </button>
                            </li>
                        </ul>
                    </div>

                    <!-- Tabs Content (Identical to Socio Create but NO ADMIN TAB) -->
                    <div class="card-body p-4 p-lg-5 tab-content" id="dossierContent">
                        
                        <!-- PANEL 1: Anagrafica (Same as Create) -->
                        <div class="tab-pane fade show active" id="panel-anagrafica" role="tabpanel">
                             <h5 class="text-white mb-4 pb-2 border-bottom border-secondary text-uppercase fw-bold ls-1 fs-6 text-primary">
                                <i class="fa-solid fa-fingerprint me-2"></i>Dati Personali
                            </h5>
                            <!-- (Copying core fields for brevity of re-implementation, assuming standard layout) -->
                            <div class="row g-4">
                                <div class="col-md-6">
                                    <label class="form-label text-secondary text-xs fw-bold text-uppercase">Nome</label>
                                    <input type="text" name="nome" class="form-control bg-dark border-secondary text-white text-uppercase" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-secondary text-xs fw-bold text-uppercase">Cognome</label>
                                    <input type="text" name="cognome" class="form-control bg-dark border-secondary text-white text-uppercase" required>
                                </div>
                                 <div class="col-md-12">
                                    <label class="form-label text-secondary text-xs fw-bold text-uppercase">Codice Fiscale</label>
                                    <input type="text" name="codice_fiscale" class="form-control bg-dark border-secondary text-white text-uppercase font-monospace" required maxlength="16">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-secondary text-xs fw-bold text-uppercase">Email</label>
                                    <input type="email" name="email" class="form-control bg-dark border-secondary text-white" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-secondary text-xs fw-bold text-uppercase">Telefono</label>
                                    <input type="tel" name="telefono" class="form-control bg-dark border-secondary text-white" required>
                                </div>
                            </div>
                        </div>

                        <!-- PANEL 2: Militare -->
                        <div class="tab-pane fade" id="panel-militare" role="tabpanel">
                            <h5 class="text-white mb-4 pb-2 border-bottom border-secondary text-uppercase fw-bold ls-1 fs-6 text-warning">
                                <i class="fa-solid fa-medal me-2"></i>Dati di Servizio
                            </h5>
                            <div class="row g-4">
                                <div class="col-md-6">
                                    <label class="form-label text-secondary text-xs fw-bold text-uppercase">Grado</label>
                                    <input type="text" name="grado" class="form-control bg-dark border-secondary text-white text-uppercase">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-secondary text-xs fw-bold text-uppercase">Corpo</label>
                                    <input type="text" name="corpo_appartenenza" class="form-control bg-dark border-secondary text-white text-uppercase">
                                </div>
                            </div>
                        </div>

                         <!-- PANEL 3: Sanitario -->
                        <div class="tab-pane fade" id="panel-sanitario" role="tabpanel">
                            <h5 class="text-white mb-4 pb-2 border-bottom border-secondary text-uppercase fw-bold ls-1 fs-6 text-danger">
                                <i class="fa-solid fa-notes-medical me-2"></i>Contatti Emergenza
                            </h5>
                            <div class="row g-4">
                                <div class="col-12">
                                     <label class="form-label text-secondary text-xs fw-bold text-uppercase">Contatto ICE (In Case of Emergency)</label>
                                     <input type="text" name="contatto_emergenza" class="form-control bg-dark border-secondary text-white">
                                </div>
                            </div>
                        </div>

                    </div>
                    
                    <!-- Footer Actions -->
                    <div class="card-footer bg-dark border-top border-secondary p-4 d-flex justify-content-end align-items-center">
                        <button type="submit" class="btn btn-primary fw-bold text-uppercase ls-1 px-5 py-3 shadow-lg">
                            <i class="fa-solid fa-paper-plane me-2"></i>Invia Domanda
                        </button>
                    </div>
                </div>
            </form>

        </div>
    </div>
</div>

<script src="{{base_url}}/js/pages/socio_create.js"></script>

{{> layout_footer }}
