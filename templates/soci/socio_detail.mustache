{{> layout_header }}
<div class="row">
    <div class="col-md-4 mb-4">
        <!-- IDENTITY CARD DOSSIER -->
        <div class="card border-0 shadow-lg h-100 bg-dark text-white overflow-hidden position-relative">
            <!-- BACKGROUND WATERMARK -->
            <div class="position-absolute top-50 start-50 translate-middle opacity-10" style="font-size: 10rem; color: rgba(255,255,255,0.05); pointer-events: none;">
                <i class="fa-solid fa-user-shield"></i>
            </div>
            
            <!-- CLASSIFIED STAMP -->
            <div class="position-absolute top-0 end-0 p-3" style="opacity: 0.7; transform: rotate(15deg); pointer-events: none;">
               <span class="border border-danger text-danger px-3 py-1 fw-bold font-monospace text-uppercase" style="letter-spacing: 2px;">Classified</span>
            </div>

            <div class="card-header bg-transparent py-4 border-bottom border-secondary text-center position-relative z-1">
                <div class="avatar-initial rounded-circle bg-primary bg-opacity-10 text-primary mx-auto mb-3 d-flex align-items-center justify-content-center fw-bold shadow-lg position-relative" style="width: 100px; height: 100px; font-size: 2.5rem; border: 4px solid rgba(56, 189, 248, 0.3);">
                    {{socio.nome.0}}{{socio.cognome.0}}
                    <div class="position-absolute bottom-0 end-0 bg-dark rounded-circle p-1 border border-secondary">
                        <i class="fa-solid fa-check-circle text-success fs-5"></i>
                    </div>
                </div>
                <h4 class="mb-0 fw-bold">{{socio.nome}} {{socio.cognome}}</h4>
                <div class="font-monospace text-info small mt-1">{{socio.matricola}}</div>
                
                <!-- RIBBON RACK (GAMIFICATION) -->
                <div class="d-flex justify-content-center gap-2 mt-3 flex-wrap">
                    {{#intelligence.awards}}
                    <div class="ribbon-badge p-1 bg-dark bg-opacity-50 rounded border border-secondary border-opacity-50" title="{{name}}: {{desc}}" data-bs-toggle="tooltip">
                        <i class="fa-solid {{icon}}" style="color: {{color}};"></i>
                    </div>
                    {{/intelligence.awards}}
                </div>
            </div>

            <div class="card-body position-relative z-1">
                <div class="row g-3">
                    <div class="col-12">
                        <small class="text-secondary text-uppercase x-small fw-bold tracking-wider">Grado & Qualifica</small>
                        <div class="d-flex align-items-center gap-2 mt-1">
                             <span class="badge bg-secondary bg-opacity-25 border border-secondary border-opacity-25 text-white">{{socio.grado}}</span>
                             <span class="text-white small text-uppercase opacity-75">{{socio.corpo}}</span>
                        </div>
                    </div>
                    <div class="col-12">
                        <small class="text-secondary text-uppercase x-small fw-bold tracking-wider">Contatti Operativi</small>
                        <div class="bg-black bg-opacity-25 p-3 rounded border border-secondary border-opacity-25 mt-1">
                            <div class="d-flex align-items-center gap-2 text-white small mb-2">
                                <i class="fa-solid fa-envelope text-primary opacity-50" style="width: 20px;"></i> {{socio.email}}
                            </div>
                            <div class="d-flex align-items-center gap-2 text-white small">
                                <i class="fa-solid fa-phone text-success opacity-50" style="width: 20px;"></i> {{socio.telefono}}
                            </div>
                        </div>
                    </div>
                     <div class="col-12">
                        <small class="text-secondary text-uppercase x-small fw-bold tracking-wider">Stato di Servizio</small>
                        <div class="mt-1">
                            {{#socio.is_attivo}}
                            <div class="alert alert-success bg-opacity-10 border-success border-opacity-25 py-2 mb-0 d-flex align-items-center">
                                <i class="fa-solid fa-circle-check me-2"></i> SERVIZIO ATTIVO
                            </div>
                            {{/socio.is_attivo}}
                            {{^socio.is_attivo}}
                             <div class="alert alert-secondary bg-opacity-10 border-secondary border-opacity-25 py-2 mb-0 d-flex align-items-center">
                                <i class="fa-solid fa-box-archive me-2"></i> CONGEDO / ARCHIVIO
                            </div>
                            {{/socio.is_attivo}}
                        </div>
                    </div>
                </div>

                <hr class="border-secondary opacity-25 my-4">

                <!-- OPERATION BUTTONS -->
                <div class="d-grid gap-2">
                    <button class="btn btn-outline-light d-flex justify-content-between align-items-center" onclick="window.print()">
                        <span><i class="fa-solid fa-id-card me-2"></i>Stampa Badge</span>
                        <i class="fa-solid fa-chevron-right small opacity-50"></i>
                    </button>
                    <a href="{{base_url}}/soci/{{socio.cf}}/edit" class="btn btn-warning d-flex justify-content-between align-items-center fw-bold text-dark shadow-warning">
                         <span><i class="fa-solid fa-pen-to-square me-2"></i>Modifica Dati</span>
                         <i class="fa-solid fa-chevron-right small opacity-50"></i>
                    </a>
                </div>
            </div>
            <div class="card-footer bg-black bg-opacity-25 border-top border-secondary text-center small text-secondary py-3">
                 <i class="fa-solid fa-calendar-check me-1"></i> Iscritto dal: <span class="text-white">{{socio.data_iscrizione}}</span>
            </div>
        </div>
    </div>

    <div class="col-md-8 mb-4">
        <!-- INTELLIGENCE ROW -->
        <div class="row g-4 mb-4">
            <!-- SERVICE TIMELINE -->
            <div class="col-lg-6">
                <div class="card border-0 shadow bg-dark h-100">
                    <div class="card-header bg-transparent border-bottom border-secondary">
                        <small class="text-secondary fw-bold text-uppercase tracking-wider"><i class="fa-solid fa-timeline me-2 text-info"></i>Service Timeline</small>
                    </div>
                    <div class="card-body">
                        <div class="timeline-simple">
                            {{#intelligence.service_history}}
                            <div class="d-flex gap-3 mb-3">
                                <div class="d-flex flex-column align-items-center">
                                    <div class="rounded-circle bg-{{color}} bg-opacity-25 text-{{color}} border border-{{color}} border-opacity-50 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 35px; height: 35px;">
                                        <i class="fa-solid {{icon}} small"></i>
                                    </div>
                                    <div class="h-100 border-start border-secondary border-opacity-25 my-1" style="width: 1px;"></div>
                                </div>
                                <div class="pb-3">
                                    <h6 class="text-white mb-0 fw-bold small">{{title}}</h6>
                                    <p class="text-secondary x-small mb-1 opacity-75">{{desc}}</p>
                                    <span class="badge bg-black border border-secondary text-secondary rounded-pill x-small font-monospace">{{date}}</span>
                                </div>
                            </div>
                            {{/intelligence.service_history}}
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- ACCESS LOG -->
            <div class="col-lg-6">
                 <div class="card border-0 shadow bg-dark h-100">
                    <div class="card-header bg-transparent border-bottom border-secondary d-flex justify-content-between">
                        <small class="text-secondary fw-bold text-uppercase tracking-wider"><i class="fa-solid fa-shoe-prints me-2 text-warning"></i>Digital Footprint</small>
                        <span class="badge bg-secondary bg-opacity-25 text-secondary border border-secondary border-opacity-10 rounded-pill x-small">Last 5</span>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-dark table-hover table-sm mb-0 small checkbox-table-cells">
                                <thead class="text-secondary opacity-50 bg-black bg-opacity-25">
                                    <tr>
                                        <th class="ps-3 py-2">Timestamp</th>
                                        <th class="py-2">Evento Audit</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#intelligence.access_log}}
                                    <tr>
                                        <td class="ps-3 text-secondary font-monospace border-secondary border-opacity-10">{{date}}</td>
                                        <td class="text-white border-secondary border-opacity-10">
                                            <i class="fa-solid fa-circle text-{{status}} x-small me-2 opacity-75"></i> {{action}}
                                        </td>
                                    </tr>
                                    {{/intelligence.access_log}}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-lg" style="min-height: 750px; background: rgba(30, 41, 59, 0.4); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.05) !important;">
            <div class="card-header bg-transparent py-4 border-bottom border-secondary d-flex justify-content-between align-items-center">
                <h5 class="mb-0 text-white fw-bold"><i class="fa-solid fa-vault me-2 text-primary"></i>VAULT DOCUMENTI</h5>
                <span class="badge bg-dark text-info border border-info border-opacity-25 px-3 py-2"><i class="fa-solid fa-file-shield me-2"></i>{{documenti.length}} FILES</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive" style="max-height: 550px; overflow-y: auto;">
                    <table class="table table-dark table-hover align-middle mb-0" style="background: transparent;">
                        <thead class="text-uppercase small text-secondary" style="background: rgba(15, 23, 42, 0.5);">
                            <tr>
                                <th class="ps-4 py-3 border-secondary" style="width: 20%;">Categorizzazione</th>
                                <th class="border-secondary" style="width: 40%;">Asset Name</th>
                                <th class="text-center border-secondary" style="width: 15%;">Integrità</th>
                                <th class="text-end pe-4 border-secondary" style="width: 25%;">Terminal</th>
                            </tr>
                        </thead>
                        <tbody class="border-top-0">
                            {{#documenti}}
                            <tr style="transition: all 0.2s; border-left: 2px solid var(--bs-{{type_color}});">
                                <td class="ps-4">
                                    <span class="badge bg-{{type_color}} bg-opacity-10 text-{{type_color}} border border-{{type_color}} border-opacity-25 small fw-bold">
                                        <i class="fa-solid {{type_icon}} me-2"></i>{{tipo}}
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-bold text-white small">{{nome_file}}</div>
                                    <small class="text-secondary opacity-50 font-monospace" style="font-size: 0.7rem;">UID: {{id}}</small>
                                </td>
                                <td class="text-center">
                                    {{#stato}}
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2">
                                            <i class="fa-solid fa-shield-check me-1"></i>VERIFIED
                                        </span>
                                    {{/stato}}
                                    {{^stato}}
                                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2">
                                            <i class="fa-solid fa-hourglass-half me-1"></i>PENDING
                                        </span>
                                    {{/stato}}
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a href="{{base_url}}/soci/{{socio_cf}}/documenti/{{id}}/download" 
                                           class="btn btn-sm btn-outline-primary border-primary border-opacity-25" 
                                           title="Download">
                                            <i class="fa-solid fa-cloud-arrow-down"></i>
                                        </a>
                                        
                                        <form action="{{base_url}}/soci/{{socio_cf}}/documenti/{{id}}/elimina" 
                                              method="POST" 
                                              onsubmit="return confirm('CONFERMA ELIMINAZIONE FISICA: L\'operazione è irreversibile e verrà tracciata nell\'audit trail.');">
                                            <input type="hidden" name="csrf_name" value="{{csrf_name}}">
                                            <input type="hidden" name="csrf_value" value="{{csrf_value}}">
                                            <button type="submit" 
                                                    class="btn btn-sm btn-outline-danger border-danger border-opacity-25" 
                                                    title="Remove Asset">
                                                <i class="fa-solid fa-eraser"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            {{/documenti}}
                            {{^documenti}}
                            <tr>
                                <td colspan="4" class="text-center py-5">
                                    <div class="text-secondary opacity-25 mb-4">
                                        <i class="fa-solid fa-folder-open fa-5x"></i>
                                    </div>
                                    <h5 class="text-secondary fw-light">Nessun file crittografato nel vault</h5>
                                    <p class="text-secondary small">Eseguire l'upload per caricare un nuovo asset.</p>
                                </td>
                            </tr>
                            {{/documenti}}
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- Compact Footer with Bottom Spacing -->
            <div class="card-footer bg-transparent border-top border-secondary border-opacity-25 py-4 px-4">
                <form action="{{base_url}}/soci/{{socio.cf}}/upload" method="POST" enctype="multipart/form-data">
                    <input type="hidden" name="csrf_name" value="{{csrf.name}}">
                    <input type="hidden" name="csrf_value" value="{{csrf.value}}">
                    
                    <div class="row g-3 align-items-end">
                        <div class="col-md-3">
                             <label class="small text-secondary fw-bold text-uppercase mb-2">Tipo Asset</label>
                             <select name="tipo_documento" id="tipoDocumento" class="form-select bg-dark text-white border-secondary shadow-sm" onchange="toggleExtraFields()">
                                <option value="GENERICO" selected>Seleziona Tipologia Asset...</option>
                                
                                <optgroup label="IDENTITÀ & ANAGRAFICA">
                                    <option value="CARTA_IDENTITA">Carta d'Identità (CIE/Cartacea)</option>
                                    <option value="PASSAPORTO">Passaporto Ordinario/Diplomatico</option>
                                    <option value="TESSERA_SANITARIA">Tessera Sanitaria / Codice Fiscale</option>
                                    <option value="PATENTE_GUIDA">Patente di Guida (Civile/Militare)</option>
                                    <option value="PERMESSO_SOGGIORNO">Permesso di Soggiorno</option>
                                    <option value="CERTIFICATO_RESIDENZA">Certificato di Residenza / Stato di Famiglia</option>
                                </optgroup>

                                <optgroup label="STATO DI SERVIZIO & CARRIERA">
                                    <option value="TESSERINO_MILITARE">Tesserino Militare (MD4 / AT)</option>
                                    <option value="FOGLIO_MATRICOLARE">Foglio Matricolare / Stato di Servizio</option>
                                    <option value="DECRETO_NOMINA">Decreto di Nomina / Avanzamento Grado</option>
                                    <option value="DIPLOMA_ONORIFICENZA">Diploma Onorificenza / Nastrino</option>
                                    <option value="ELOGIO_SCRITTO">Elogio Scritto / Encomio Solenne</option>
                                    <option value="SANZIONE_DISCIPLINARE">Provvedimento Disciplinare / Sanzione</option>
                                    <option value="CONGEDO_ILLIMITATO">Foglio di Congedo Illimitato</option>
                                </optgroup>
                                
                                <optgroup label="FORMAZIONE & ABILITAZIONI">
                                    <option value="TITOLO_STUDIO">Titolo di Studio (Diploma/Laurea)</option>
                                    <option value="ATTESTATO_CORSO">Attestato di Frequenza Corso</option>
                                    <option value="ABILITAZIONE_PROFESSIONALE">Abilitazione Professionale (Albo)</option>
                                    <option value="PORTO_ARMI">Porto d'Armi (Difesa/Sportivo)</option>
                                    <option value="BREVETTO_SPECIALITA">Brevetto Specialità (Parà/Sub/Volo)</option>
                                    <option value="PATENTE_NAUTICA">Patente Nautica</option>
                                </optgroup>

                                <optgroup label="SANITARIO & SICUREZZA">
                                    <option value="CERTIFICATO_IDONEITA">Certificato Idoneità Fisica / Sportiva</option>
                                    <option value="GRUPPO_SANGUIGNO">Certificato Gruppo Sanguigno</option>
                                    <option value="LIBRETTO_VACCINAZIONI">Libretto Vaccinazioni / Profilassi</option>
                                    <option value="VERBALE_CMO">Verbale Commissione Medica (CMO)</option>
                                    <option value="INVALIDITA_CIVILE">Verbale Invalidità Civile / L.104</option>
                                </optgroup>

                                <optgroup label="AMMINISTRAZIONE & FISCALE">
                                    <option value="MODULO_ISCRIZIONE">Modulo Iscrizione (Annuale)</option>
                                    <option value="RICEVUTA_QUOTA">Ricevuta Versamento Quota</option>
                                    <option value="INFORMATIVA_PRIVACY">Informativa Privacy (GDPR)</option>
                                    <option value="DELEGA_ATTI">Delega Ritiro Atti / Rappresentanza</option>
                                    <option value="IBAN_SDD">Mandato SDD / Coordinate Bancarie</option>
                                    <option value="DOCUMENTO_FISCALE">Documentazione Fiscale (CU / 730)</option>
                                </optgroup>

                                <optgroup label="LEGALE & GIURIDICO">
                                    <option value="CASELLARIO_GIUDIZIALE">Casellario Giudiziale / Carichi Pendenti</option>
                                    <option value="PROCURA_LEGALE">Procura Legale / Notarile</option>
                                    <option value="DICHIARAZIONE_SOSTITUTIVA">Autocertificazione / Dich. Sostitutiva</option>
                                </optgroup>
                                
                                <optgroup label="ALTRO">
                                    <option value="FOTO_PROFILO">Foto Profilo Ufficiale</option>
                                    <option value="CORRISPONDENZA">Corrispondenza / Lettera</option>
                                    <option value="GENERICO">Allegato Generico</option>
                                </optgroup>
                            </select>
                        </div>

                        <div class="col-md-6">
                             <label class="small text-secondary fw-bold text-uppercase mb-2">File Source</label>
                            <input type="file" name="documento" class="form-control bg-dark text-white border-secondary shadow-sm" required>
                        </div>

                        <div class="col-md-3">
                            <button type="submit" class="btn btn-primary shadow-primary px-4 fw-bold w-100">
                                <i class="fa-solid fa-cloud-arrow-up me-2"></i>UPLOAD
                            </button>
                        </div>
                    </div>

                    <!-- EXTRA FIELDS ROW -->
                    <div id="extraFields" class="row mt-3 d-none">
                        <div class="col-12">
                            <div class="p-3 rounded border border-secondary border-opacity-25 bg-black bg-opacity-25 d-flex gap-3 align-items-center">
                                <div class="text-info fw-bold me-2"><i class="fa-solid fa-circle-info me-2"></i>Dati Audit:</div>
                                <div class="input-group w-auto">
                                    <span class="input-group-text bg-secondary border-secondary text-white">Anno</span>
                                    <input type="number" name="anno" class="form-control bg-dark text-white border-secondary" value="2025" style="max-width: 100px;">
                                </div>
                                <div class="input-group w-auto">
                                    <span class="input-group-text bg-secondary border-secondary text-white">Quota €</span>
                                    <input type="number" name="quota" class="form-control bg-dark text-white border-secondary" value="50.00" step="0.01" style="max-width: 120px;">
                                </div>
                            </div>
                        </div>
                    </div>
                </form>

                <script>
                function toggleExtraFields() {
                    const type = document.getElementById('tipoDocumento').value;
                    const extras = document.getElementById('extraFields');
                    if (type === 'MODULO_ISCRIZIONE') {
                        extras.classList.remove('d-none');
                    } else {
                        extras.classList.add('d-none');
                    }
                }
                </script>
            </div>
        </div>
        </div>
        
        <!-- FORCE SCROLL SPACER (Extended Downwards) -->
        <div style="height: 250px; width: 100%; clear: both;"></div>
    </div>
</div>

<!-- Styles moved to style.css -->
{{> layout_footer }}

