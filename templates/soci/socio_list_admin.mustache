{{> layout_header }}

<!-- VIEW MODE TOGGLES (Only for Real Admins) -->
<!-- VIEW MODE TOGGLES (Restricted to System Admin) -->
{{#is_system_admin}}
<div class="d-flex justify-content-end mb-4 gap-2">
    <a href="{{base_url}}/devtools" class="btn btn-sm btn-outline-danger fw-bold rounded-pill px-3">
        <i class="fa-solid fa-user-secret me-2"></i>Mission Control
    </a>
    <a href="?view=user" class="btn btn-sm {{#is_admin}}btn-outline-secondary{{/is_admin}}{{^is_admin}}btn-primary{{/is_admin}} fw-bold rounded-pill px-3">
        <i class="fa-solid fa-user me-2"></i>Vista Utente
    </a>
</div>
{{/is_system_admin}}

<div class="container-fluid px-4">
    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="display-5 fw-bold text-white mb-0">
                {{#is_admin}}Gestione Anagrafica{{/is_admin}}
                {{^is_admin}}Directory Soci{{/is_admin}}
            </h1>
            <p class="text-secondary lead mb-0">
                {{#is_admin}}DB Master • {{count}} Records • Accesso Completo{{/is_admin}}
                {{^is_admin}}Elenco pubblico degli associati MCAG{{/is_admin}}
            </p>
        </div>
        
        <!-- SEARCH BAR (Common) -->
        <div class="d-flex gap-2">
            <!-- Grid/List Toggle -->
            <div class="btn-group bg-dark border border-secondary rounded-pill p-1">
                <button id="btn-admin-cards" class="btn btn-sm text-secondary rounded-pill px-3 transition-all" onclick="toggleAdminView('cards')">
                    <i class="fa-solid fa-border-all me-2"></i> Griglia
                </button>
                <button id="btn-admin-table" class="btn btn-sm btn-primary rounded-pill px-3 transition-all" onclick="toggleAdminView('table')">
                    <i class="fa-solid fa-list-ul me-2"></i> Lista
                </button>
            </div>

            <!-- UNIVERSAL SEARCH BAR -->
            <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-secondary"><i class="fa-solid fa-magnifying-glass"></i></span>
                <input type="text" id="global-search-bar" class="form-control bg-dark border-secondary text-white" 
                       placeholder="Cerca tutto (CF, Nome, Gruppo Sanguigno...)" 
                       style="min-width: 300px;">
            </div>

             {{#is_admin}}
             <a href="{{base_url}}/soci/nuovo" class="btn btn-success d-flex align-items-center gap-2 rounded-pill px-4">
                 <i class="fa-solid fa-plus"></i> <span class="d-none d-md-inline">Nuovo</span>
             </a>
             {{/is_admin}}
        </div>
    </div>

    <!-- ADMIN VIEW: DATA DENSE TABLE -->
    {{#is_admin}}
    <div id="admin-directory-table" class="card border-0 shadow-lg bg-dark text-white overflow-hidden transition-all">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 align-middle w-100" id="table-soci">
                <thead class="bg-black bg-opacity-25 text-secondary text-uppercase x-small">
                    <tr>
                        <th class="ps-4">Socio</th>
                        <th>Matricola</th>
                        <th>Codice Fiscale</th>
                        <th>Stato</th>
                        <th>Contatti</th>
                        <th class="text-end pe-4">Azioni</th>
                        <th class="d-none">SearchData</th> <!-- Hidden Column for Search Index -->
                    </tr>
                </thead>
                <tbody>
                    {{#soci}}
                    <tr>
                        <td class="ps-4" data-grid-label="Socio">
                            <div class="d-flex align-items-center justify-content-start grid-centered">
                                <div class="rounded-circle bg-secondary bg-opacity-25 d-flex align-items-center justify-content-center me-3 grid-avatar" style="width: 35px; height: 35px;">
                                    <i class="fa-solid fa-user text-white-50"></i>
                                </div>
                                <div class="text-start grid-text-center">
                                    <div class="fw-bold text-white">{{nome}} {{cognome}}</div>
                                    <small class="text-secondary">{{data_nascita}}</small>
                                </div>
                            </div>
                        </td>
                        <td class="font-monospace text-info text-start grid-text-center" data-grid-label="Matricola">{{matricola}}</td>
                        <td class="font-monospace text-white-50 text-start grid-text-center" data-grid-label="CF">{{cf}}</td>
                        <td class="text-start grid-text-center" data-grid-label="Stato">
                            {{#is_attivo}}
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">ATTIVO</span>
                            {{/is_attivo}}
                            {{^is_attivo}}
                                <span class="badge bg-secondary bg-opacity-25 text-secondary">INATTIVO</span>
                            {{/is_attivo}}
                            {{#is_moroso}}
                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 ms-1">MOROSO</span>
                            {{/is_moroso}}
                        </td>
                        <td class="text-start grid-text-center" data-grid-label="Contatti">
                             <a href="mailto:{{email}}" class="text-decoration-none text-secondary hover-white me-2"><i class="fa-solid fa-envelope"></i></a>
                             <span class="text-secondary">{{telefono}}</span>
                        </td>
                        <td class="text-end pe-4 grid-w-100" data-grid-label="Azioni">
                            <div class="dropdown d-inline-block">
                                <button class="btn btn-sm btn-outline-light dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                    <i class="fa-solid fa-bars me-1"></i> Gestione
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end bg-dark border-secondary shadow" style="z-index: 9999;">
                                    <li><h6 class="dropdown-header text-uppercase small opacity-50">Azioni Rapide</h6></li>
                                    <li><a class="dropdown-item text-white" href="{{base_url}}/soci/{{cf}}"><i class="fa-solid fa-eye me-2"></i>Dettagli</a></li>
                                    <li><a class="dropdown-item text-info" href="{{base_url}}/soci/{{cf}}/edit"><i class="fa-solid fa-pen me-2"></i>Modifica</a></li>
                                    <li><a class="dropdown-item text-white" href="{{base_url}}/soci/{{cf}}/impostazioni"><i class="fa-solid fa-sliders me-2"></i>Impostazioni</a></li>
                                    <li><hr class="dropdown-divider border-secondary"></li>
                                    <li>
                                        <form action="{{base_url}}/soci/{{cf}}/delete" method="POST" onsubmit="return confirm('ATTENZIONE: Stai per eliminare DEFINITIVAMENTE questo socio.\n\nQuesta azione è IRREVERSIBILE.\n\nSei sicuro di voler procedere?');">
                                            <button type="submit" class="dropdown-item text-danger"><i class="fa-solid fa-trash me-2"></i>Elimina Definitivamente</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </td>
                        <td class="d-none">{{search_blob}}</td> <!-- Hidden Data for Search -->
                    </tr>
                    {{/soci}}
                </tbody>
            </table>
        </div>
    </div>
    {{/is_admin}}

    <!-- CSS Toggle Logic -->
    <style>
        /* Force Overflow Sible when in Grid Mode to allow Dropdowns to popup */
        .force-overflow-visible {
            overflow: visible !important;
        }

        /* HIDE DEFAULT DATATABLES SEARCH (Redundant with Global Search) */
        .dataTables_filter {
            display: none !important;
        }

        /* Grid View Transforms */
        .table.view-grid, 
        .table.view-grid tbody, 
        .table.view-grid tr, 
        .table.view-grid td {
            display: block; 
            width: 100%;
        }

        .table.view-grid thead {
            display: none;
        }

        .table.view-grid tbody {
            display: grid !important;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 1.5rem;
            background: transparent !important;
            padding: 1.5rem;
            border: none;
        }

        .table.view-grid tr {
            display: flex;
            flex-direction: column;
            position: relative;
            width: 100%;
            height: 100%;
            background: #212529 !important;
            border: 1px solid #495057 !important;
            border-radius: 1rem;
            padding: 1.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.15);
            margin-bottom: 0;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            z-index: 1; /* Base Z-Index */
        }
        
        .table.view-grid td {
            border: none !important;
            padding: 0.25rem 0 !important;
            background: transparent !important;
            text-align: center;
        }

        /* Hover Effect for Cards - High Z-Index prevents overlapping issues */
        .table.view-grid tr:hover {
            transform: translateY(-5px);
            z-index: 100; /* Float above everything else */
            box-shadow: 0 1rem 3rem rgba(0,0,0,0.5);
            border-color: var(--bs-primary) !important;
        }
        
        /* Keep Z-Index high if dropdown is active inside (using modern :has, fallback is JS click) */
        .table.view-grid tr:has(.show) {
            z-index: 1000 !important;
            transform: translateY(-5px); /* Keep lifted */
            border-color: var(--bs-primary) !important;
        }

        /* Specialized Transforms */
        .table.view-grid .grid-centered {
            flex-direction: column;
            align-items: center !important;
            justify-content: center !important;
        }
        .table.view-grid .grid-avatar {
            width: 80px !important;
            height: 80px !important;
            margin-right: 0 !important;
            margin-bottom: 1rem;
            font-size: 2.5rem !important;
        }
        .table.view-grid .grid-text-center {
            text-align: center !important;
        }
        .table.view-grid .text-start {
            text-align: center !important;
        }
        
        /* Hide Labels in Grid */
        .table.view-grid td::before {
             display: none;
        }

        /* Action Column Formatting */
        .table.view-grid td[data-grid-label="Azioni"] {
            margin-top: auto; /* Push to bottom */
            padding-top: 1rem !important;
            border-top: 1px solid rgba(255,255,255,0.1) !important;
            width: 100%;
            display: flex;
            justify-content: center;
        }
        
        /* Dropdown fix for Grid */
        .table.view-grid .dropdown-menu {
             /* Use standard positioning but ensure z-index wins */
             margin-top: 0.5rem !important;
             box-shadow: 0 10px 30px rgba(0,0,0,0.5) !important;
        }
    </style>

    <script>
        function toggleAdminView(mode) {
            const table = document.getElementById('table-soci');
            const btnCards = document.getElementById('btn-admin-cards');
            const btnTable = document.getElementById('btn-admin-table');
            const containerCard = document.getElementById('admin-directory-table');
            const tableResponsive = containerCard.querySelector('.table-responsive');
            
            if (mode === 'cards') {
                $(table).addClass('view-grid');
                $(table).removeClass('table-hover');
                
                // Disable overflow hiding to allow dropdowns to pop out of cards
                $(containerCard).addClass('force-overflow-visible').removeClass('overflow-hidden');
                $(tableResponsive).addClass('force-overflow-visible');
                
                btnCards.classList.remove('text-secondary');
                btnCards.classList.add('btn-primary');
                
                btnTable.classList.remove('btn-primary');
                btnTable.classList.add('text-secondary');
            } else {
                $(table).removeClass('view-grid');
                $(table).addClass('table-hover');
                
                // Restore standard table overflow safety
                $(containerCard).removeClass('force-overflow-visible').addClass('overflow-hidden');
                $(tableResponsive).removeClass('force-overflow-visible');
                
                btnTable.classList.remove('text-secondary');
                btnTable.classList.add('btn-primary');
                
                btnCards.classList.remove('btn-primary');
                btnCards.classList.add('text-secondary');
            }
        }
    </script>

    <!-- USER VIEW: CARD GRID -->
    {{^is_admin}}
    <div id="user-directory-grid" class="row g-4">
        {{#soci}}
        <div class="col-md-6 col-lg-4 col-xl-3">
            <div class="card h-100 border-0 shadow bg-dark text-white hover-translate-y transition-all">
                <div class="card-body text-center p-4">
                     <div class="rounded-circle bg-primary bg-opacity-10 d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                        <span class="fw-bold fs-4 text-primary">{{nome.0}}{{cognome.0}}</span>
                    </div>
                    <h5 class="fw-bold mb-1">{{nome}} {{cognome}}</h5>
                    <p class="text-secondary small mb-3">Membro dal 2024</p> <!-- Placeholder, need join date in VM -->
                    
                    {{#is_attivo}}
                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">Socio Attivo</span>
                    {{/is_attivo}}
                    {{^is_attivo}}
                         <span class="badge bg-secondary bg-opacity-25 text-secondary rounded-pill px-3">Non Attivo</span>
                    {{/is_attivo}}

                    <div class="mt-4 pt-3 border-top border-secondary border-opacity-25">
                         <a href="{{base_url}}/soci/{{cf}}" class="btn btn-outline-light btn-sm w-100 rounded-pill">Visualizza Profilo</a>
                    </div>
                </div>
            </div>
        </div>
        {{/soci}}
    </div>
    
    <!-- Sentinel for Infinite Scroll (Observer Target) -->
    <div id="scroll-sentinel" class="text-center py-5 mt-4"></div>

    <style>
        .hover-translate-y:hover { transform: translateY(-5px); }
        .transition-all { transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1); }
        .duration-500 { transition-duration: 500ms; }
        .ease-out { transition-timing-function: cubic-bezier(0, 0, 0.2, 1); }
        
        .opacity-0 { opacity: 0; }
        .opacity-100 { opacity: 1; }
        
        .translate-y-4 { transform: translateY(1rem); }
        .translate-y-0 { transform: translateY(0); }
    </style>
    {{/is_admin}}

    <script src="{{base_url}}/js/pages/socio_list.js?v=20260115"></script>

    <!-- DataTables Initialization -->
    <script>
        $(document).ready(function() {
            const tableId = '#table-soci';
            const tableEl = $(tableId);

            if (tableEl.length) {
                // Prevent re-initialization
                if ($.fn.DataTable.isDataTable(tableId)) {
                    console.log("MCAG: DataTable already initialized. Skipping.");
                    return;
                }

                console.log("MCAG: Initializing DataTable...");
                tableEl.DataTable({
                    language: {
                        processing:     "Elaborazione...",
                        search:         "Cerca:",
                        lengthMenu:     "Mostra _MENU_ elementi",
                        info:           "Vista da _START_ a _END_ di _TOTAL_ elementi",
                        infoEmpty:      "Vista da 0 a 0 di 0 elementi",
                        infoFiltered:   "(filtrati da _MAX_ elementi totali)",
                        infoPostFix:    "",
                        loadingRecords: "Caricamento...",
                        zeroRecords:    "<div class='text-center py-5'><i class='fa-solid fa-magnifying-glass fa-2x mb-3 opacity-50'></i><br>Nessun risultato trovato.<br><small class='text-secondary'>Prova a cercare per Codice Fiscale, Nome, o Gruppo Sanguigno.</small></div>",
                        emptyTable:     "Nessun dato presente nella tabella.",
                        paginate: {
                            first:      "Inizio",
                            previous:   "Precedente",
                            next:       "Successivo",
                            last:       "Fine"
                        },
                        aria: {
                            sortAscending:  ": attiva per ordinare la colonna in ordine crescente",
                            sortDescending: ": attiva per ordinare la colonna in ordine decrescente"
                        }
                    },
                    paging: true,
                    info: true,
                    ordering: true,
                    searching: true, // Internal searching logic enabled
                    responsive: true,
                    destroy: true, // Allow re-initialization if needed
                    columnDefs: [
                        { orderable: false, targets: 5 }, // Actions
                        { visible: false, targets: 6 } // Hidden Search Column
                    ],
                    // Removed 'f' (filtering input) from DOM because we use #global-search-bar
                    dom: '<"d-flex justify-content-end align-items-center mb-3"<"d-flex align-items-center"l>>rt<"d-flex justify-content-between align-items-center mt-3"ip>',
                    initComplete: function() {
                        console.log("MCAG: DataTables Initialized Successfully");
                        
                        // Bind Global Search
                        const table = this.api();
                        $('#global-search-bar').on('keyup', function() {
                            table.search(this.value).draw();
                        });

                        $('.dataTables_length select').addClass('form-select bg-dark border-secondary text-white');
                    }
                });
            }
        });
    </script>
</div>

{{> layout_footer }}
