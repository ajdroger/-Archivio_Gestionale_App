    <!-- CSS Toggle Logic -->
    <style>
        /* Force Overflow Sible when in Grid Mode to allow Dropdowns to popup */
        .force-overflow-visible {
            overflow: visible !important;
        }

        /* HIDE DEFAULT DATATABLES SEARCH (Redundant with Global Search) */
        .dataTables_filter {
            display: none !important;
        }

        /* Grid View Transforms */
        .table.view-grid, 
        .table.view-grid tbody, 
        .table.view-grid tr, 
        .table.view-grid td {
            display: block; 
            width: 100%;
        }

        .table.view-grid thead {
            display: none;
        }

        .table.view-grid tbody {
            display: grid !important;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 1.5rem;
            background: transparent !important;
            padding: 1.5rem;
            border: none;
        }

        .table.view-grid tr {
            display: flex;
            flex-direction: column;
            position: relative;
            width: 100%;
            height: 100%;
            background: #212529 !important;
            border: 1px solid #495057 !important;
            border-radius: 1rem;
            padding: 1.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.15);
            margin-bottom: 0;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            z-index: 1; /* Base Z-Index */
        }
        
        .table.view-grid td {
            border: none !important;
            padding: 0.25rem 0 !important;
            background: transparent !important;
            text-align: center;
        }

        /* Hover Effect for Cards - High Z-Index prevents overlapping issues */
        .table.view-grid tr:hover {
            transform: translateY(-5px);
            z-index: 100; /* Float above everything else */
            box-shadow: 0 1rem 3rem rgba(0,0,0,0.5);
            border-color: var(--bs-primary) !important;
        }
        
        /* Keep Z-Index high if dropdown is active inside (using modern :has, fallback is JS click) */
        .table.view-grid tr:has(.show) {
            z-index: 1000 !important;
            transform: translateY(-5px); /* Keep lifted */
            border-color: var(--bs-primary) !important;
        }

        /* Specialized Transforms */
        .table.view-grid .grid-centered {
            flex-direction: column;
            align-items: center !important;
            justify-content: center !important;
        }
        .table.view-grid .grid-avatar {
            width: 80px !important;
            height: 80px !important;
            margin-right: 0 !important;
            margin-bottom: 1rem;
            font-size: 2.5rem !important;
        }
        .table.view-grid .grid-text-center {
            text-align: center !important;
        }
        .table.view-grid .text-start {
            text-align: center !important;
        }
        
        /* Hide Labels in Grid */
        .table.view-grid td::before {
             display: none;
        }

        /* Action Column Formatting */
        .table.view-grid td[data-grid-label="Azioni"] {
            margin-top: auto; /* Push to bottom */
            padding-top: 1rem !important;
            border-top: 1px solid rgba(255,255,255,0.1) !important;
            width: 100%;
            display: flex;
            justify-content: center;
        }
        
        /* Dropdown fix for Grid */
        .table.view-grid .dropdown-menu {
             /* Use standard positioning but ensure z-index wins */
             margin-top: 0.5rem !important;
             box-shadow: 0 10px 30px rgba(0,0,0,0.5) !important;
        }
    </style>

    <script>
        function toggleAdminView(mode) {
            const table = document.getElementById('table-soci');
            const btnCards = document.getElementById('btn-admin-cards');
            const btnTable = document.getElementById('btn-admin-table');
            const containerCard = document.getElementById('admin-directory-table');
            const tableResponsive = containerCard.querySelector('.table-responsive');
            
            if (mode === 'cards') {
                $(table).addClass('view-grid');
                $(table).removeClass('table-hover');
                
                // Disable overflow hiding to allow dropdowns to pop out of cards
                $(containerCard).addClass('force-overflow-visible').removeClass('overflow-hidden');
                $(tableResponsive).addClass('force-overflow-visible');
                
                btnCards.classList.remove('text-secondary');
                btnCards.classList.add('btn-primary');
                
                btnTable.classList.remove('btn-primary');
                btnTable.classList.add('text-secondary');
            } else {
                $(table).removeClass('view-grid');
                $(table).addClass('table-hover');
                
                // Restore standard table overflow safety
                $(containerCard).removeClass('force-overflow-visible').addClass('overflow-hidden');
                $(tableResponsive).removeClass('force-overflow-visible');
                
                btnTable.classList.remove('text-secondary');
                btnTable.classList.add('btn-primary');
                
                btnCards.classList.remove('btn-primary');
                btnCards.classList.add('text-secondary');
            }
        }
    </script>

