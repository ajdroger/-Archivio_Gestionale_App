<!DOCTYPE html>
<html lang="it" class="h-100">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}} - MCAG | Archivio Mission-Critical</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="{{base_url}}/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome -->
    <link href="{{base_url}}/css/all.min.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="{{base_url}}/css/premium.css">
    
    <!-- Custom CSS (Consolidated) -->
    <link rel="stylesheet" href="{{base_url}}/css/style.css?v=20260115_FIX_CSS">
    <link href="{{base_url}}/css/components/scroll_navigator.css?v=20260115_REV5" rel="stylesheet">
    <!-- Accessibility Utils -->
    <script src="{{base_url}}/js/components/accessibility.js?v=1.0.0"></script>
    
    <!-- DataTables Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.0/css/dataTables.bootstrap5.css">

    <script>
        window.BASE_URL = "{{base_url}}";
        {{#csrf}}
        window.CSRF = {
            name: "{{name}}",
            value: "{{value}}"
        };
        {{/csrf}}
    </script>
    
    <!-- jQuery (Required for DataTables) -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <!-- DataTables JS (Updated to v2.0.0 to match CSS family) -->
    <script src="https://cdn.datatables.net/2.0.0/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.0/js/dataTables.bootstrap5.min.js"></script>
</head>
<body class="d-flex flex-column h-100 {{body_class}}">
    <nav class="navbar navbar-expand-lg navbar-dark navbar-mc sticky-top mb-0">
        <div class="container-fluid px-4">
            <a class="navbar-brand" href="{{base_url}}/">
                <i class="fa-solid fa-shield-halved me-2 text-warning"></i>MCAG ARCHIVIO
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarMain">
                <!-- Centered Navigation Group -->
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0 align-items-center gap-4">
                    <li class="nav-item d-none d-lg-block">
                        <span class="mc-status-badge border border-success border-opacity-25 bg-success bg-opacity-10 text-success rounded-pill px-3 py-1 small fw-bold shadow-sm">
                            <i class="fa-solid fa-circle-check me-1"></i>Mission-Critical Health OK
                        </span>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{base_url}}/"><i class="fa-solid fa-gauge-high me-1"></i>Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{base_url}}/soci"><i class="fa-solid fa-users-gear me-1"></i>Gestione Soci</a>
                    </li>
                        <a class="nav-link" href="{{base_url}}/statistiche"><i class="fa-solid fa-chart-pie me-1"></i>Report Center</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{base_url}}/workshift/dashboard"><i class="fa-solid fa-calendar-days me-1"></i>Workshift</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{base_url}}/taskflow"><i class="fa-solid fa-list-check me-1"></i>Taskflow</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{base_url}}/expensebar"><i class="fa-solid fa-money-bill-wave me-1"></i>Expensebar</a>
                    </li>
                </ul>
                
                <div class="d-flex align-items-center gap-3">
                    
                    <!-- Talking Archive Launcher -->
                    <button id="ta-launcher" class="btn btn-sm btn-outline-info rounded-circle d-none" title="Attiva Lettura Vocale" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                        <i class="fa-solid fa-headphones"></i>
                    </button>



                    <div class="dropdown">
                        <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle p-2 bg-dark rounded-pill border border-secondary" id="userDropdown" data-bs-toggle="dropdown">
                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold me-2" style="width: 28px; height: 28px; font-size: 0.8rem;">{{user_initial}}</div>
                            <span class="small me-1">{{username}}</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-secondary bg-dark text-white">
                            {{#real_is_admin}}
                            <li><h6 class="dropdown-header text-uppercase x-small text-warning fw-bold"><i class="fa-solid fa-shuttle-space me-2"></i>Mission Control</h6></li>
                            
                            <!-- Main Dashboard -->
                             <li><a class="dropdown-item text-white" href="{{base_url}}/impostazioni"><i class="fa-solid fa-sliders me-2"></i>Settings Logic</a></li>
                            <li><a class="dropdown-item text-warning" href="{{base_url}}/devtools"><i class="fa-solid fa-microchip me-2"></i>DevTools Hub</a></li>
                            
                            <!-- Specific DevTools Modules -->
                            <li><a class="dropdown-item text-light small ps-4" href="{{base_url}}/devtools#terminal"><i class="fa-solid fa-terminal me-2 text-danger"></i>Terminal</a></li>
                            <li><a class="dropdown-item text-light small ps-4" href="{{base_url}}/devtools#db"><i class="fa-solid fa-database me-2 text-info"></i>Database</a></li>
                            <li><a class="dropdown-item text-light small ps-4" href="{{base_url}}/devtools#security"><i class="fa-solid fa-shield-cat me-2 text-success"></i>Security</a></li>
                            <li><a class="dropdown-item text-light small ps-4" href="{{base_url}}/devtools#editor"><i class="fa-solid fa-folder-tree me-2 text-warning"></i>File System</a></li>
                             <li><a class="dropdown-item text-light small ps-4" href="{{base_url}}/devtools#audit"><i class="fa-solid fa-file-waveform me-2 text-secondary"></i>Log Viewer</a></li>

                            <li><hr class="dropdown-divider border-secondary"></li>
                            
                            <li><a class="dropdown-item text-info" href="{{base_url}}/landing/index.html" target="_blank"><i class="fa-solid fa-rocket me-2"></i>Landing Page</a></li>
                            <li><a class="dropdown-item text-success" href="{{base_url}}/auth/start-demo"><i class="fa-solid fa-gamepad me-2"></i>Avvia Demo Mode</a></li>
                            <li><hr class="dropdown-divider border-secondary"></li>
                            {{/real_is_admin}}
                            
                            {{#can_manage_soci}}
                            <li><span class="dropdown-header text-uppercase x-small text-secondary fw-bold">Operatività</span></li>
                            <li><a class="dropdown-item text-info" href="{{base_url}}/soci/nuovo"><i class="fa-solid fa-user-plus me-2"></i>Nuovo Socio</a></li>
                            <li><a class="dropdown-item text-white" href="{{base_url}}/soci"><i class="fa-solid fa-address-book me-2"></i>Elenco Soci</a></li>
                            <li><a class="dropdown-item text-danger" href="{{base_url}}/soci?payment_status=moroso"><i class="fa-solid fa-triangle-exclamation me-2"></i>Quote Scadute</a></li>
                            <li><hr class="dropdown-divider border-secondary"></li>
                            {{/can_manage_soci}}

                            <li><a class="dropdown-item text-danger" href="{{base_url}}/logout"><i class="fa-solid fa-power-off me-2"></i>Esci dal sistema</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <!-- MODAL: WORLD LANGUAGES -->
    <div class="modal fade" id="modal-language-world" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-white border-secondary shadow-lg">
                <div class="modal-header border-secondary border-opacity-25">
                    <h5 class="modal-title"><i class="fa-solid fa-earth-americas me-2 text-info"></i>Select Language</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">Imposta la lingua globale del sistema. (Powered by Google Neural Translate)</p>
                    
                    <!-- Major Languages Grid -->
                    <div class="d-grid gap-2" style="grid-template-columns: repeat(3, 1fr);">
                        <button class="btn btn-outline-secondary d-flex align-items-center justify-content-center gap-2 py-2" onclick="AccessControl.resetLang()">
                            <img src="https://flagcdn.com/w20/it.png" width="20"> ITA
                        </button>
                        <button class="btn btn-outline-secondary d-flex align-items-center justify-content-center gap-2 py-2" onclick="AccessControl.setLang('en')">
                            <img src="https://flagcdn.com/w20/gb.png" width="20"> ENG
                        </button>
                        <button class="btn btn-outline-secondary d-flex align-items-center justify-content-center gap-2 py-2" onclick="AccessControl.setLang('es')">
                            <img src="https://flagcdn.com/w20/es.png" width="20"> ESP
                        </button>
                        <button class="btn btn-outline-secondary d-flex align-items-center justify-content-center gap-2 py-2" onclick="AccessControl.setLang('fr')">
                            <img src="https://flagcdn.com/w20/fr.png" width="20"> FRA
                        </button>
                        <button class="btn btn-outline-secondary d-flex align-items-center justify-content-center gap-2 py-2" onclick="AccessControl.setLang('de')">
                            <img src="https://flagcdn.com/w20/de.png" width="20"> DEU
                        </button>
                        <button class="btn btn-outline-secondary d-flex align-items-center justify-content-center gap-2 py-2" onclick="AccessControl.setLang('zh-CN')">
                            <img src="https://flagcdn.com/w20/cn.png" width="20"> CHN
                        </button>
                    </div>

                    <hr class="border-secondary opacity-25 my-3">

                    <!-- Full Selector -->
                    <label class="small text-secondary fw-bold mb-2">OTHER LANGUAGES</label>
                    <select class="form-select bg-black text-white border-secondary" onchange="if(this.value) AccessControl.setLang(this.value)">
                        <option value="" selected>Scegli dal mondo...</option>
                        <option value="ar">🇸🇦 Arabic</option>
                        <option value="ru">🇷🇺 Russian</option>
                        <option value="pt">🇵🇹 Portuguese</option>
                        <option value="ja">🇯🇵 Japanese</option>
                        <option value="ko">🇰🇷 Korean</option>
                        <option value="hi">🇮🇳 Hindi</option>
                        <option value="tr">🇹🇷 Turkish</option>
                        <option value="pl">🇵🇱 Polish</option>
                        <option value="nl">🇳🇱 Dutch</option>
                        <option value="sv">🇸🇪 Swedish</option>
                        <option value="ro">🇷🇴 Romanian</option>
                        <option value="uk">🇺🇦 Ukrainian</option>
                        <option value="el">🇬🇷 Greek</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <main class="flex-shrink-0 main-content">
        <div class="container-fluid px-4">
            <!-- Flash Messages -->
            {{#flash_message}}
            <div class="alert alert-{{type}} alert-dismissible fade show shadow border-0 mb-4 bg-dark text-white" role="alert" style="border-left: 5px solid var(--bs-{{type}}) !important;">
                <i class="fa-solid fa-circle-info me-2"></i>{{message}}
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
            </div>
            {{/flash_message}}


