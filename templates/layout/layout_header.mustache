<!DOCTYPE html>
<html lang="it" class="h-100">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fratellanza Militare | Archivio Mission-Critical</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/fratellanza-militare-archivio/public/css/premium.css">
    
    <style>
        :root {
            --mc-slate: #0f172a;
            --mc-slate-light: #1e293b;
            --mc-accent: #38bdf8;
            --mc-gold: #fbbf24;
        }
        body { 
            font-family: 'Inter', sans-serif; 
            background-color: var(--mc-slate); 
            color: #f1f5f9;
            padding: 0 !important; /* Override premium.css padding */
        }
        .navbar-mc {
            background: rgba(15, 23, 42, 0.8) !important;
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            padding: 0.8rem 0;
        }
        .navbar-brand { 
            font-weight: 800; 
            background: linear-gradient(90deg, #f1f5f9, #94a3b8);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            font-size: 1.4rem;
        }
        .nav-link { font-weight: 500; font-size: 0.95rem; color: #94a3b8 !important; transition: color 0.2s; }
        .nav-link:hover, .nav-link.active { color: var(--mc-accent) !important; }
        
        .mc-status-badge {
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            padding: 4px 10px;
            border-radius: 20px;
            background: rgba(74, 222, 128, 0.1);
            color: #4ade80;
            border: 1px solid rgba(74, 222, 128, 0.2);
            font-weight: 700;
        }
        
        .main-content {
            margin-top: 2rem;
            padding-bottom: 5rem;
        }
        
        /* Modern Cards Refinement */
        .card {
            background: var(--mc-slate-light);
            border: 1px solid rgba(255, 255, 255, 0.05);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        }
    </style>
</head>
<body class="d-flex flex-column h-100">
    <nav class="navbar navbar-expand-lg navbar-dark navbar-mc sticky-top mb-0">
        <div class="container">
            <a class="navbar-brand" href="/fratellanza-militare-archivio/public/">
                <i class="fa-solid fa-shield-halved me-2 text-warning"></i>FM ARCHIVIO
            </a>
            <div class="ms-2 d-none d-sm-inline">
                <span class="mc-status-badge">
                    <i class="fa-solid fa-circle-check me-1"></i>Mission-Critical Health OK
                </span>
            </div>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                    <li class="nav-item">
                        <a class="nav-link" href="/fratellanza-militare-archivio/public/"><i class="fa-solid fa-gauge-high me-1"></i>Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/fratellanza-militare-archivio/public/soci"><i class="fa-solid fa-users-gear me-1"></i>Gestione Soci</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/fratellanza-militare-archivio/public/statistiche"><i class="fa-solid fa-chart-pie me-1"></i>Report Center</a>
                    </li>
                </ul>
                
                <div class="d-flex align-items-center">
                    <div class="dropdown">
                        <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle p-2 bg-dark rounded-pill border border-secondary" id="userDropdown" data-bs-toggle="dropdown">
                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold me-2" style="width: 28px; height: 28px; font-size: 0.8rem;">{{user_initial}}</div>
                            <span class="small me-1">{{username}}</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-secondary bg-dark text-white">
                            {{#is_admin}}
                            <li><a class="dropdown-item text-white" href="/fratellanza-militare-archivio/public/impostazioni"><i class="fa-solid fa-sliders me-2"></i>Impostazioni</a></li>
                            <li><a class="dropdown-item text-warning" href="/fratellanza-militare-archivio/public/devtools"><i class="fa-solid fa-microchip me-2"></i>Mission Control</a></li>
                            <li><hr class="dropdown-divider border-secondary"></li>
                            {{/is_admin}}
                            <li><a class="dropdown-item text-danger" href="/fratellanza-militare-archivio/public/logout"><i class="fa-solid fa-power-off me-2"></i>Esci dal sistema</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </nav>
    <main class="flex-shrink-0 main-content">
        <div class="container">
            <!-- Flash Messages -->
            {{#flash_message}}
            <div class="alert alert-{{type}} alert-dismissible fade show shadow border-0 mb-4 bg-dark text-white" role="alert" style="border-left: 5px solid var(--bs-{{type}}) !important;">
                <i class="fa-solid fa-circle-info me-2"></i>{{message}}
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
            </div>
            {{/flash_message}}
