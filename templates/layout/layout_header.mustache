<!DOCTYPE html>
<html lang="it" class="h-100">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}} - MCAG | Archivio Mission-Critical</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="{{base_url}}/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome -->
    <link href="{{base_url}}/css/all.min.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="{{base_url}}/css/premium.css">
    
    <!-- Custom CSS (Consolidated) -->
    <link rel="stylesheet" href="{{base_url}}/css/style.css?v=20260115_FIX_CSS">
    <link href="{{base_url}}/css/components/scroll_navigator.css?v=20260115_REV5" rel="stylesheet">
    
    <!-- DataTables Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.0/css/dataTables.bootstrap5.css">

    <script>
        window.BASE_URL = "{{base_url}}";
    </script>
    
    <!-- jQuery (Required for DataTables) -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <!-- DataTables JS (Updated to v2.0.0 to match CSS family) -->
    <script src="https://cdn.datatables.net/2.0.0/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.0/js/dataTables.bootstrap5.min.js"></script>
</head>
<body class="d-flex flex-column h-100 {{body_class}}">
    <nav class="navbar navbar-expand-lg navbar-dark navbar-mc sticky-top mb-0">
        <div class="container-fluid px-4">
            <a class="navbar-brand" href="{{base_url}}/">
                <i class="fa-solid fa-shield-halved me-2 text-warning"></i>MCAG ARCHIVIO
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarMain">
                <!-- Centered Navigation Group -->
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0 align-items-center gap-4">
                    <li class="nav-item d-none d-lg-block">
                        <span class="mc-status-badge border border-success border-opacity-25 bg-success bg-opacity-10 text-success rounded-pill px-3 py-1 small fw-bold shadow-sm">
                            <i class="fa-solid fa-circle-check me-1"></i>Mission-Critical Health OK
                        </span>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{base_url}}/"><i class="fa-solid fa-gauge-high me-1"></i>Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{base_url}}/soci"><i class="fa-solid fa-users-gear me-1"></i>Gestione Soci</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{base_url}}/statistiche"><i class="fa-solid fa-chart-pie me-1"></i>Report Center</a>
                    </li>
                </ul>
                
                <div class="d-flex align-items-center gap-3">
                    <!-- Talking Archive Launcher -->
                    <button id="ta-launcher" class="btn btn-sm btn-outline-info rounded-circle d-none" title="Attiva Lettura Vocale" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                        <i class="fa-solid fa-headphones"></i>
                    </button>



                    <div class="dropdown">
                        <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle p-2 bg-dark rounded-pill border border-secondary" id="userDropdown" data-bs-toggle="dropdown">
                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold me-2" style="width: 28px; height: 28px; font-size: 0.8rem;">{{user_initial}}</div>
                            <span class="small me-1">{{username}}</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-secondary bg-dark text-white">
                            {{#real_is_admin}}
                            <li><a class="dropdown-item text-white" href="{{base_url}}/impostazioni"><i class="fa-solid fa-sliders me-2"></i>Impostazioni</a></li>
                            <li><a class="dropdown-item text-warning" href="{{base_url}}/devtools"><i class="fa-solid fa-microchip me-2"></i>DeVToolS</a></li>
                            <li><a class="dropdown-item text-warning" href="{{base_url}}/../bin/debug_tools/test_dashboard.php"><i class="fa-solid fa-toolbox me-2"></i>Toolkit Avanzato</a></li>
                            <li><hr class="dropdown-divider border-secondary"></li>
                            <li><a class="dropdown-item text-info" href="{{base_url}}/landing/index.html" target="_blank"><i class="fa-solid fa-rocket me-2"></i>Landing Page</a></li>
                            <li><a class="dropdown-item text-success" href="{{base_url}}/auth/start-demo"><i class="fa-solid fa-gamepad me-2"></i>Avvia Demo Mode</a></li>
                            <li><hr class="dropdown-divider border-secondary"></li>
                            {{/real_is_admin}}
                            <li><a class="dropdown-item text-danger" href="{{base_url}}/logout"><i class="fa-solid fa-power-off me-2"></i>Esci dal sistema</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </nav>
    <main class="flex-shrink-0 main-content">
        <div class="container-fluid px-4">
            <!-- Flash Messages -->
            {{#flash_message}}
            <div class="alert alert-{{type}} alert-dismissible fade show shadow border-0 mb-4 bg-dark text-white" role="alert" style="border-left: 5px solid var(--bs-{{type}}) !important;">
                <i class="fa-solid fa-circle-info me-2"></i>{{message}}
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
            </div>
            {{/flash_message}}


