<!DOCTYPE html>
<html lang="it" class="h-100">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}} - Fratellanza Militare | Archivio Mission-Critical</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- DataTables CSS -->
    <link href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" rel="stylesheet">
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <style>
        :root {
            --mc-slate: #0f172a;
            --mc-slate-light: #1e293b;
            --mc-accent: #38bdf8;
            --mc-gold: #fbbf24;
        }
        body { 
            font-family: 'Inter', sans-serif; 
            background-color: var(--mc-slate); 
            color: #f1f5f9;
            padding: 0 !important;
        }
        .navbar-mc {
            background: rgba(15, 23, 42, 0.8) !important;
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            padding: 0.8rem 0;
        }
        .navbar-brand { 
            font-weight: 800; 
            background: linear-gradient(90deg, #f1f5f9, #94a3b8);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            font-size: 1.4rem;
        }
        .nav-link { font-weight: 500; font-size: 0.95rem; color: #94a3b8 !important; transition: color 0.2s; }
        .nav-link:hover, .nav-link.active { color: var(--mc-accent) !important; }
        
        .main-content {
            margin-top: 2rem;
            padding-bottom: 5rem;
        }
    </style>
</head>
<body class="d-flex flex-column h-100">
    <nav class="navbar navbar-expand-lg navbar-dark navbar-mc sticky-top mb-0">
        <div class="container">
            <a class="navbar-brand" href="/fratellanza-militare-archivio/public/">
                <i class="fa-solid fa-shield-halved me-2 text-warning"></i>FM ARCHIVIO
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                    <li class="nav-item">
                        <a class="nav-link" href="/fratellanza-militare-archivio/public/"><i class="fa-solid fa-gauge-high me-1"></i>Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/fratellanza-militare-archivio/public/soci"><i class="fa-solid fa-users-gear me-1"></i>Gestione Soci</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/fratellanza-militare-archivio/public/statistiche"><i class="fa-solid fa-chart-pie me-1"></i>Report Center</a>
                    </li>
                </ul>
                
                <div class="ms-auto d-flex align-items-center">
                    <a class="btn btn-outline-danger btn-sm rounded-pill px-3" href="/fratellanza-militare-archivio/public/logout">
                        <i class="fa-solid fa-power-off me-1"></i>Esci
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <main class="flex-shrink-0 main-content">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-secondary border-opacity-25 pb-2">
                <h1 class="h2 text-white fw-bold">{{title}}</h1>
            </div>
            
            {{{content}}}
        </div>
    </main>

    <footer class="footer mt-auto py-3 bg-black bg-opacity-30 border-top border-secondary border-opacity-10">
        <div class="container text-center">
            <span class="text-secondary small">&copy; {{year}} Fratellanza Militare - Archivio Digitale Mission-Critical</span>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>
    
    <script>
        $(document).ready(function() {
            // Auto-initialize any table with class 'smart-table'
            $('.smart-table').DataTable({
                responsive: true,
                language: {
                   url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/it-IT.json'
                },
                pageLength: 25
            });
        });
    </script>
</body>
</html>
