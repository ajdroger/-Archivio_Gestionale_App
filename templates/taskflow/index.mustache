<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <!-- <link rel="icon" type="image/x-icon" href="/favicon.ico"> -->
    <link rel="stylesheet" href="{{base_url}}/css/tailwind-external.css">
    <script src="https://cdn.jsdelivr.net/npm/feather-icons/dist/feather.min.js"></script>
    <script src="https://unpkg.com/feather-icons"></script>
    
    <!-- Base Styles -->
    <link rel="stylesheet" href="{{base_url}}/assets/taskflow/style.css">
    
    <script>
        // Pass server variables to JS
        window.MCAG_BASE_URL = "{{base_url}}";
        window.MCAG_USER = "{{username}}";
        window.MCAG_API_URL = "{{base_url}}/taskflow/api";
        window.MCAG_CSRF_NAME = "{{csrf.keys.name}}";
        window.MCAG_CSRF_VALUE = "{{csrf.keys.value}}";
    </script>
    {{#csrf}}
    <meta name="csrf-name" content="{{name}}">
    <meta name="csrf-value" content="{{value}}">
    {{/csrf}}
</head>
<body class="animated-gradient min-h-screen flex flex-col">
    <div id="particles-js" class="fixed inset-0 z-0"></div>
    
    <!-- Global MCAG Navbar (Tailwind Port) -->
    <nav class="bg-gray-900/90 backdrop-blur-md border-b border-gray-700/50 text-white sticky top-0 z-50">
        <div class="container mx-auto px-4">
            <div class="flex items-center justify-between h-16">
                <!-- Brand -->
                <a href="{{base_url}}/" class="flex items-center gap-2 text-xl font-bold text-white hover:text-violet-400 transition-colors">
                    <i data-feather="shield" class="text-yellow-500 w-6 h-6"></i>
                    <span>{{title}}</span>
                </a>

                <!-- Desktop Menu -->
                <div class="hidden md:flex items-center space-x-1 lg:space-x-4">
                    <!-- Global Links -->
                    <a href="{{base_url}}/" class="flex items-center gap-2 px-3 py-2 rounded-lg text-gray-300 hover:text-white hover:bg-gray-800 transition-all text-sm font-medium">
                        <i data-feather="grid" class="w-4 h-4"></i> Dashboard
                    </a>
                    <a href="{{base_url}}/soci" class="flex items-center gap-2 px-3 py-2 rounded-lg text-gray-300 hover:text-white hover:bg-gray-800 transition-all text-sm font-medium">
                        <i data-feather="users" class="w-4 h-4"></i> Soci
                    </a>
                    <a href="{{base_url}}/statistiche" class="flex items-center gap-2 px-3 py-2 rounded-lg text-gray-300 hover:text-white hover:bg-gray-800 transition-all text-sm font-medium">
                        <i data-feather="pie-chart" class="w-4 h-4"></i> Report
                    </a>
                    <a href="{{base_url}}/impostazioni" class="flex items-center gap-2 px-3 py-2 rounded-lg text-gray-300 hover:text-white hover:bg-gray-800 transition-all text-sm font-medium">
                        <i data-feather="settings" class="w-4 h-4"></i> Impostazioni
                    </a>
                    <a href="{{base_url}}/devtools" class="flex items-center gap-2 px-3 py-2 rounded-lg text-gray-300 hover:text-white hover:bg-gray-800 transition-all text-sm font-medium">
                        <i data-feather="terminal" class="w-4 h-4"></i> DevTools
                    </a>
                    
                    <!-- Apps Dropdown -->
                    <div class="relative group z-50">
                        <button class="flex items-center gap-2 px-3 py-2 rounded-lg text-gray-300 hover:text-white hover:bg-gray-800 transition-all text-sm font-medium">
                            <i data-feather="layers" class="w-4 h-4"></i> Apps
                        </button>
                        <!-- Transparent Bridge (pt-2) ensures mouse stays in hover state -->
                        <div class="absolute right-0 top-full pt-2 w-56 hidden group-hover:block z-[100]">
                            <div class="bg-gray-900 rounded-xl shadow-2xl py-2 border border-gray-600 ring-1 ring-black ring-opacity-5 relative">
                                <!-- Little triangle/arrow (optional cosmetic) -->
                                <div class="absolute -top-1.5 right-4 w-3 h-3 bg-gray-600 rotate-45 border-l border-t border-gray-600"></div>
                                <div class="absolute -top-1.5 right-4 w-3 h-3 bg-gray-900 rotate-45 translate-y-[1px]"></div>
                                
                                <a href="{{base_url}}/workshift" class="block px-4 py-3 text-sm text-gray-200 hover:bg-gray-800 hover:text-white transition-colors border-b border-gray-800 first:rounded-t-xl"><i data-feather="calendar" class="inline w-4 h-4 mr-2 text-amber-400"></i> Workshift</a>
                                <a href="{{base_url}}/taskflow" class="block px-4 py-3 text-sm text-gray-200 hover:bg-gray-800 hover:text-white transition-colors border-b border-gray-800"><i data-feather="check-square" class="inline w-4 h-4 mr-2 text-cyan-400"></i> Taskflow</a>
                                <a href="{{base_url}}/expensebar" class="block px-4 py-3 text-sm text-gray-200 hover:bg-gray-800 hover:text-white transition-colors last:rounded-b-xl"><i data-feather="bar-chart-2" class="inline w-4 h-4 mr-2 text-emerald-400"></i> ExpenseBar</a>
                            </div>
                        </div>
                    </div>

                    <div class="h-6 w-px bg-gray-700 mx-2"></div>
                    
                    <!-- App Specific Links -->
                    <a href="{{base_url}}/taskflow" class="flex items-center gap-2 px-3 py-2 rounded-lg bg-violet-600 text-white shadow-lg shadow-violet-500/20 text-sm font-medium">
                        <i data-feather="check-square" class="w-4 h-4"></i> Attività
                    </a>
                    <a href="{{base_url}}/taskflow/about" class="flex items-center gap-2 px-3 py-2 rounded-lg text-gray-300 hover:text-white hover:bg-gray-800 transition-all text-sm font-medium">
                        <i data-feather="info" class="w-4 h-4"></i> Info
                    </a>
                </div>

                <!-- User/Identity Bar -->
                <div class="hidden md:flex items-center gap-4">
                    <user-status-bar role="{{user_role}}" user="{{username}}"></user-status-bar>
                    
                    <a href="{{base_url}}/logout" class="flex items-center gap-2 px-4 py-2 rounded-full border border-red-500/30 text-red-400 hover:bg-red-500 hover:text-white transition-all text-sm font-bold">
                        <i data-feather="power" class="w-4 h-4"></i>
                    </a>
                </div>

                <!-- Mobile Menu Button -->
                <button class="md:hidden p-2 rounded-lg text-gray-400 hover:bg-gray-800 focus:outline-none">
                    <i data-feather="menu" class="w-6 h-6"></i>
                </button>
            </div>
        </div>
    </nav>
    
    <div class="relative z-10 flex-grow">
        <!-- Removed taskflow-nav -->
        
        <main class="container mx-auto px-4 py-8 max-w-4xl" id="main-content">
            <header class="text-center mb-12 pt-8" id="home-section">
                <h1 class="text-5xl md:text-6xl font-bold text-white mb-4 leading-tight">
                    RicordamiDi
                    <span class="block text-2xl font-light text-violet-200 mt-2">Gestisci le tue attività con stile</span>
                </h1>
                <div class="w-24 h-1 bg-gradient-to-r from-violet-400 to-fuchsia-400 mx-auto rounded-full"></div>
            </header>

            <div id="tasks-section" class="bg-white/10 backdrop-blur-lg rounded-3xl shadow-2xl border border-white/10 overflow-hidden">
                <div class="p-6 md:p-8">
                    <!-- Stats Grid -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
                        <stats-card icon="target" color="violet" count="0" label="Totali"></stats-card>
                        <stats-card icon="check-circle" color="emerald" count="0" label="Completate"></stats-card>
                        <stats-card icon="clock" color="amber" count="0" label="Da Fare"></stats-card>
                    </div>

                    <!-- Input Form -->
                    <div class="mb-8">
                        <form id="task-form" class="flex flex-col sm:flex-row gap-4">
                            <div class="relative flex-grow">
                                <input 
                                    type="text" 
                                    id="task-input"
                                    placeholder="Aggiungi una nuova attività..." 
                                    class="w-full px-6 py-4 bg-white/5 border-2 border-violet-300/30 rounded-2xl text-white placeholder-violet-200/50 focus:outline-none focus:border-violet-400 focus:bg-white/10 transition-all duration-300 shadow-lg backdrop-blur-sm"
                                    required
                                >
                                <i data-feather="edit-3" class="absolute right-4 top-1/2 transform -translate-y-1/2 text-violet-300 w-5 h-5 pointer-events-none"></i>
                            </div>
                            <button 
                                type="submit"
                                class="px-8 py-4 bg-gradient-to-r from-violet-500 to-fuchsia-500 text-white font-semibold rounded-2xl hover:from-violet-600 hover:to-fuchsia-600 focus:outline-none focus:ring-4 focus:ring-violet-400/50 transition-all duration-300 transform hover:scale-105 shadow-xl flex items-center justify-center gap-2"
                            >
                                <i data-feather="plus-circle" class="w-5 h-5"></i>
                                <span>Aggiungi</span>
                            </button>
                        </form>
                    </div>

                    <!-- Filters -->
                    <div class="mb-6">
                        <div class="flex flex-wrap gap-3 justify-center">
                            <button id="filter-all" class="filter-btn active px-6 py-2 rounded-full bg-violet-500/30 text-violet-100 border border-violet-400/50 hover:bg-violet-500/50 transition-all duration-300 backdrop-blur-sm" data-filter="all">Tutte</button>
                            <button id="filter-active" class="filter-btn px-6 py-2 rounded-full bg-white/5 text-violet-100 border border-violet-300/30 hover:bg-violet-500/30 transition-all duration-300 backdrop-blur-sm" data-filter="active">Da Fare</button>
                            <button id="filter-completed" class="filter-btn px-6 py-2 rounded-full bg-white/5 text-violet-100 border border-violet-300/30 hover:bg-violet-500/30 transition-all duration-300 backdrop-blur-sm" data-filter="completed">Completate</button>
                        </div>
                    </div>

                    <!-- Add Sample Tasks Button -->
                    <div class="mb-6 text-center">
                        <button id="add-sample-tasks" class="px-6 py-3 bg-gradient-to-r from-emerald-500 to-teal-500 text-white font-medium rounded-2xl hover:from-emerald-600 hover:to-teal-600 focus:outline-none focus:ring-4 focus:ring-emerald-400/50 transition-all duration-300 w-full sm:w-auto flex items-center justify-center gap-2 shadow-lg mx-auto">
                            <i data-feather="zap" class="w-5 h-5"></i>
                            Aggiungi Attività di Esempio
                        </button>
                    </div>

                    <!-- Tasks List -->
                    <div id="tasks-container" class="space-y-4 min-h-[16rem]">
                        <div id="empty-state" class="text-center py-16">
                            <div class="w-24 h-24 mx-auto mb-6 bg-violet-500/20 rounded-full flex items-center justify-center backdrop-blur-sm">
                                <i data-feather="check-square" class="w-12 h-12 text-violet-300"></i>
                            </div>
                            <h3 class="text-2xl font-semibold text-violet-100 mb-2">Nessuna attività</h3>
                            <p class="text-violet-200/70">Aggiungi la tua prima attività per iniziare!</p>
                        </div>
                    </div>

                    <!-- Clear Completed -->
                    <div class="flex justify-center mt-8">
                        <button id="clear-completed" class="px-8 py-3 bg-gradient-to-r from-red-500 to-rose-500 text-white font-semibold rounded-2xl hover:from-red-600 hover:to-rose-600 focus:outline-none focus:ring-4 focus:ring-red-400/50 transition-all duration-300 transform hover:scale-105 shadow-xl flex items-center justify-center gap-2">
                            <i data-feather="trash-2" class="w-5 h-5"></i>
                            Elimina Completate
                        </button>
                    </div>
                </div>
            </div>
        </main>
    <div class="relative z-50">
        {{> taskflow/footer}}
    </div>

    <!-- Web Components -->
    <script src="{{base_url}}/assets/taskflow/components/navbar.js"></script>
    <script src="{{base_url}}/assets/taskflow/components/stats-card.js"></script>
    
    <!-- Particles.js -->
    <script src="https://cdn.jsdelivr.net/particles.js/2.0.0/particles.min.js"></script>
    
    <!-- Main Script -->
    <script src="{{base_url}}/js/components/user-status.js"></script>
    <script src="{{base_url}}/assets/taskflow/script.js"></script>
    
    <script>
        feather.replace();
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
        });
    </script>

    <!-- Custom Delete Confirmation Modal -->
    <!-- Custom Delete Confirmation Modal (v2: Robust Layout) -->
    <div id="delete-modal" class="fixed inset-0 z-[9999] hidden" style="z-index: 2147483647 !important;" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <!-- Backdrop -->
        <div class="fixed inset-0 bg-gray-900/95 transition-opacity opacity-0" id="delete-modal-backdrop"></div>

        <!-- Layout Container -->
        <div class="fixed inset-0 z-[10000] overflow-y-auto">
            <div class="flex min-h-screen items-center justify-center p-4 text-center">
                
                <!-- Modal Panel -->
                <!-- Use inline background to ensure visibility vs Tailwind purge issues -->
                <!-- Use inline margin auto for centering safety -->
                <div class="relative transform overflow-hidden rounded-2xl bg-[#1f2937] border border-gray-600 text-left shadow-[0_25px_50px_-12px_rgba(0,0,0,0.5)] transition-all w-full max-w-sm scale-95 opacity-0" 
                     id="delete-modal-panel"
                     style="background-color: #1f2937; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);">
                    
                    <div class="px-6 pt-6 pb-4">
                        <div class="sm:flex sm:items-start">
                            <div class="mx-auto flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-red-900/30 sm:mx-0 sm:h-10 sm:w-10">
                                <i data-feather="alert-triangle" class="h-6 w-6 text-red-500"></i>
                            </div>
                            <div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left">
                                <h3 class="text-lg font-semibold leading-6 text-white" id="modal-title">Elimina Attività</h3>
                                <div class="mt-2">
                                    <p class="text-sm text-gray-300">Sei sicuro di voler procedere?</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="bg-gray-800/50 px-6 py-4 sm:flex sm:flex-row-reverse gap-3 border-t border-gray-700">
                        <button type="button" id="confirm-delete-btn" class="inline-flex w-full justify-center rounded-xl bg-red-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-red-500 sm:w-auto transition-transform hover:scale-105 active:scale-95">
                            Elimina Definitivamente
                        </button>
                        <button type="button" onclick="taskManager.closeDeleteModal()" class="mt-3 inline-flex w-full justify-center rounded-xl bg-gray-700 px-4 py-2.5 text-sm font-semibold text-gray-300 shadow-sm ring-1 ring-inset ring-gray-600 hover:bg-gray-600 sm:mt-0 sm:w-auto transition-colors">
                            Annulla
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
