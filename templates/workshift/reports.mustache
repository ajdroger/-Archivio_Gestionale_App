<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Report - WorkShift Wizard</title>
    <link rel="stylesheet" href="{{base_url}}/css/tailwind-external.css">
    <link rel="stylesheet" href="{{base_url}}/assets/workshift/style.css">
    <link rel="stylesheet" href="{{base_url}}/assets/workshift/premium.css">
    <script src="https://unpkg.com/feather-icons"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="{{base_url}}/js/components/user-status.js"></script>
</head>
<body class="bg-mcag-slate text-mcag-text min-h-screen flex flex-col font-sans selection:bg-mcag-accent/30 transition-colors duration-500">
    
    <!-- Navbar -->
    <!-- Navbar -->
    {{> workshift/navbar}}

    <main class="flex-grow container mx-auto px-4 py-8 max-w-7xl animate-fade-in">

    <main class="flex-grow container mx-auto px-4 py-8 max-w-7xl animate-fade-in text-sm mb-20">

        <!-- Header with Date Picker Mock -->
        <div class="flex flex-col md:flex-row justify-between items-end mb-10 gap-6">
             <div>
                <h1 class="text-4xl font-black bg-gradient-to-r from-cyan-400 via-blue-500 to-indigo-500 bg-clip-text text-transparent mb-2">
                    Analisi & Report
                </h1>
                <p class="text-indigo-200/70 text-lg">
                    Data intelligence per decisioni migliori.
                </p>
            </div>
             <form action="{{base_url}}/workshift/reports" method="GET" class="flex flex-wrap gap-3">
                 <div class="relative group">
                     <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
                         <i data-feather="calendar" class="w-4 h-4 text-gray-400 group-hover:text-white transition-colors"></i>
                     </div>
                     <input type="month" name="month" value="{{current_month_value}}" 
                            class="pl-10 pr-4 py-2.5 bg-slate-800/80 border border-slate-700 text-white text-sm rounded-xl focus:ring-indigo-500 focus:border-indigo-500 block w-full shadow-sm hover:bg-slate-700/80 cursor-pointer transition-colors"
                            onchange="this.form.submit()">
                 </div>
                 
                 <a href="{{base_url}}/workshift/api/reports/export?month={{current_month_value}}" target="_blank"
                    class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-xl shadow-lg shadow-indigo-600/20 flex items-center gap-2 transition-all text-sm">
                     <i data-feather="download" class="w-4 h-4"></i> Export
                 </a>
             </form>
        </div>

        <!-- Bento Grid Reports -->
        <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6 auto-rows-auto">
            
            <!-- KPI 1: Spend -->
            <div class="col-span-1 md:col-span-1 bg-slate-800/40 backdrop-blur-md border border-slate-700/50 rounded-3xl p-6 flex flex-col justify-between group h-40 relative overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-br from-emerald-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                <div>
                     <h3 class="text-gray-400 text-[10px] font-bold uppercase tracking-widest mb-1">Costo Stimato</h3>
                     <p class="text-4xl font-black text-white">€ {{kpi.cost}}</p>
                </div>
                 <div class="flex items-center gap-2 text-emerald-400 font-bold text-xs bg-emerald-500/10 px-2 py-1 rounded-lg w-fit">
                    <i data-feather="arrow-up-right" class="w-3 h-3"></i> {{kpi.avg_cost_growth}}
                </div>
            </div>

            <!-- KPI 2: Hours -->
             <div class="col-span-1 md:col-span-1 bg-slate-800/40 backdrop-blur-md border border-slate-700/50 rounded-3xl p-6 flex flex-col justify-between group h-40">
                <div>
                     <h3 class="text-gray-400 text-[10px] font-bold uppercase tracking-widest mb-1">Ore Lavorate</h3>
                     <p class="text-4xl font-black text-white">{{kpi.hours}} <span class="text-sm font-medium text-gray-500">h</span></p>
                </div>
                 <div class="w-full bg-slate-700/50 h-1.5 rounded-full overflow-hidden">
                     <div class="bg-cyan-400 h-full w-[85%] rounded-full shadow-[0_0_10px_rgba(34,211,238,0.5)]"></div>
                 </div>
            </div>

            <!-- KPI 3: Requests Alert -->
             <div class="col-span-1 md:col-span-1 bg-slate-800/40 backdrop-blur-md border border-amber-500/20 rounded-3xl p-6 flex flex-col justify-between group h-40 relative overflow-hidden">
                 <div class="absolute -right-6 -top-6 w-24 h-24 bg-amber-500/20 rounded-full blur-xl animate-pulse"></div>
                <div>
                     <h3 class="text-amber-300/70 text-[10px] font-bold uppercase tracking-widest mb-1">Richieste in Attesa</h3>
                     <p class="text-4xl font-black text-white">{{kpi.overtime_alert}}</p>
                </div>
                 <div class="text-amber-400 text-xs font-medium flex items-center gap-1">
                    <i data-feather="clock" class="w-3 h-3"></i> Da approvare
                </div>
            </div>

            <!-- Main Chart: Overtime Trend (Wide) -->
            <div class="col-span-1 md:col-span-3 lg:col-span-3 lg:row-span-2 bg-slate-900/50 backdrop-blur-md border border-slate-700/50 rounded-3xl p-8 relative">
                <div class="flex justify-between items-center mb-6">
                    <h3 class="text-lg font-bold text-white flex items-center gap-2">
                        <i data-feather="activity" class="text-cyan-400"></i> Trend Ore Lavorate (30gg)
                    </h3>
                </div>
                <div class="h-[350px] w-full">
                     <canvas id="overtimeChart"></canvas>
                </div>
            </div>

            <!-- Side Card: Cost Breakdown (Tall) -->
            <div class="col-span-1 md:col-span-3 lg:col-span-1 lg:row-span-2 bg-slate-800/40 backdrop-blur-md border border-slate-700/50 rounded-3xl p-6 flex flex-col">
                 <h3 class="text-lg font-bold text-white mb-6 flex items-center gap-2">
                    <i data-feather="pie-chart" class="text-indigo-400"></i> Ripartizione Costi
                </h3>
                 <div class="flex-grow relative min-h-[250px]">
                    <canvas id="laborCostChart"></canvas>
                     <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                         <div class="text-center">
                             <span class="block text-2xl font-black text-white">24k</span>
                             <span class="block text-[10px] text-gray-500 uppercase tracking-widest">Totale</span>
                         </div>
                     </div>
                </div>
                <div class="mt-6 space-y-3">
                    <div class="flex justify-between text-xs text-gray-400 border-b border-white/5 pb-2">
                        <span>Vendite</span>
                        <span class="text-white font-bold">35%</span>
                    </div>
                     <div class="flex justify-between text-xs text-gray-400 border-b border-white/5 pb-2">
                        <span>Operativo</span>
                        <span class="text-white font-bold">25%</span>
                    </div>
                     <div class="flex justify-between text-xs text-gray-400 border-b border-white/5 pb-2">
                        <span>Marketing</span>
                        <span class="text-white font-bold">20%</span>
                    </div>
                </div>
            </div>

            <!-- Bottom Wide Info: AI Insight -->
            <div class="col-span-1 md:col-span-3 lg:col-span-4 bg-gradient-to-r from-indigo-900/40 to-purple-900/40 backdrop-blur-md border border-indigo-500/20 rounded-3xl p-6 flex items-start gap-4">
                <div class="p-3 bg-indigo-500 rounded-xl shadow-lg shadow-indigo-500/40 shrink-0">
                    <i data-feather="zap" class="text-white w-6 h-6"></i>
                </div>
                <div>
                    <h4 class="text-white font-bold text-lg mb-1">AI Insight: Ottimizzazione Disponibile</h4>
                    <!-- Dynamic AI Message -->
                    <p class="text-indigo-200/70 text-sm leading-relaxed max-w-3xl">
                        {{{ai_suggestion.message}}}
                    </p>
                    <div class="flex flex-col gap-2 mt-3">
                        <button id="btnApplyAiSuggestion" 
                                data-date="{{ai_suggestion.target_date}}" 
                                data-time="{{ai_suggestion.shift_time}}"
                                class="text-xs font-bold text-indigo-300 hover:text-white flex items-center gap-1 transition-colors">
                            APPLICA SUGGERIMENTO <i data-feather="arrow-right" class="w-3 h-3"></i>
                        </button>
                        
                        <button id="btnRefreshAiSuggestion" 
                                class="text-xs font-bold text-purple-300 hover:text-white flex items-center gap-1 transition-colors">
                            CAMBIA SUGGERIMENTO <i data-feather="refresh-cw" class="w-3 h-3"></i>
                        </button>
                    </div>
                </div>
            </div>

        </div>

    </main>

    {{> workshift/footer}}
    <script>
        const REPORT_DATA = {{{chart_data_json}}};
    </script>
    <script src="{{base_url}}/js/pages/workshift-reports.js"></script>
</body>
</html>
