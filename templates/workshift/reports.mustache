<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Report - WorkShift Wizard</title>
    <link rel="stylesheet" href="{{base_url}}/css/tailwind-external.css">
    <link rel="stylesheet" href="{{base_url}}/assets/workshift/style.css">
    <link rel="stylesheet" href="{{base_url}}/assets/workshift/premium.css">
    <script src="https://unpkg.com/feather-icons"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="{{base_url}}/js/components/user-status.js"></script>
</head>
<body class="bg-mcag-slate text-mcag-text min-h-screen flex flex-col font-sans selection:bg-mcag-accent/30 transition-colors duration-500">
    
    <!-- Navbar -->
    <nav class="bg-gray-900/95 backdrop-blur-md border-b border-gray-700/50 text-white sticky top-0 z-50">
        <div class="container mx-auto px-4">
            <div class="flex items-center justify-between h-16">
                <!-- Brand -->
                <a href="{{base_url}}/" class="flex items-center gap-2 text-xl font-bold text-white hover:text-indigo-400 transition-colors">
                    <i data-feather="shield" class="text-yellow-500 w-6 h-6"></i>
                    <span>{{title}}</span>
                </a>

                <!-- Desktop Menu -->
                <div class="hidden md:flex items-center space-x-1 lg:space-x-4">
                    <a href="{{base_url}}/" class="flex items-center gap-2 px-3 py-2 rounded-lg text-gray-300 hover:text-white hover:bg-gray-800 transition-all text-sm font-medium">
                        <i data-feather="grid" class="w-4 h-4"></i> Dashboard
                    </a>
                   
                    <div class="h-6 w-px bg-gray-700 mx-2"></div>
                    
                    <a href="{{base_url}}/workshift/dashboard" class="flex items-center gap-2 px-3 py-2 rounded-lg text-gray-300 hover:text-white hover:bg-gray-800 transition-all text-sm font-medium">
                        <i data-feather="home" class="w-4 h-4"></i> Home
                    </a>
                    <a href="{{base_url}}/workshift/shift-management" class="flex items-center gap-2 px-3 py-2 rounded-lg text-gray-300 hover:text-white hover:bg-gray-800 transition-all text-sm font-medium">
                        <i data-feather="calendar" class="w-4 h-4"></i> Turni
                    </a>
                    <a href="{{base_url}}/workshift/team-management" class="flex items-center gap-2 px-3 py-2 rounded-lg text-gray-300 hover:text-white hover:bg-gray-800 transition-all text-sm font-medium">
                        <i data-feather="users" class="w-4 h-4"></i> Team
                    </a>
                        <i data-feather="bar-chart-2" class="w-4 h-4"></i> Report
                    </a>
                    
                    <div class="h-6 w-px bg-gray-700 mx-2"></div>

                    <a href="{{base_url}}/taskflow" class="flex items-center gap-2 px-3 py-2 rounded-lg text-gray-300 hover:text-white hover:bg-gray-800 transition-all text-sm font-medium">
                        <i data-feather="list" class="w-4 h-4"></i> Taskflow
                    </a>
                    <a href="{{base_url}}/expensebar" class="flex items-center gap-2 px-3 py-2 rounded-lg text-gray-300 hover:text-white hover:bg-gray-800 transition-all text-sm font-medium">
                        <i data-feather="dollar-sign" class="w-4 h-4"></i> Expensebar
                    </a>
                </div>

                <!-- User/Identity Bar -->
                <div class="hidden md:flex items-center gap-4">
                     <user-status-bar role="{{user_role}}" user="{{username}}"></user-status-bar>
                </div>
            </div>
        </div>
    </nav>

    <main class="flex-grow container mx-auto px-4 py-8 max-w-7xl animate-fade-in">

    <main class="flex-grow container mx-auto px-4 py-8 max-w-7xl animate-fade-in text-sm mb-20">

        <!-- Header with Date Picker Mock -->
        <div class="flex flex-col md:flex-row justify-between items-end mb-10 gap-6">
             <div>
                <h1 class="text-4xl font-black bg-gradient-to-r from-cyan-400 via-blue-500 to-indigo-500 bg-clip-text text-transparent mb-2">
                    Analisi & Report
                </h1>
                <p class="text-indigo-200/70 text-lg">
                    Data intelligence per decisioni migliori.
                </p>
            </div>
             <div class="flex flex-wrap gap-3">
                 <div class="px-4 py-2.5 bg-slate-800/80 rounded-xl border border-slate-700 text-white font-medium flex items-center gap-3 cursor-pointer hover:bg-slate-700/80 transition-colors">
                     <i data-feather="calendar" class="w-4 h-4 text-gray-400"></i>
                     <span>Giugno 2026</span>
                     <i data-feather="chevron-down" class="w-4 h-4 text-gray-500"></i>
                 </div>
                 <button class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-xl shadow-lg shadow-indigo-600/20 flex items-center gap-2 transition-all">
                     <i data-feather="download" class="w-4 h-4"></i> Export
                 </button>
             </div>
        </div>

        <!-- Bento Grid Reports -->
        <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6 auto-rows-auto">
            
            <!-- KPI 1: Spend -->
            <div class="col-span-1 md:col-span-1 bg-slate-800/40 backdrop-blur-md border border-slate-700/50 rounded-3xl p-6 flex flex-col justify-between group h-40 relative overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-br from-emerald-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                <div>
                     <h3 class="text-gray-400 text-[10px] font-bold uppercase tracking-widest mb-1">Costo Totale</h3>
                     <p class="text-4xl font-black text-white">€ 24.5k</p>
                </div>
                 <div class="flex items-center gap-2 text-emerald-400 font-bold text-xs bg-emerald-500/10 px-2 py-1 rounded-lg w-fit">
                    <i data-feather="arrow-up-right" class="w-3 h-3"></i> +5.2%
                </div>
            </div>

            <!-- KPI 2: Hours -->
             <div class="col-span-1 md:col-span-1 bg-slate-800/40 backdrop-blur-md border border-slate-700/50 rounded-3xl p-6 flex flex-col justify-between group h-40">
                <div>
                     <h3 class="text-gray-400 text-[10px] font-bold uppercase tracking-widest mb-1">Ore Lavorate</h3>
                     <p class="text-4xl font-black text-white">1,240 <span class="text-sm font-medium text-gray-500">h</span></p>
                </div>
                 <div class="w-full bg-slate-700/50 h-1.5 rounded-full overflow-hidden">
                     <div class="bg-cyan-400 h-full w-[85%] rounded-full shadow-[0_0_10px_rgba(34,211,238,0.5)]"></div>
                 </div>
            </div>

            <!-- KPI 3: Overtime Problem -->
             <div class="col-span-1 md:col-span-1 bg-slate-800/40 backdrop-blur-md border border-red-500/20 rounded-3xl p-6 flex flex-col justify-between group h-40 relative overflow-hidden">
                 <div class="absolute -right-6 -top-6 w-24 h-24 bg-red-500/20 rounded-full blur-xl animate-pulse"></div>
                <div>
                     <h3 class="text-red-300/70 text-[10px] font-bold uppercase tracking-widest mb-1">Alert Straordinari</h3>
                     <p class="text-4xl font-black text-white">86 <span class="text-sm font-medium text-gray-500">h</span></p>
                </div>
                 <div class="text-red-400 text-xs font-medium flex items-center gap-1">
                    <i data-feather="alert-triangle" class="w-3 h-3"></i> +12% vs norma
                </div>
            </div>

            <!-- Main Chart: Overtime Trend (Wide) -->
            <div class="col-span-1 md:col-span-3 lg:col-span-3 lg:row-span-2 bg-slate-900/50 backdrop-blur-md border border-slate-700/50 rounded-3xl p-8 relative">
                <div class="flex justify-between items-center mb-6">
                    <h3 class="text-lg font-bold text-white flex items-center gap-2">
                        <i data-feather="activity" class="text-cyan-400"></i> Trend Produttività & Straordinari
                    </h3>
                    <div class="flex gap-2">
                        <span class="w-3 h-3 rounded-full bg-cyan-400"></span><span class="text-xs text-gray-400">Ore Regolari</span>
                         <span class="w-3 h-3 rounded-full bg-indigo-500 ml-2"></span><span class="text-xs text-gray-400">Straordinari</span>
                    </div>
                </div>
                <div class="h-[350px] w-full">
                     <canvas id="overtimeChart"></canvas>
                </div>
            </div>

            <!-- Side Card: Cost Breakdown (Tall) -->
            <div class="col-span-1 md:col-span-3 lg:col-span-1 lg:row-span-2 bg-slate-800/40 backdrop-blur-md border border-slate-700/50 rounded-3xl p-6 flex flex-col">
                 <h3 class="text-lg font-bold text-white mb-6 flex items-center gap-2">
                    <i data-feather="pie-chart" class="text-indigo-400"></i> Ripartizione Costi
                </h3>
                 <div class="flex-grow relative min-h-[250px]">
                    <canvas id="laborCostChart"></canvas>
                     <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                         <div class="text-center">
                             <span class="block text-2xl font-black text-white">24k</span>
                             <span class="block text-[10px] text-gray-500 uppercase tracking-widest">Totale</span>
                         </div>
                     </div>
                </div>
                <div class="mt-6 space-y-3">
                    <div class="flex justify-between text-xs text-gray-400 border-b border-white/5 pb-2">
                        <span>Vendite</span>
                        <span class="text-white font-bold">35%</span>
                    </div>
                     <div class="flex justify-between text-xs text-gray-400 border-b border-white/5 pb-2">
                        <span>Operativo</span>
                        <span class="text-white font-bold">25%</span>
                    </div>
                     <div class="flex justify-between text-xs text-gray-400 border-b border-white/5 pb-2">
                        <span>Marketing</span>
                        <span class="text-white font-bold">20%</span>
                    </div>
                </div>
            </div>

            <!-- Bottom Wide Info: AI Insight -->
            <div class="col-span-1 md:col-span-3 lg:col-span-4 bg-gradient-to-r from-indigo-900/40 to-purple-900/40 backdrop-blur-md border border-indigo-500/20 rounded-3xl p-6 flex items-start gap-4">
                <div class="p-3 bg-indigo-500 rounded-xl shadow-lg shadow-indigo-500/40 shrink-0">
                    <i data-feather="zap" class="text-white w-6 h-6"></i>
                </div>
                <div>
                    <h4 class="text-white font-bold text-lg mb-1">AI Insight: Ottimizzazione Disponibile</h4>
                    <p class="text-indigo-200/70 text-sm leading-relaxed max-w-3xl">
                        Sulla base dei dati storici, si prevede un picco di attività venerdì prossimo (+15% richieste). Si consiglia di programmare un turno "Jolly" aggiuntivo nella fascia Evening.
                    </p>
                    <button class="mt-3 text-xs font-bold text-indigo-300 hover:text-white flex items-center gap-1 transition-colors">
                        APPLICA SUGGERIMENTO <i data-feather="arrow-right" class="w-3 h-3"></i>
                    </button>
                </div>
            </div>

        </div>

    </main>

    {{> workshift/footer}}
    <script src="{{base_url}}/js/pages/workshift-reports.js"></script>
</body>
</html>
