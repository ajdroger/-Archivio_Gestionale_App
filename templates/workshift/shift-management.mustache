<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link rel="stylesheet" href="{{base_url}}/css/tailwind-external.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>tailwind.config={theme:{extend:{colors:{'mcag-slate':'#0f172a','mcag-blue':'#3b82f6',}}}}</script>
    <link rel="stylesheet" href="{{base_url}}/assets/workshift/style.css">
    <link rel="stylesheet" href="{{base_url}}/assets/workshift/premium.css">
    <link rel="stylesheet" href="{{base_url}}/css/components/scroll_navigator.css">
    <link href="{{base_url}}/css/all.min.css" rel="stylesheet">
    <script src="https://unpkg.com/feather-icons"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="{{base_url}}/js/components/user-status.js"></script>
    <style>
        .glass-panel {
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }
        .animate-float {
            animation: float 6s ease-in-out infinite;
        }
        @keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
            100% { transform: translateY(0px); }
        }
        /* Custom Scrollbar for Grid */
        .grid-col::-webkit-scrollbar {
            width: 4px;
        }
        .grid-col::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.05);
        }
        .grid-col::-webkit-scrollbar-thumb {
            background: rgba(99, 102, 241, 0.5);
            border-radius: 4px;
        }

        /* Shift Card Styles (Bypassing Tailwind Build) */
        .shift-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(8px);
            transition: all 0.2s ease;
        }
        .shift-card:hover { transform: scale(1.02); z-index: 10; cursor: pointer; }
        
        .shift-card-morning { background: linear-gradient(90deg, rgba(37,99,235,0.2) 0%, rgba(30,58,138,0.1) 100%); border-color: rgba(59,130,246,0.3); }
        .shift-card-day     { background: linear-gradient(90deg, rgba(219,39,119,0.2) 0%, rgba(131,24,67,0.1) 100%); border-color: rgba(236,72,153,0.3); }
        .shift-card-evening { background: linear-gradient(90deg, rgba(147,51,234,0.2) 0%, rgba(88,28,135,0.1) 100%); border-color: rgba(168,85,247,0.3); }
        .shift-card-night   { background: linear-gradient(90deg, rgba(217,119,6,0.2) 0%, rgba(120,53,15,0.1) 100%); border-color: rgba(245,158,11,0.3); }

        .dot-morning { background-color: #60a5fa; box-shadow: 0 0 8px rgba(96,165,250,0.6); }
        .dot-day     { background-color: #f472b6; box-shadow: 0 0 8px rgba(244,114,182,0.6); }
        .dot-evening { background-color: #c084fc; box-shadow: 0 0 8px rgba(192,132,252,0.6); }
        .dot-night   { background-color: #fbbf24; box-shadow: 0 0 8px rgba(251,191,36,0.6); }

        /* Grid Hover Effect */
        .grid-col { position: relative; transition: background-color 0.2s; }
        .grid-col:hover { background-color: rgba(255, 255, 255, 0.03); cursor: pointer; }
        .plus-icon-container {
            position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
            opacity: 0; pointer-events: none; transition: opacity 0.2s;
        }
        .grid-col:hover .plus-icon-container { opacity: 1; }
    </style>
</head>
<body class="bg-[#020617] text-slate-200 min-h-screen flex flex-col font-sans selection:bg-indigo-500/30 overflow-x-hidden">
    
    <!-- Ambient Background -->
    <div class="fixed inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,_rgba(79,70,229,0.15),_transparent_80%)]"></div>
    <div class="fixed top-0 left-0 w-full h-[1px] bg-gradient-to-r from-transparent via-indigo-500/50 to-transparent"></div>

    <!-- Navbar -->
    <!-- Navbar -->
    {{> workshift/navbar}}

    <main class="flex-grow container mx-auto px-6 py-8 max-w-[1800px] animate-fade-in relative z-10">
        
        <!-- Command Tower (Centered Stack) -->
        <div class="flex flex-col items-center justify-center gap-8 mb-10 relative z-10">
            
            <!-- 1. Headings -->
            <div class="text-center relative">
                <h1 class="text-5xl font-black text-white mb-2 tracking-tight">Gestione Turni</h1>
                <p class="text-slate-400 text-lg font-light">Pianifica le attività della settimana. <span class="text-indigo-400 font-bold">AI Active</span>.</p>
            </div>

            <!-- 2. Action Deck -->
            <div class="flex flex-wrap items-center justify-center gap-4">
                 <!-- AI Button -->
                <button id="aiOptimizeBtn" class="group relative px-6 py-3 bg-gradient-to-r from-violet-600/80 to-fuchsia-600/80 backdrop-blur-md border border-white/10 text-white font-bold rounded-2xl shadow-lg shadow-violet-500/20 hover:shadow-violet-500/40 transition-all duration-300 overflow-hidden flex items-center gap-3">
                    <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-20"></div>
                     <i data-feather="cpu" class="w-5 h-5 animate-pulse relative z-10"></i>
                    <span class="relative z-10">AI Auto-Schedule</span>
                </button>

                <!-- New Shift Button -->
                <button id="openCreateShiftModal" class="group relative px-6 py-3 bg-gradient-to-r from-violet-600/80 to-fuchsia-600/80 backdrop-blur-md border border-white/10 text-white font-bold rounded-2xl shadow-lg shadow-violet-500/20 hover:shadow-violet-500/40 transition-all duration-300 overflow-hidden flex items-center gap-3">
                    <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-20"></div>
                    <i data-feather="plus" class="w-5 h-5 relative z-10"></i>
                    <span class="relative z-10">Nuovo Turno</span>
                </button>

                <!-- Reset Week Button -->
                <button id="resetWeekBtn" class="group relative px-4 py-3 bg-red-500/10 hover:bg-red-500/20 backdrop-blur-md border border-red-500/30 text-red-400 hover:text-red-300 font-bold rounded-2xl transition-all duration-300 flex items-center gap-2" title="Svuota Settimana">
                    <i data-feather="trash-2" class="w-5 h-5"></i>
                </button>
            </div>

            <!-- View Switcher -->
            <!-- View Switcher -->
            <div class="bg-slate-900/50 p-1 rounded-2xl flex items-center border border-white/10 backdrop-blur-md mb-2">
                <button class="view-switch-btn px-6 py-2 rounded-xl text-sm font-bold text-slate-400 hover:text-white hover:bg-white/5 transition-all" data-view="day">Giorno</button>
                <button class="view-switch-btn px-6 py-2 rounded-xl text-sm font-bold text-white bg-indigo-500 shadow-lg shadow-indigo-500/20" data-view="week">Settimana</button>
                <button class="view-switch-btn px-6 py-2 rounded-xl text-sm font-bold text-slate-400 hover:text-white hover:bg-white/5 transition-all" data-view="month">Mese</button>
                <button class="view-switch-btn px-6 py-2 rounded-xl text-sm font-bold text-slate-400 hover:text-white hover:bg-white/5 transition-all" data-view="year">Anno</button>
                <button class="view-switch-btn px-6 py-2 rounded-xl text-sm font-bold text-slate-400 hover:text-white hover:bg-white/5 transition-all" data-view="list">Lista</button>
            </div>

            <!-- 3. Week Navigator Capsule -->
            <div class="glass-panel p-2 rounded-full flex items-center gap-4 shadow-2xl backdrop-blur-xl border border-white/10 bg-slate-900/40">
                 <button id="prevWeekBtn" class="w-10 h-10 flex items-center justify-center rounded-full hover:bg-white/10 text-slate-400 hover:text-white transition-all">
                    <i data-feather="chevron-left" class="w-5 h-5"></i>
                </button>
                <div class="text-center px-6 border-x border-white/5">
                    <span id="calendarTitle" class="text-[10px] font-bold text-indigo-400 uppercase tracking-widest block mb-0.5">SETTIMANA CORRENTE</span>
                    <span id="currentWeekLabel" class="text-lg font-bold text-white">12 Giu - 18 Giu 2026</span>
                </div>
                <button id="nextWeekBtn" class="w-10 h-10 flex items-center justify-center rounded-full hover:bg-white/10 text-slate-400 hover:text-white transition-all">
                    <i data-feather="chevron-right" class="w-5 h-5"></i>
                </button>
            </div>

        </div>

        <!-- Ultimate Grid -->
        <div class="glass-panel rounded-[3rem] overflow-hidden border border-white/5 shadow-2xl relative">
             <!-- Top Glow -->
            <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-indigo-500/50 to-transparent"></div>

            <!-- Headers -->
            <!-- Headers -->
            <div class="grid grid-cols-7 border-b border-white/5 bg-slate-900/50">
                <div class="p-6 text-center border-r border-white/5 relative group" data-day="Monday">
                    <div class="flex items-center justify-center gap-2 mb-2">
                        <span class="text-slate-400 text-xs font-bold uppercase tracking-wider">Lunedì</span>
                        <button onclick="clearDay('Monday')" class="text-slate-600 hover:text-red-400 transition-colors" title="Svuota Giorno"><i data-feather="trash-2" class="w-3 h-3"></i></button>
                    </div>
                    <span class="text-2xl font-black text-white header-date">12</span>
                </div>
                <div class="p-6 text-center border-r border-white/5 relative group" data-day="Tuesday">
                    <div class="flex items-center justify-center gap-2 mb-2">
                        <span class="text-slate-400 text-xs font-bold uppercase tracking-wider">Martedì</span>
                        <button onclick="clearDay('Tuesday')" class="text-slate-600 hover:text-red-400 transition-colors" title="Svuota Giorno"><i data-feather="trash-2" class="w-3 h-3"></i></button>
                    </div>
                    <span class="text-2xl font-black text-white header-date">13</span>
                </div>
                <div class="p-6 text-center border-r border-white/5 relative group" data-day="Wednesday">
                    <div class="flex items-center justify-center gap-2 mb-2">
                        <span class="text-slate-400 text-xs font-bold uppercase tracking-wider">Mercoledì</span>
                        <button onclick="clearDay('Wednesday')" class="text-slate-600 hover:text-red-400 transition-colors" title="Svuota Giorno"><i data-feather="trash-2" class="w-3 h-3"></i></button>
                    </div>
                    <span class="text-2xl font-black text-white header-date">14</span>
                </div>
                <div class="p-6 text-center border-r border-white/5 relative group" data-day="Thursday">
                    <div class="flex items-center justify-center gap-2 mb-2">
                        <span class="text-slate-400 text-xs font-bold uppercase tracking-wider">Giovedì</span>
                        <button onclick="clearDay('Thursday')" class="text-slate-600 hover:text-red-400 transition-colors" title="Svuota Giorno"><i data-feather="trash-2" class="w-3 h-3"></i></button>
                    </div>
                    <span class="text-2xl font-black text-white header-date">15</span>
                </div>
                <div class="p-6 text-center border-r border-white/5 relative group" data-day="Friday">
                    <div class="flex items-center justify-center gap-2 mb-2">
                        <span class="text-slate-400 text-xs font-bold uppercase tracking-wider">Venerdì</span>
                        <button onclick="clearDay('Friday')" class="text-slate-600 hover:text-red-400 transition-colors" title="Svuota Giorno"><i data-feather="trash-2" class="w-3 h-3"></i></button>
                    </div>
                    <span class="text-2xl font-black text-white header-date">16</span>
                </div>
                <div class="p-6 text-center border-r border-white/5 bg-indigo-500/5 relative overflow-hidden group" data-day="Saturday">
                    <div class="absolute top-0 right-0 w-3 h-3 bg-indigo-500/50 rounded-bl-lg"></div>
                    <div class="flex items-center justify-center gap-2 mb-2">
                        <span class="text-indigo-300 text-xs font-bold uppercase tracking-wider">Sabato</span>
                        <button onclick="clearDay('Saturday')" class="text-slate-600 hover:text-red-400 transition-colors relative z-10" title="Svuota Giorno"><i data-feather="trash-2" class="w-3 h-3"></i></button>
                    </div>
                    <span class="text-2xl font-black text-indigo-400 header-date">17</span>
                </div>
                <div class="p-6 text-center bg-indigo-500/5 relative overflow-hidden group" data-day="Sunday">
                    <div class="absolute top-0 right-0 w-3 h-3 bg-indigo-500/50 rounded-bl-lg"></div>
                    <div class="flex items-center justify-center gap-2 mb-2">
                        <span class="text-indigo-300 text-xs font-bold uppercase tracking-wider">Domenica</span>
                        <button onclick="clearDay('Sunday')" class="text-slate-600 hover:text-red-400 transition-colors relative z-10" title="Svuota Giorno"><i data-feather="trash-2" class="w-3 h-3"></i></button>
                    </div>
                    <span class="text-2xl font-black text-indigo-400 header-date">18</span>
                </div>
            </div>

            <!-- Grid Content -->
            <div id="scheduleGrid" class="grid grid-cols-7 divide-x divide-white/5 min-h-[700px] bg-slate-900/20 backdrop-blur-sm">
                <!-- Columns for JS Injection -->
                <div class="grid-col p-3 space-y-3 group/col hover:bg-white/5 transition-colors relative cursor-pointer" data-day="Monday">
                    <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover/col:opacity-10 pointer-events-none transition-opacity">
                        <i data-feather="plus-circle" class="w-12 h-12 text-white"></i>
                    </div>
                </div>
                <div class="grid-col p-3 space-y-3 group/col hover:bg-white/5 transition-colors relative cursor-pointer" data-day="Tuesday">
                    <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover/col:opacity-10 pointer-events-none transition-opacity">
                        <i data-feather="plus-circle" class="w-12 h-12 text-white"></i>
                    </div>
                </div>
                <div class="grid-col p-3 space-y-3 group/col hover:bg-white/5 transition-colors relative cursor-pointer" data-day="Wednesday">
                    <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover/col:opacity-10 pointer-events-none transition-opacity">
                        <i data-feather="plus-circle" class="w-12 h-12 text-white"></i>
                    </div>
                </div>
                <div class="grid-col p-3 space-y-3 group/col hover:bg-white/5 transition-colors relative cursor-pointer" data-day="Thursday">
                    <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover/col:opacity-10 pointer-events-none transition-opacity">
                        <i data-feather="plus-circle" class="w-12 h-12 text-white"></i>
                    </div>
                </div>
                <div class="grid-col p-3 space-y-3 group/col hover:bg-white/5 transition-colors relative cursor-pointer" data-day="Friday">
                    <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover/col:opacity-10 pointer-events-none transition-opacity">
                        <i data-feather="plus-circle" class="w-12 h-12 text-white"></i>
                    </div>
                </div>
                <div class="grid-col p-3 space-y-3 group/col hover:bg-indigo-500/10 transition-colors bg-indigo-500/5 relative cursor-pointer" data-day="Saturday">
                    <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover/col:opacity-10 pointer-events-none transition-opacity">
                        <i data-feather="plus-circle" class="w-12 h-12 text-indigo-300"></i>
                    </div>
                </div>
                <div class="grid-col p-3 space-y-3 group/col hover:bg-indigo-500/10 transition-colors bg-indigo-500/5 relative cursor-pointer" data-day="Sunday">
                    <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover/col:opacity-10 pointer-events-none transition-opacity">
                        <i data-feather="plus-circle" class="w-12 h-12 text-indigo-300"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Legend (Simplified) -->
        <div class="flex justify-center gap-8 mt-6 opacity-70 hover:opacity-100 transition-opacity">
            <div class="flex items-center gap-2 text-xs font-medium text-slate-400"><div class="w-2 h-2 rounded-full bg-blue-500"></div> Morning</div>
            <div class="flex items-center gap-2 text-xs font-medium text-slate-400"><div class="w-2 h-2 rounded-full bg-pink-500"></div> Day</div>
            <div class="flex items-center gap-2 text-xs font-medium text-slate-400"><div class="w-2 h-2 rounded-full bg-purple-500"></div> Evening</div>
            <div class="flex items-center gap-2 text-xs font-medium text-slate-400"><div class="w-2 h-2 rounded-full bg-amber-500"></div> Night</div>
        </div>

    </main>

    <!-- Create Shift Modal (Ultimate Glass) -->
    <div id="createShiftModal" class="fixed inset-0 hidden" style="z-index: 9999 !important; overflow: visible !important;" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <!-- Backdrop with direct click handler -->
        <div class="fixed inset-0 bg-black transition-opacity opacity-0" id="modalBackdrop" style="--tw-bg-opacity: 0.95;" onclick="toggleCreateShiftModal()"></div>

        <div class="flex min-h-screen items-center justify-center p-4 text-center" onclick="if(event.target === this) toggleCreateShiftModal()">
            <!-- Compact Width Forced via Style -->
            <div class="relative rounded-[2rem] bg-[#0f172a] border border-white/10 text-left shadow-2xl w-full opacity-100" id="modalPanel" style="background-color: #0f172a; color: white; overflow: visible !important; max-width: 450px !important;" onclick="event.stopPropagation()">
                <style>
                    option { background-color: #0f172a; color: white; }
                    /* Integrated Scrollbar (High Visibility) */
                    .custom-scrollbar::-webkit-scrollbar { width: 10px; }
                    .custom-scrollbar::-webkit-scrollbar-track { background: #020617; border-left: 1px solid rgba(255,255,255,0.05); }
                    .custom-scrollbar::-webkit-scrollbar-thumb { background: #6366f1; border-radius: 5px; border: 2px solid #020617; }
                    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #818cf8; }
                </style>
                
                <div class="p-6 border-b border-white/5 bg-white/5">
                    <div class="flex items-center gap-4">
                        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-500 text-white shadow-lg shadow-indigo-500/30">
                            <i data-feather="clock" class="h-5 w-5"></i>
                        </div>
                        <div>
                            <h3 class="text-lg font-bold text-white">Nuovo Turno</h3>
                            <p class="text-xs text-slate-400">Assegna un turno alla pianificazione.</p>
                        </div>
                    </div>
                </div>

                <form id="shiftForm" class="p-6 space-y-5 pb-40">
                    <input type="hidden" id="shiftId">
                    
                    <div class="relative z-50 mb-6" id="customSelectContainer">
                        <label class="block text-xs font-bold text-indigo-400 uppercase tracking-wider mb-2">Dipendente</label>
                        
                        <!-- Hidden Native Select (For Logic) -->
                        <select id="shiftEmployee" class="hidden">
                            {{#employees}}
                            <option value="{{id}}">{{name}}</option>
                            {{/employees}}
                        </select>

                        <!-- Custom UI Trigger -->
                        <div id="customSelectTrigger" class="w-full rounded-xl bg-slate-950 border border-slate-700 px-4 py-3 text-white flex justify-between items-center cursor-pointer hover:bg-slate-900 transition-colors" onclick="toggleCustomSelect()">
                            <span id="customSelectLabel">Seleziona Dipendente...</span>
                            <i data-feather="chevron-down" class="w-4 h-4 text-slate-500"></i>
                        </div>

                        <!-- Custom UI Options (Higher Z-Index + Integrated Scroll) -->
                        <div id="customSelectOptions" class="hidden absolute top-full left-0 right-0 mt-2 bg-slate-900 border border-slate-700 rounded-xl shadow-2xl overflow-y-auto max-h-56 z-[200] custom-scrollbar pr-1" style="background-color: #0f172a !important; opacity: 1 !important;">
                            {{#employees}}
                            <div class="px-4 py-2.5 hover:bg-indigo-500/20 cursor-pointer flex items-center transition-colors border-b border-white/5 last:border-0 group" onclick="selectCustomOption('{{id}}', '{{name}}')">
                                <!-- Initials Avatar -->
                                <div class="w-6 h-6 rounded-full bg-slate-700 flex items-center justify-center text-[10px] font-bold text-white mr-3 border border-slate-600 group-hover:border-indigo-400 transition-colors">
                                    {{user_initial}}
                                </div>
                                <span class="text-sm font-medium text-slate-200 group-hover:text-white">{{name}}</span>
                            </div>
                            {{/employees}}
                            {{^employees}}
                            <div class="px-4 py-3 text-slate-500 italic text-sm text-center">Nessun dipendente disponibile</div>
                            {{/employees}}
                        </div>
                    </div>
                    
                    <div class="grid grid-cols-2 gap-6">
                        <div>
                            <label class="block text-xs font-bold text-indigo-400 uppercase tracking-wider mb-2">Tipo Turno</label>
                            <select id="shiftType" class="w-full rounded-xl bg-slate-950 border border-slate-700 px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all hover:bg-slate-900" onchange="updateTimeInputs()">
                                <option value="Morning">Morning (08-16)</option>
                                <option value="Day">Day (09-17)</option>
                                <option value="Evening">Evening (16-00)</option>
                                <option value="Night">Night (00-08)</option>
                                <option value="Custom">Custom</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-indigo-400 uppercase tracking-wider mb-2">Giorno</label>
                            <select id="shiftDay" class="w-full rounded-xl bg-slate-950 border border-slate-700 px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all hover:bg-slate-900">
                                <option value="Monday">Lunedì</option>
                                <option value="Tuesday">Martedì</option>
                                <option value="Wednesday">Mercoledì</option>
                                <option value="Thursday">Giovedì</option>
                                <option value="Friday">Venerdì</option>
                                <option value="Saturday">Sabato</option>
                                <option value="Sunday">Domenica</option>
                            </select>
                        </div>
                    </div>

                    <!-- Custom Time Range -->
                    <div class="grid grid-cols-2 gap-6 bg-white/5 p-4 rounded-xl border border-white/5">
                        <div>
                            <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Inizio</label>
                            <input type="time" id="shiftStart" class="w-full rounded-lg bg-slate-900 border border-slate-700 px-3 py-2 text-white focus:ring-2 focus:ring-indigo-500" value="08:00">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Fine</label>
                            <input type="time" id="shiftEnd" class="w-full rounded-lg bg-slate-900 border border-slate-700 px-3 py-2 text-white focus:ring-2 focus:ring-indigo-500" value="16:00">
                        </div>
                    </div>

                        <div>
                        <label class="block text-xs font-bold text-indigo-400 uppercase tracking-wider mb-2">Note</label>
                        <input type="text" id="shiftNotes" class="w-full rounded-xl bg-slate-950 border border-slate-700 px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 placeholder-slate-600 transition-all hover:bg-slate-900" placeholder="Es: Sostituzione...">
                    </div>
                </form>

                <div class="bg-slate-900/50 px-4 py-3 flex flex-row-reverse gap-2 border-t border-white/5">
                    <button type="button" id="confirmCreateShift" class="inline-flex w-full justify-center rounded-lg bg-indigo-600 px-3 py-2 text-sm font-bold text-white shadow-sm hover:bg-indigo-500 sm:w-auto transition-all">
                        Salva Turno
                    </button>
                    <button type="button" id="cancelCreateShift" class="inline-flex w-full justify-center rounded-lg bg-white/5 px-3 py-2 text-sm font-bold text-slate-300 shadow-sm hover:bg-white/10 sm:w-auto transition-all">
                        Annulla
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- AI Options Modal -->
    <div id="aiOptionsModal" class="fixed inset-0 hidden" style="z-index: 10000;">
        <div class="fixed inset-0 bg-black transition-opacity opacity-0" id="aiModalBackdrop" style="--tw-bg-opacity: 0.95;"></div>
        <div class="fixed inset-0 z-10 overflow-y-auto">
            <div class="flex min-h-screen items-center justify-center p-4 text-center">
                <div class="relative transform overflow-hidden rounded-[2rem] bg-[#0f172a] border border-white/10 text-left shadow-2xl transition-all sm:w-full sm:max-w-sm opacity-0 scale-95" id="aiModalPanel">
                    
                    <div class="p-8 border-b border-white/5 bg-gradient-to-r from-violet-500/10 to-transparent">
                        <div class="flex items-center gap-4">
                            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-gradient-to-br from-violet-500 to-fuchsia-600 text-white shadow-lg shadow-violet-500/30">
                                <i data-feather="cpu" class="h-6 w-6 animate-pulse"></i>
                            </div>
                            <div>
                                <h3 class="text-xl font-bold text-white">AI Auto-Schedule Pro</h3>
                                <p class="text-sm text-slate-400">Seleziona il periodo da generare.</p>
                            </div>
                            <button id="closeAiModal" class="ml-auto text-slate-400 hover:text-white transition-colors">
                                <i data-feather="x" class="w-6 h-6"></i>
                            </button>
                        </div>
                    </div>

                    <div class="p-8 space-y-4">
                        <button class="ai-option-btn w-full group relative flex items-center gap-4 p-4 rounded-xl border border-white/5 bg-white/5 hover:bg-white/10 hover:border-violet-500/50 transition-all text-left" data-mode="current_week">
                            <div class="w-10 h-10 rounded-lg bg-blue-500/20 text-blue-400 flex items-center justify-center group-hover:scale-110 transition-transform">
                                <i data-feather="calendar" class="w-5 h-5"></i>
                            </div>
                            <div>
                                <h4 class="font-bold text-white group-hover:text-blue-300 transition-colors">Settimana Corrente</h4>
                                <p class="text-xs text-slate-400">Genera i turni per questa settimana.</p>
                            </div>
                            <div class="ml-auto opacity-0 group-hover:opacity-100 transition-opacity text-blue-400">
                                <i data-feather="arrow-right" class="w-5 h-5"></i>
                            </div>
                        </button>

                        <button class="ai-option-btn w-full group relative flex items-center gap-4 p-4 rounded-xl border border-white/5 bg-white/5 hover:bg-white/10 hover:border-purple-500/50 transition-all text-left" data-mode="next_week">
                            <div class="w-10 h-10 rounded-lg bg-purple-500/20 text-purple-400 flex items-center justify-center group-hover:scale-110 transition-transform">
                                <i data-feather="fast-forward" class="w-5 h-5"></i>
                            </div>
                            <div>
                                <h4 class="font-bold text-white group-hover:text-purple-300 transition-colors">Prossima Settimana</h4>
                                <p class="text-xs text-slate-400">Pianifica in anticipo la prossima settimana.</p>
                            </div>
                             <div class="ml-auto opacity-0 group-hover:opacity-100 transition-opacity text-purple-400">
                                <i data-feather="arrow-right" class="w-5 h-5"></i>
                            </div>
                        </button>

                        <button class="ai-option-btn w-full group relative flex items-center gap-4 p-4 rounded-xl border border-white/5 bg-white/5 hover:bg-white/10 hover:border-pink-500/50 transition-all text-left" data-mode="month">
                            <div class="w-10 h-10 rounded-lg bg-pink-500/20 text-pink-400 flex items-center justify-center group-hover:scale-110 transition-transform">
                                <i data-feather="grid" class="w-5 h-5"></i>
                            </div>
                            <div>
                                <h4 class="font-bold text-white group-hover:text-pink-300 transition-colors">Tutto il Mese</h4>
                                <p class="text-xs text-slate-400">Genera turni per l'intero mese corrente.</p>
                            </div>
                             <div class="ml-auto opacity-0 group-hover:opacity-100 transition-opacity text-pink-400">
                                <i data-feather="arrow-right" class="w-5 h-5"></i>
                            </div>
                        </button>

                         <button class="ai-option-btn w-full group relative flex items-center gap-4 p-4 rounded-xl border border-white/5 bg-white/5 hover:bg-white/10 hover:border-amber-500/50 transition-all text-left" data-mode="year">
                            <div class="w-10 h-10 rounded-lg bg-amber-500/20 text-amber-400 flex items-center justify-center group-hover:scale-110 transition-transform">
                                <i data-feather="database" class="w-5 h-5"></i>
                            </div>
                            <div>
                                <h4 class="font-bold text-white group-hover:text-amber-300 transition-colors">Tutto l'Anno</h4>
                                <p class="text-xs text-slate-400">Massiva generazione per 12 mesi (Lento).</p>
                            </div>
                             <div class="ml-auto opacity-0 group-hover:opacity-100 transition-opacity text-amber-400">
                                <i data-feather="arrow-right" class="w-5 h-5"></i>
                            </div>
                        </button>
                    </div>

                    <div id="aiLoading" class="hidden absolute inset-0 bg-[#0f172a]/95 backdrop-blur flex flex-col items-center justify-center z-50">
                        <div class="w-16 h-16 border-4 border-violet-500/30 border-t-violet-500 rounded-full animate-spin mb-4"></div>
                        <h4 class="text-xl font-bold text-white animate-pulse">L'IA sta pensando...</h4>
                        <p class="text-slate-400 text-sm mt-2">Analisi disponibilità e ottimizzazione.</p>
                    </div>

                </div>
            </div>
        </div>
    </div>

    {{> workshift/footer}}

    <script src="{{base_url}}/js/workshift-api.js"></script>
    <script>
        feather.replace();
    </script>
    <script src="{{base_url}}/js/components/scroll_navigator.js"></script>

    <!-- Quick Move Modal -->
    <div id="quickMoveModal" class="fixed inset-0 hidden overflow-y-auto" style="z-index: 9999 !important;" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <!-- Backdrop -->
        <div class="fixed inset-0 bg-black transition-opacity opacity-0" id="quickMoveBackdrop" style="--tw-bg-opacity: 0.95;" onclick="closeQuickMoveModal()"></div>

        <div class="flex min-h-screen items-center justify-center p-4" onclick="if(event.target === this) closeQuickMoveModal()">
            <div id="quickMovePanel" class="relative transform overflow-hidden rounded-[2rem] bg-[#0f172a] border border-white/10 text-left shadow-2xl transition-all w-full max-w-2xl opacity-0 scale-95" onclick="event.stopPropagation()">
                
                <div class="bg-indigo-600 px-4 py-3 border-b border-white/10">
                    <h3 class="text-base font-bold leading-6 text-white" id="modal-title">Sposta Turno</h3>
                </div>

                <!-- Context Summary -->
                <div class="px-6 py-4 bg-white/5 border-b border-white/5">
                    <div class="flex items-center gap-4">
                        <div class="h-10 w-10 rounded-full bg-slate-700 flex items-center justify-center text-white font-bold" id="quickMoveAvatar">
                            <!-- Initials -->
                        </div>
                        <div>
                            <h4 class="text-sm font-bold text-white" id="quickMoveEmployeeName">Nome Dipendente</h4>
                            <p class="text-xs text-indigo-400" id="quickMoveShiftDetails">Turno: Morning (08:00 - 16:00)</p>
                        </div>
                    </div>
                </div>

                <div class="px-6 py-6 space-y-4">
                    <input type="hidden" id="quickMoveShiftId">
                    
                    <div>
                        <label class="block text-xs font-bold text-indigo-400 uppercase tracking-wider mb-2">Seleziona Giorno</label>
                        <select id="quickMoveDay" class="w-full bg-slate-800 border-0 text-white text-sm rounded-lg focus:ring-2 focus:ring-indigo-500 py-2.5">
                            <option value="Monday">Lunedì</option>
                            <option value="Tuesday">Martedì</option>
                            <option value="Wednesday">Mercoledì</option>
                            <option value="Thursday">Giovedì</option>
                            <option value="Friday">Venerdì</option>
                            <option value="Saturday">Sabato</option>
                            <option value="Sunday">Domenica</option>
                        </select>
                    </div>
                    
                    <div>
                        <label class="block text-xs font-bold text-indigo-400 uppercase tracking-wider mb-2">O Data Specifica</label>
                        <input type="date" id="quickMoveDate" class="w-full bg-slate-800 border-0 text-white text-sm rounded-lg focus:ring-2 focus:ring-indigo-500 py-2.5">
                    </div>
                </div>

                <div class="bg-slate-900/50 px-4 py-3 flex flex-row-reverse gap-2 border-t border-white/5">
                    <button type="button" id="confirmQuickMove" class="inline-flex w-full justify-center rounded-lg bg-indigo-600 px-3 py-2 text-sm font-bold text-white shadow-sm hover:bg-indigo-500 sm:w-auto transition-all">Sposta</button>
                    <button type="button" onclick="closeQuickMoveModal()" class="inline-flex w-full justify-center rounded-lg bg-white/5 px-3 py-2 text-sm font-bold text-slate-300 shadow-sm hover:bg-white/10 sm:w-auto transition-all">Annulla</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Shift Modal (New Custom Alert) -->
    <div id="deleteShiftModal" class="fixed inset-0 hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true" style="z-index: 9999;">
        <div id="deleteShiftBackdrop" class="fixed inset-0 bg-black transition-opacity opacity-0" style="--tw-bg-opacity: 0.95;"></div>

        <div class="fixed inset-0 z-10 overflow-y-auto">
            <div class="flex min-h-full items-center justify-center p-4" style="display: flex; align-items: center; justify-content: center; min-height: 100vh;">
                <div id="deleteShiftPanel" class="relative transform overflow-hidden rounded-[2rem] bg-[#0f172a] border border-white/10 text-left shadow-2xl transition-all w-full max-w-xs opacity-0 scale-95">
                    
                    <div class="bg-red-600/10 px-6 py-6 border-b border-white/5 flex items-center justify-center">
                        <div class="h-12 w-12 rounded-full bg-red-600/20 flex items-center justify-center text-red-500">
                            <i data-feather="trash-2" class="w-6 h-6"></i>
                        </div>
                    </div>

                    <div class="px-6 py-4 text-center">
                        <h3 class="text-lg font-bold text-white mb-2">Rimuovi Turno?</h3>
                        <p class="text-sm text-slate-400">Questa azione non può essere annullata.</p>
                        <input type="hidden" id="deleteShiftId">
                    </div>

                    <div class="bg-slate-900/50 px-6 py-4 flex gap-3 border-t border-white/5">
                        <button type="button" id="confirmDeleteShift" class="flex-1 rounded-xl bg-red-600 px-4 py-3 text-sm font-bold text-white shadow-lg hover:bg-red-500 transition-all">Sì, Rimuovi</button>
                        <button type="button" onclick="closeDeleteShiftModal()" class="flex-1 rounded-xl bg-slate-800 px-4 py-3 text-sm font-bold text-slate-300 hover:bg-slate-700 transition-all">Annulla</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Reset Week Modal (Custom Alert) -->
    <div id="resetWeekModal" class="fixed inset-0 hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true" style="z-index: 10000;">
        <div id="resetWeekBackdrop" class="fixed inset-0 bg-black transition-opacity opacity-0" style="--tw-bg-opacity: 0.95;"></div>

        <div class="fixed inset-0 z-10 overflow-y-auto">
            <div class="flex min-h-full items-center justify-center p-4" style="display: flex; align-items: center; justify-content: center; min-height: 100vh;">
                <div id="resetWeekPanel" class="relative transform overflow-hidden rounded-[2rem] bg-[#0f172a] border border-white/10 text-left shadow-2xl transition-all w-full max-w-sm opacity-0 scale-95">
                    
                    <div class="bg-amber-500/10 px-6 py-6 border-b border-white/5 flex items-center justify-center">
                        <div class="h-16 w-16 rounded-full bg-amber-500/20 flex items-center justify-center text-amber-500 shadow-[0_0_15px_rgba(245,158,11,0.3)]">
                            <i data-feather="alert-triangle" class="w-8 h-8"></i>
                        </div>
                    </div>

                    <div class="px-6 py-6 text-center">
                        <h3 class="text-xl font-bold text-white mb-2">Reset Settimana?</h3>
                        <p class="text-sm text-slate-400 leading-relaxed">
                            Stai per cancellare <strong class="text-amber-400">TUTTI i turni</strong> della settimana visualizzata.
                            <br><span class="text-xs text-slate-500 mt-2 block">Questa operazione è irreversibile.</span>
                        </p>
                    </div>

                    <div class="bg-slate-900/50 px-6 py-4 flex gap-3 border-t border-white/5">
                        <button type="button" id="confirmResetWeek" class="flex-1 rounded-xl bg-amber-600 px-4 py-3 text-sm font-bold text-white shadow-lg hover:bg-amber-500 transition-all hover:scale-[1.02]">Sì, Resetta</button>
                        <button type="button" onclick="closeResetWeekModal()" class="flex-1 rounded-xl bg-slate-800 px-4 py-3 text-sm font-bold text-slate-300 hover:bg-slate-700 transition-all">Annulla</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Reset Day Modal (New) -->
    <div id="resetDayModal" class="fixed inset-0 hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true" style="z-index: 10000;">
        <div id="resetDayBackdrop" class="fixed inset-0 bg-black transition-opacity opacity-0" style="--tw-bg-opacity: 0.95;"></div>

        <div class="fixed inset-0 z-10 overflow-y-auto">
            <div class="flex min-h-full items-center justify-center p-4" style="display: flex; align-items: center; justify-content: center; min-height: 100vh;">
                <div id="resetDayPanel" class="relative transform overflow-hidden rounded-[2rem] bg-[#0f172a] border border-white/10 text-left shadow-2xl transition-all w-full max-w-sm opacity-0 scale-95">
                    
                    <div class="bg-amber-500/10 px-6 py-6 border-b border-white/5 flex items-center justify-center">
                        <div class="h-16 w-16 rounded-full bg-amber-500/20 flex items-center justify-center text-amber-500 shadow-[0_0_15px_rgba(245,158,11,0.3)]">
                            <i data-feather="trash-2" class="w-8 h-8"></i>
                        </div>
                    </div>

                    <div class="px-6 py-6 text-center">
                        <h3 class="text-xl font-bold text-white mb-2">Svuota Giorno?</h3>
                        <p class="text-sm text-slate-400 leading-relaxed">
                            Stai per eliminare tutti i turni di <strong id="resetDayTargetName" class="text-amber-400">Lunedi</strong>.
                            <br><span class="text-xs text-slate-500 mt-2 block">Questa operazione è irreversibile.</span>
                        </p>
                        <input type="hidden" id="resetDayTargetKey">
                    </div>

                    <div class="bg-slate-900/50 px-6 py-4 flex gap-3 border-t border-white/5">
                        <button type="button" id="confirmResetDay" class="flex-1 rounded-xl bg-amber-600 px-4 py-3 text-sm font-bold text-white shadow-lg hover:bg-amber-500 transition-all hover:scale-[1.02]">Sì, Svuota</button>
                        <button type="button" onclick="closeResetDayModal()" class="flex-1 rounded-xl bg-slate-800 px-4 py-3 text-sm font-bold text-slate-300 hover:bg-slate-700 transition-all">Annulla</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast Container -->
    <div id="toastContainer" class="fixed bottom-6 right-6 z-[10000] flex flex-col gap-3 pointer-events-none"></div>

    <!-- Scripts -->
    <script src="{{base_url}}/js/pages/workshift-shift-management.js?v=7.9.5"></script>
