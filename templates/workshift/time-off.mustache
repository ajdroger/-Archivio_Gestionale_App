<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Permessi - WorkShift Wizard</title>
    <link rel="stylesheet" href="{{base_url}}/css/tailwind-external.css">
    <link rel="stylesheet" href="{{base_url}}/assets/workshift/style.css">
    <link rel="stylesheet" href="{{base_url}}/assets/workshift/premium.css">
    <link rel="stylesheet" href="{{base_url}}/css/components/scroll_navigator.css">
    <link href="{{base_url}}/css/all.min.css" rel="stylesheet">
    <script src="https://unpkg.com/feather-icons"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="{{base_url}}/js/components/user-status.js"></script>
</head>
<body class="bg-mcag-slate text-mcag-text min-h-screen flex flex-col font-sans selection:bg-mcag-accent/30 transition-colors duration-500">
    
    <!-- Navbar -->
    <!-- Navbar -->
    {{> workshift/navbar}}

    <main class="flex-grow container mx-auto px-4 py-8 max-w-7xl animate-fade-in">

    <main class="flex-grow container mx-auto px-4 py-8 max-w-5xl animate-fade-in text-sm">

        <!-- Ultimate Header & Balance -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
            <!-- Title Section -->
            <div class="md:col-span-2 glass-panel p-8 rounded-[2rem] flex flex-col justify-center relative overflow-hidden">
                <div class="absolute top-0 right-0 w-32 h-32 bg-amber-500/20 rounded-full blur-3xl -mr-10 -mt-10"></div>
                <h1 class="text-3xl font-black text-white mb-2">Ferie & Permessi</h1>
                <p class="text-indigo-200/80 mb-6">Visualizza e gestisci le richieste del tuo team.</p>
                
                <button onclick="document.getElementById('requestModal').classList.remove('hidden')" class="w-auto px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-xl shadow-lg shadow-indigo-500/20 transition-all duration-300 hover:scale-105 active:scale-95 flex items-center gap-2">
                     <i data-feather="plus" class="w-4 h-4"></i> Nuova Richiesta
                </button>
            </div>

            <!-- Balance Card -->
            <div class="glass-panel p-6 rounded-[2rem] bg-gradient-to-b from-slate-800/80 to-slate-900/80 border border-slate-700/50 flex flex-col items-center justify-center text-center">
                <h3 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-4">Giorni Ferie Residui</h3>
                
                <div class="relative w-32 h-32 mb-4">
                     <!-- Circular Progress CSS Mock -->
                    <svg class="w-full h-full transform -rotate-90">
                        <circle cx="64" cy="64" r="56" stroke="currentColor" stroke-width="8" fill="transparent" class="text-slate-700" />
                        <circle cx="64" cy="64" r="56" stroke="currentColor" stroke-width="8" fill="transparent" stroke-dasharray="351.86" stroke-dashoffset="80" class="text-amber-400" stroke-linecap="round" />
                    </svg>
                    <div class="absolute inset-0 flex items-center justify-center flex-col">
                        <span class="text-4xl font-black text-white">22</span>
                        <span class="text-[10px] text-gray-400 font-bold uppercase">Giorni</span>
                    </div>
                </div>
                <div class="text-xs text-emerald-400 font-bold bg-emerald-500/10 px-3 py-1 rounded-full border border-emerald-500/20">
                    +2 maturati questo mese
                </div>
            </div>
        </div>

        <!-- Filter Tabs & Actions -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
            <div class="flex gap-4 overflow-x-auto pb-2 scrollbar-hide">
                <button id="btnFilterAll" class="filter-btn px-5 py-2 rounded-xl bg-indigo-600 text-white font-bold text-xs uppercase tracking-wider shadow-lg shadow-indigo-600/20 whitespace-nowrap active" data-filter="all">Tutte le Richieste</button>
                <button id="btnFilterPending" class="filter-btn px-5 py-2 rounded-xl bg-slate-800 text-gray-400 hover:text-white font-bold text-xs uppercase tracking-wider hover:bg-slate-700 transition-colors whitespace-nowrap" data-filter="Pending">In Attesa</button>
                <button id="btnFilterApproved" class="filter-btn px-5 py-2 rounded-xl bg-slate-800 text-gray-400 hover:text-white font-bold text-xs uppercase tracking-wider hover:bg-slate-700 transition-colors whitespace-nowrap" data-filter="Approved">Approvate</button>
                <button id="btnFilterRejected" class="filter-btn px-5 py-2 rounded-xl bg-slate-800 text-gray-400 hover:text-white font-bold text-xs uppercase tracking-wider hover:bg-slate-700 transition-colors whitespace-nowrap" data-filter="Rejected">Rifiutate</button>
            </div>
            
            <button onclick="clearAllRequests()" class="px-4 py-2 bg-red-500/10 hover:bg-red-500 text-red-400 hover:text-white rounded-xl font-bold text-xs uppercase tracking-wider transition-all border border-red-500/20 flex items-center gap-2">
                <i data-feather="trash-2" class="w-4 h-4"></i> Svuota Bacheca
            </button>
        </div>

        <!-- Requests List (Ultimate Card Style) -->
        <div id="requestsList" class="space-y-4">
            
            {{#requests}}
            <div class="request-item group relative bg-slate-800/40 backdrop-blur-md rounded-2xl border border-slate-700/50 p-6 transition-all hover:bg-slate-800/60 hover:border-indigo-500/30 hover:shadow-xl" data-status="{{status}}">
                 <!-- Status Color Bar -->
                 <div class="absolute left-0 top-6 bottom-6 w-1 rounded-r-xl 
                    {{#is_approved}}bg-emerald-500{{/is_approved}}
                    {{#is_rejected}}bg-red-500{{/is_rejected}}
                    {{#is_pending}}bg-amber-500{{/is_pending}}
                 "></div>

                <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 pl-4">
                    
                    <!-- User & Info -->
                    <div class="flex items-center gap-4">
                         <div class="w-14 h-14 rounded-2xl bg-slate-900 border border-slate-700 flex items-center justify-center shrink-0 shadow-inner">
                            <span class="font-black text-xl text-gray-500 group-hover:text-white transition-colors">{{employee_initials}}</span>
                        </div>
                        <div>
                            <h4 class="font-bold text-white text-lg flex items-center gap-2">
                                {{employee_name}}
                                <span class="px-2 py-0.5 rounded-md bg-white/5 text-[10px] uppercase tracking-wider text-gray-400 border border-white/5">{{type}}</span>
                            </h4>
                            <div class="flex items-center gap-2 text-gray-400 text-sm mt-1">
                                <i data-feather="calendar" class="w-3 h-3"></i>
                                <span class="font-medium text-indigo-300">{{start_date}} - {{end_date}}</span>
                            </div>
                        </div>
                    </div>

                    <!-- Reason -->
                    <div class="flex-1 md:pl-8 text-gray-400 italic text-sm line-clamp-2 md:line-clamp-1">
                        &ldquo;{{reason}}&rdquo;
                    </div>

                    <!-- Actions / Status -->
                    <div class="flex items-center gap-4 shrink-0">
                         {{#is_pending}}
                         <div class="flex gap-2">
                            <button onclick="updateRequest({{id}}, 'Approved')" class="px-4 py-2 bg-emerald-500/10 hover:bg-emerald-500 text-emerald-400 hover:text-white rounded-xl font-bold text-xs uppercase tracking-wider transition-all border border-emerald-500/20">Approva</button>
                            <button onclick="updateRequest({{id}}, 'Rejected')" class="px-4 py-2 bg-red-500/10 hover:bg-red-500 text-red-400 hover:text-white rounded-xl font-bold text-xs uppercase tracking-wider transition-all border border-red-500/20">Rifiuta</button>
                         </div>
                         {{/is_pending}}

                         {{^is_pending}}
                         <span class="px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider border 
                            {{#is_approved}}bg-emerald-500/10 text-emerald-400 border-emerald-500/20{{/is_approved}}
                            {{#is_rejected}}bg-red-500/10 text-red-400 border-red-500/20{{/is_rejected}}
                         ">
                            {{status}}
                         </span>
                         {{/is_pending}}

                         <!-- Delete Button -->
                         <button onclick="deleteRequest({{id}})" class="p-2 text-slate-500 hover:text-red-400 transition-colors" title="Elimina Richiesta">
                            <i data-feather="trash-2" class="w-4 h-4"></i>
                         </button>
                    </div>

                </div>
            </div>
            {{/requests}}

            {{^requests}}
            <div class="py-20 text-center glass-panel rounded-3xl border-dashed border-2 border-slate-700/50">
                <div class="inline-flex p-6 rounded-full bg-slate-800/50 mb-4 text-slate-500 ring-4 ring-slate-800/30">
                    <i data-feather="coffee" class="w-10 h-10"></i>
                </div>
                <h3 class="text-xl font-bold text-white mb-2">Tutto Tranquillo</h3>
                <p class="text-gray-500">Non ci sono richieste di ferie al momento.</p>
            </div>
            {{/requests}}
            
        </div>
    </main>

    <!-- Modal "Nuova Richiesta" -->
    <!-- Modal "Nuova Richiesta" (Standardized) -->
    <!-- Modal "Nuova Richiesta" (Standardized to Team Management) -->
    <div id="requestModal" class="fixed inset-0 hidden overflow-y-auto" style="z-index: 99999 !important;">
        <!-- Backdrop -->
        <div class="fixed inset-0 bg-black transition-opacity" style="opacity: 0.95;" onclick="document.getElementById('requestModal').classList.add('hidden')"></div>

        <div class="flex min-h-screen items-center justify-center p-4 text-center">
             <div class="inline-block w-full max-w-2xl p-0 my-8 overflow-hidden text-left align-middle transition-all transform bg-[#0f172a] shadow-2xl rounded-2xl border border-white/10 relative" style="color-scheme: dark;">
            
            <div class="px-6 py-4 bg-[#0f172a] border-b border-white/5 flex items-center justify-between">
                <h3 class="text-lg font-bold text-white flex items-center gap-2">
                    <div class="p-2 bg-indigo-500/20 rounded-lg">
                        <i data-feather="calendar" class="w-5 h-5 text-indigo-400"></i>
                    </div>
                    Nuova Richiesta Ferie
                 </h3>
                 <button onclick="document.getElementById('requestModal').classList.add('hidden')" class="p-2 rounded-lg hover:bg-white/5 text-slate-400 hover:text-white transition-colors">
                     <i data-feather="x" class="w-5 h-5"></i>
                 </button>
            </div>
            <div class="p-6 space-y-4">
                 <div>
                    <label class="block text-sm font-medium text-gray-300 mb-1">Dipendente</label>
                    <select id="reqEmployee" class="w-full rounded-xl bg-slate-800 border border-slate-600 px-4 py-3 text-white outline-none focus:border-indigo-500 transition-colors">
                        <option value="">Seleziona...</option>
                    </select>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-1">Dal</label>
                        <input id="reqStart" type="date" class="w-full rounded-xl bg-slate-800 border border-slate-600 px-4 py-3 text-white outline-none focus:border-indigo-500 text-sm transition-colors">
                    </div>
                    <div>
                         <label class="block text-sm font-medium text-gray-300 mb-1">Al</label>
                        <input id="reqEnd" type="date" class="w-full rounded-xl bg-slate-800 border border-slate-600 px-4 py-3 text-white outline-none focus:border-indigo-500 text-sm transition-colors">
                    </div>
                </div>
                <div>
                     <label class="block text-sm font-medium text-gray-300 mb-1">Motivazione</label>
                     <textarea id="reqReason" class="w-full rounded-xl bg-slate-800 border border-slate-600 px-4 py-3 text-white outline-none focus:border-indigo-500 text-sm h-32 placeholder-slate-500 transition-colors" placeholder="Es. Ferie estive..."></textarea>
                </div>
            </div>
            <div class="px-6 py-4 flex justify-end gap-3 border-t border-white/5 bg-[#0f172a]">
                <button onclick="document.getElementById('requestModal').classList.add('hidden')" class="px-5 py-2.5 rounded-xl text-slate-300 hover:text-white hover:bg-white/5 transition-all font-medium border border-transparent hover:border-white/10">Annulla</button>
                <button id="btnSaveRequest" class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-500 hover:to-purple-500 text-white shadow-lg shadow-indigo-500/25 transition-all transform hover:-translate-y-0.5 active:translate-y-0 font-medium flex items-center gap-2">
                    <i data-feather="check" class="w-4 h-4"></i>
                    Invia Richiesta
                </button>
            </div>
            </div>
        </div>
    </div>


    {{> workshift/footer}}
    <script src="{{base_url}}/js/workshift-api.js"></script>
    <script src="{{base_url}}/js/pages/workshift-time-off.js"></script>
    <script>
        feather.replace();
    </script>
</body>
</html>
