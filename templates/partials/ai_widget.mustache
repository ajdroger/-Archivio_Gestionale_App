<!-- AI Assistant Floating Widget -->
<div x-data="{ 
    open: false, 
    minimized: false,
    listening: false,
    toggleVoice() {
        if (!('webkitSpeechRecognition' in window) && !('SpeechRecognition' in window)) {
            alert('Il tuo browser non supporta il riconoscimento vocale.');
            return;
        }
        
        if (this.listening) {
            this.recognition.stop();
            this.listening = false;
            return;
        }

        const Speech = window.SpeechRecognition || window.webkitSpeechRecognition;
        this.recognition = new Speech();
        this.recognition.lang = 'it-IT';
        this.recognition.interimResults = false;

        this.recognition.onstart = () => {
            this.listening = true;
        };

        this.recognition.onresult = (event) => {
            const transcript = event.results[0][0].transcript;
            const input = document.querySelector('input[name=message]');
            input.value = transcript;
            // Optional: Auto-submit
            // htmx.trigger(input.form, 'submit'); 
        };

        this.recognition.onend = () => {
            this.listening = false;
        };
        
        this.recognition.onerror = (event) => {
            console.error('Speech error:', event.error);
            this.listening = false;
        };

        this.recognition.start();
    }
}" class="position-fixed bottom-0 end-0 p-3" style="z-index: 9999;">
    
    <!-- Trigger Button -->
    <button x-show="!open" 
            @click="open = true" 
            class="btn btn-primary rounded-circle shadow-lg d-flex align-items-center justify-content-center p-0 ai-widget-trigger"
            style="width: 60px; height: 60px; transition: transform 0.2s;">
        <i class="fa-solid fa-brain fs-3"></i>
    </button>

    <!-- Chat Window -->
    <div x-show="open" 
         x-transition:enter="transition ease-out duration-300"
         x-transition:enter-start="opacity-0 translate-y-full"
         x-transition:enter-end="opacity-100 translate-y-0"
         x-transition:leave="transition ease-in duration-200"
         x-transition:leave-start="opacity-100 translate-y-0"
         x-transition:leave-end="opacity-0 translate-y-full"
         class="card bg-black border border-secondary shadow-lg"
         style="width: 380px; height: 500px; max-height: 80vh;">
         
        <!-- Header -->
        <div class="card-header bg-dark border-bottom border-secondary d-flex justify-content-between align-items-center py-2">
            <span class="fw-bold text-white small"><i class="fa-solid fa-robot text-info me-2"></i>Archivio Parlante</span>
            <div>
                <button @click="document.getElementById('ai-widget-response').innerHTML = ''" class="btn btn-sm text-secondary p-0 me-2" title="Pulisci"><i class="fa-solid fa-eraser"></i></button>
                <button @click="open = false" class="btn btn-sm text-secondary p-0"><i class="fa-solid fa-xmark"></i></button>
            </div>
        </div>
        
        <!-- Chat Body -->
        <div class="card-body bg-black p-2 d-flex flex-column" style="height: 100%; overflow-y: auto;">
            <div id="ai-widget-response" class="flex-grow-1 d-flex flex-column justify-content-end">
                <div class="d-flex justify-content-start mb-2">
                    <div class="bg-dark text-light p-2 rounded-3 border border-secondary small" style="max-width: 85%">
                        Sono qui. Sto leggendo {{title}}. Come posso aiutarti?
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Footer / Input -->
        <div class="card-footer bg-dark border-top border-secondary p-2">
            <div class="d-flex gap-2">
                 <!-- Upload (Partial Support) -->
                 <form hx-post="{{base_url}}/ai/assistant/upload" 
                      hx-encoding="multipart/form-data" 
                      hx-target="#ai-widget-response" 
                      hx-swap="beforeend scroll:bottom"
                      class="d-flex">
                    <input type="hidden" name="{{csrf.keys.name}}" value="{{csrf.name}}">
                    <input type="hidden" name="{{csrf.keys.value}}" value="{{csrf.value}}">
                    <label for="widget-file-upload" class="btn btn-sm btn-outline-secondary d-flex align-items-center justify-content-center" style="width: 32px;" title="Carica PDF/Word/Excel/Codice">
                        <i class="fa-solid fa-paperclip"></i>
                    </label>
                    <input type="file" id="widget-file-upload" name="document" accept=".pdf,.docx,.xlsx,.txt,.md,.php,.js,.py,.java,.sql" class="d-none" onchange="htmx.trigger(this.form, 'submit'); this.value='';">
                </form>

                <!-- Message -->
                <form hx-post="{{base_url}}/ai/assistant/message" 
                      hx-target="#ai-widget-response" 
                      hx-swap="beforeend scroll:bottom"
                      hx-on::after-request="this.reset()"
                      class="flex-grow-1">
                    
                    <input type="hidden" name="{{csrf.keys.name}}" value="{{csrf.name}}">
                    <input type="hidden" name="{{csrf.keys.value}}" value="{{csrf.value}}">
                    <!-- Context Injection -->
                    <input type="hidden" name="context_url" x-init="$el.value = window.location.href">
                    <input type="hidden" name="context_title" value="{{title}}">
                    
                    <div class="input-group input-group-sm">
                        <input type="text" name="message" class="form-control bg-black text-white border-secondary" placeholder="Scrivi o parla..." required autocomplete="off">
                        
                        <!-- Mic Button -->
                        <button class="btn btn-secondary text-white" type="button" @click="toggleVoice()" :class="{'btn-danger': listening, 'btn-secondary': !listening}">
                             <i class="fa-solid" :class="{'fa-microphone-slash': listening, 'fa-microphone': !listening}"></i>
                        </button>

                        <button class="btn btn-info text-white" type="submit">
                            <i class="fa-solid fa-paper-plane"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .ai-widget-trigger:hover {
        transform: scale(1.1);
    }
</style>
