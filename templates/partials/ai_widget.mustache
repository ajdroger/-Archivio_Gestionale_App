<!-- AI Assistant Floating Widget (Vanilla JS Version - Robust) -->
<div id="ai-widget-container" class="position-fixed bottom-0 end-0 p-3" style="z-index: 9999;">
    
    <!-- Trigger Button -->
    <button id="ai-widget-trigger-btn"
            class="btn btn-primary rounded-circle shadow-lg d-flex align-items-center justify-content-center p-0 ai-widget-trigger"
            style="width: 60px; height: 60px; transition: transform 0.2s;">
        <i class="fa-solid fa-brain fs-3"></i>
    </button>

    <!-- Chat Window -->
    <div id="ai-widget-window" 
         class="card bg-black border border-secondary shadow-lg d-flex flex-column d-none animate__animated animate__fadeInUp"
         style="width: 380px; height: 500px; max-height: 80vh;">
         
        <!-- Header -->
        <div class="card-header bg-dark border-bottom border-secondary d-flex justify-content-between align-items-center py-2">
            <span class="fw-bold text-white small"><i class="fa-solid fa-robot text-info me-2"></i>Assistente Virtuale</span>
            <div>
                <button onclick="document.getElementById('ai-widget-response').innerHTML = ''" class="btn btn-sm text-secondary p-0 me-2" title="Pulisci"><i class="fa-solid fa-eraser"></i></button>
                <button id="ai-widget-close-btn" class="btn btn-sm text-secondary p-0"><i class="fa-solid fa-xmark"></i></button>
            </div>
        </div>
        
        <!-- Chat Body -->
        <div class="card-body bg-black p-2 d-flex flex-column" style="height: 100%; overflow-y: auto;">
            <div id="ai-widget-response" class="flex-grow-1 d-flex flex-column justify-content-end">
                <div class="d-flex justify-content-start mb-2">
                    <div class="bg-dark text-light p-2 rounded-3 border border-secondary small" style="max-width: 85%">
                        Sono qui. Sto leggendo {{title}}. Come posso aiutarti?
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Footer / Input -->
        <div class="card-footer bg-dark border-top border-secondary p-2">
            <div class="d-flex gap-2">
                 <!-- Upload (Partial Support) -->
                 <form hx-post="{{base_url}}/ai/assistant/upload" 
                      hx-encoding="multipart/form-data" 
                      hx-target="#ai-widget-response" 
                      hx-swap="beforeend scroll:bottom"
                      class="d-flex">
                    <input type="hidden" name="{{csrf.keys.name}}" value="{{csrf.name}}">
                    <input type="hidden" name="{{csrf.keys.value}}" value="{{csrf.value}}">
                    <label for="widget-file-upload" class="btn btn-sm btn-outline-secondary d-flex align-items-center justify-content-center" style="width: 32px;" title="Carica PDF/Word/Excel/Codice">
                        <i class="fa-solid fa-paperclip"></i>
                    </label>
                    <input type="file" id="widget-file-upload" name="document" accept=".pdf,.docx,.xlsx,.txt,.md,.php,.js,.py,.java,.sql" class="d-none" onchange="htmx.trigger(this.form, 'submit'); this.value='';">
                </form>

                <!-- Message -->
                <form hx-post="{{base_url}}/ai/assistant/message" 
                      hx-target="#ai-widget-response" 
                      hx-swap="beforeend scroll:bottom"
                      hx-on::after-request="this.reset()"
                      class="flex-grow-1">
                    
                    <input type="hidden" name="{{csrf.keys.name}}" value="{{csrf.name}}">
                    <input type="hidden" name="{{csrf.keys.value}}" value="{{csrf.value}}">
                    <!-- Context Injection -->
                    <input type="hidden" name="context_url" x-init="$el.value = window.location.href">
                    <input type="hidden" name="context_title" value="{{title}}">
                    
                    <div class="input-group input-group-sm">
                        <input type="text" id="ai-widget-message" name="message" class="form-control bg-black text-white border-secondary" placeholder="Scrivi o parla..." required autocomplete="off">
                        
                        <!-- Mic Button -->
                        <button class="btn btn-outline-secondary text-white" type="button" id="ai-widget-mic-btn" data-bs-toggle="tooltip" title="Parlami">
                             <i class="fa-solid fa-microphone"></i>
                        </button>

                        <button class="btn btn-info text-white" type="submit">
                            <i class="fa-solid fa-paper-plane"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Vanilla JS Logic for Widget State & Speech -->
    <script>
    document.addEventListener('DOMContentLoaded', () => {
        // --- Widget Toggle Logic ---
        const container = document.getElementById('ai-widget-container');
        const triggerBtn = document.getElementById('ai-widget-trigger-btn');
        const closeBtn = document.getElementById('ai-widget-close-btn');
        const windowEl = document.getElementById('ai-widget-window');

        // Initial State: Ensure Closed
        windowEl.classList.add('d-none');
        triggerBtn.classList.remove('d-none');

        triggerBtn.addEventListener('click', () => {
            windowEl.classList.remove('d-none');
            triggerBtn.classList.add('d-none');
            // Auto Focus
            setTimeout(() => document.getElementById('ai-widget-message').focus(), 100);
        });

        closeBtn.addEventListener('click', () => {
            windowEl.classList.add('d-none');
            triggerBtn.classList.remove('d-none');
        });

        // --- Speech Logic ---
        const micBtn = document.getElementById('ai-widget-mic-btn');
        const input = document.getElementById('ai-widget-message');
        
        if (micBtn && input && ('webkitSpeechRecognition' in window)) {
            const recognition = new webkitSpeechRecognition();
            recognition.lang = 'it-IT';
            recognition.continuous = false;
            recognition.interimResults = false;

            micBtn.addEventListener('click', () => {
                if (micBtn.classList.contains('text-danger')) {
                    recognition.stop();
                } else {
                    recognition.start();
                    micBtn.classList.add('text-danger', 'animate__animated', 'animate__pulse', 'animate__infinite');
                }
            });

            recognition.onresult = (event) => {
                const transcript = event.results[0][0].transcript;
                input.value = transcript;
                micBtn.classList.remove('text-danger', 'animate__animated', 'animate__pulse', 'animate__infinite');
                input.focus();
            };

            recognition.onerror = (event) => {
                console.error('Speech Recognition Error:', event.error);
                micBtn.classList.remove('text-danger', 'animate__animated', 'animate__pulse', 'animate__infinite');
            };

            recognition.onend = () => {
                micBtn.classList.remove('text-danger', 'animate__animated', 'animate__pulse', 'animate__infinite');
            };
        } else if (micBtn) {
            micBtn.style.display = 'none';
        }
    });
    </script>
</div>

<style>
    .ai-widget-trigger:hover {
        transform: scale(1.1);
    }
</style>

