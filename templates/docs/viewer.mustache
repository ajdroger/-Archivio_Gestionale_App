<!DOCTYPE html>
<html lang="it" class="h-100">
<head>
    <meta charset="UTF-8">
    <title>{{filename}} - Docs | MCAG</title>
    <link href="{{base_url}}/css/bootstrap.min.css" rel="stylesheet">
    <link href="{{base_url}}/css/all.min.css" rel="stylesheet">
    <link href="{{base_url}}/css/premium.css" rel="stylesheet">
    <link href="{{base_url}}/css/components/scroll_navigator.css" rel="stylesheet">
    <!-- Highlight.js for code blocks -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
</head>
<body class="d-flex flex-column h-100 bg-black text-white">

    <nav class="navbar navbar-dark bg-dark border-bottom border-secondary mb-0 sticky-top">
        <div class="container-fluid px-4">
            <div class="d-flex align-items-center gap-3">
                <a href="{{back_url}}" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-arrow-left"></i></a>
                <span class="navbar-brand mb-0 h1 fs-6"><span class="text-secondary">{{category}} /</span> {{filename}}</span>
            </div>
            <div>
                 <span class="badge bg-info text-dark">READ ONLY</span>
            </div>
        </div>
    </nav>

    <div class="flex-grow-1 overflow-auto bg-dark">
        <div class="container py-4">
            <div class="card bg-black border-secondary shadow-lg">
                <div class="card-body p-4 p-lg-5">
                    {{#is_markdown}}
                    <!-- Raw Markdown Container (Ideally parsed server-side, but using pre-wrap for robust fallback) -->
                    <div class="markdown-body text-light font-monospace" style="white-space: pre-wrap; font-size: 0.9rem; line-height: 1.6;">{{content}}</div>
                    {{/is_markdown}}
                    
                    {{^is_markdown}}
                    <pre class="text-light">{{content}}</pre>
                    {{/is_markdown}}
                </div>
            </div>
        </div>
    </div>

    <script>hljs.highlightAll();</script>
    <!-- Scroll Navigator -->
    <script src="{{base_url}}/js/components/scroll_navigator.js"></script>
</body>
</html>
