{{> layout_header }}

<div class="container-fluid py-5 px-4 bg-dark min-h-screen">
    <!-- Back Header -->
    <div class="mb-4">
        <a href="{{base_url}}/docs" class="text-secondary text-decoration-none small hover-white transition-all">
            <i class="fa-solid fa-arrow-left me-2"></i>Torna al Knowledge Hub
        </a>
    </div>

    <!-- Title Section -->
    <div class="d-flex justify-content-between align-items-center mb-5 border-bottom border-secondary border-opacity-25 pb-4">
        <div>
            <h1 class="text-white fw-bold mb-2">{{category}}</h1>
            <p class="text-secondary mb-0">Esplora i documenti in questa sezione.</p>
        </div>
        <div>
            <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-3 py-2 rounded-pill">
                {{files.length}} Risorse
            </span>
        </div>
    </div>

    <!-- Files List Grid -->
    <div class="row g-3">
        {{#files}}
        <div class="col-md-6 col-lg-4 col-xl-3">
            <div class="card h-100 bg-black border border-secondary border-opacity-25 shadow-sm hover-elevate transition-all group">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex align-items-start mb-3">
                        <div class="p-3 rounded bg-secondary bg-opacity-10 text-info me-3 group-hover:bg-info group-hover:text-white transition-colors">
                            <i class="fa-solid fa-file-lines fa-lg"></i>
                        </div>
                        <div class="flex-grow-1 overflow-hidden">
                            <h6 class="text-white fw-bold mb-1 text-truncate" title="{{name}}">{{name}}</h6>
                            <span class="badge bg-dark border border-secondary text-secondary x-small">{{extension}}</span>
                        </div>
                    </div>
                    
                    <div class="mt-auto d-flex justify-content-between align-items-center border-top border-secondary border-opacity-10 pt-3">
                        <span class="text-secondary x-small font-monospace">{{size}}</span>
                        <a href="{{url}}" class="btn btn-sm btn-outline-light rounded-pill px-3" target="_blank" download>
                            <i class="fa-solid fa-download me-2"></i>Scarica
                        </a>
                    </div>
                </div>
            </div>
        </div>
        {{/files}}

        {{^files}}
        <div class="col-12 py-5 text-center">
             <i class="fa-regular fa-folder-open fa-3x text-secondary opacity-25 mb-3"></i>
             <p class="text-secondary">Nessun file trovato in questa categoria.</p>
        </div>
        {{/files}}
    </div>
</div>

<style>
.hover-elevate:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 255, 255, 0.15) !important;
    background: rgba(255, 255, 255, 0.02);
}
.transition-colors {
    transition: background-color 0.2s, color 0.2s;
}
.group:hover .group-hover\:bg-info {
    background-color: var(--bs-info) !important;
}
.group:hover .group-hover\:text-white {
    color: white !important;
}
</style>

{{> layout_footer }}
