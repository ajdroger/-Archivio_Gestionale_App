<!DOCTYPE html>
<html lang="it" class="h-100">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Errore Sistema - MCAG Archivio</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="{{base_url}}/css/style.css">
</head>
<body class="d-flex align-items-center justify-content-center h-100">

    <div class="container text-center">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
                <div class="card error-card rounded-4 p-5">
                    <div class="mb-4">
                        <i class="fa-solid fa-triangle-exclamation fa-4x text-danger opacity-75"></i>
                    </div>
                    
                    <h1 class="display-6 fw-bold mb-3">{{title}}</h1>
                    <p class="lead text-secondary mb-4">{{message}}</p>
                    
                    {{#debug_msg}}
                    <div class="accordion mb-4" id="debugAccordion">
                        <div class="accordion-item bg-black bg-opacity-25 border-danger border-opacity-25">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed bg-transparent text-danger shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#collapseDebug">
                                    <i class="fa-solid fa-bug me-2"></i>Dettagli Tecnici (Admin)
                                </button>
                            </h2>
                            <div id="collapseDebug" class="accordion-collapse collapse" data-bs-parent="#debugAccordion">
                                <div class="accordion-body text-start font-monospace small text-white-50 overflow-auto" style="max-height: 200px;">
                                    <strong>Message:</strong> {{debug_msg}}<br>
                                    <strong>Trace:</strong><br>
                                    <pre>{{trace}}</pre>
                                </div>
                            </div>
                        </div>
                    </div>
                    {{/debug_msg}}
                    
                    <div class="d-grid gap-3 d-sm-flex justify-content-center">
                        <a href="{{base_url}}/" class="btn btn-home px-4 py-2 rounded-pill">
                            <i class="fa-solid fa-house me-2"></i>Torna alla Dashboard
                        </a>
                        <button onclick="window.location.reload()" class="btn btn-outline-danger px-4 py-2 rounded-pill">
                            <i class="fa-solid fa-rotate-right me-2"></i>Riprova
                        </button>
                    </div>
                </div>
                
                <p class="mt-4 text-secondary opacity-50 small">&copy; {{year}} MCAG - Militare Civile Archivio Gestionale</p>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

