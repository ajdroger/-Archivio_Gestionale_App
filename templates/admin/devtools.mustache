<!-- 
    ========================================================================================
    MISSION CONTROL CENTER v3.1 (Edizione Premium)
    ========================================================================================
    
    FILE: templates/devtools.mustache
    DESCRIZIONE:
    Questo template rappresenta l'interfaccia amministrativa principale (Dashboard).
    Include funzionalità per:
    1. Monitoraggio dello stato del sistema (Health Check, Versioni, Backup).
    2. Gestione Sicurezza (Utenti, 2FA, Session Inspector).
    3. Audit & Forensics (Log di sicurezza, Tracciamento richieste).
    4. Toolkit di Sviluppo (Script, Test Automatizzati, Rebranding).
    5. Accesso ai Dati (Console SQL, Editor di File).

    STRUTTURA:
    - CSS Personalizzato (Theming Cyperpunk/Glassmorphism).
    - Sidebar di Navigazione (nav-pills).
    - Area Contenuto Principale con Tabs (Bootstrap).
    - Terminale/Console a scomparsa.
    - Logica JavaScript per interazioni API (AJAX).

    NOTE PER MANUTENTORI:
    - Tutte le chiamate API sono gestite dalla funzione `api()` in JS.
    - I dati iniziali sono iniettati da Mustache (SSR).
    - Il layout è responsive ma ottimizzato per Desktop.
    
    AUTORE: Agente (Refactoring v3.1)
    ========================================================================================
-->

<!-- CONFIGURAZIONE GLOBALE: Token CSRF per sicurezza chiamate AJAX -->
<script>
    /**
     * Oggetto globale per la gestione della sicurezza CSRF.
     * I valori sono iniettati dal motore di template Mustache.
     */
    window.CSRF = {
        name: '{{csrf.name}}',  // Nome del token (es. csrf_name)
        value: '{{csrf.value}}' // Valore hash del token
    };
</script>

<!-- STILI PERSONALIZZATI: Tema Scuro Premium -->
<style>
    /* --- DEFINIZIONE VARIABILI (CONTRASTO OTTIMIZZATO & COMFORT) --- */
    :root {
        --bg-dark: #111827;        /* Grigio Scuro Profondo (Gray 900) - Meno duro del nero */
        --bg-panel: #1f2937;       /* Grigio Pannelli (Gray 800) */
        --border-color: #374151;   /* Bordi Grigi (Gray 700) */
        --text-main: #f9fafb;      /* Bianco Morbido (Gray 50) */
        --text-muted: #d1d5db;     /* Grigio Chiaro (Gray 300) */
        
        /* Colori Accento ad Alta Leggibilità */
        --accent-primary: #38bdf8; /* Sky 400 */
        --accent-success: #34d399; /* Emerald 400 */
        --accent-warning: #fbbf24; /* Amber 400 */
        --accent-danger: #f87171;  /* Red 400 */
    }
    
    /* Configurazione Body */
    body { 
        background-color: var(--bg-dark); 
        color: var(--text-main); 
        font-family: 'Segoe UI', system-ui, sans-serif;
        font-size: 16px;
        line-height: 1.6; 
        overflow-x: hidden; 
    }

    /* Pannelli: Spaziosi e Solidi */
    .glass-panel {
        background-color: var(--bg-panel) !important;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
        margin-bottom: 24px;
        transition: transform 0.2s; /* Micro-interazione */
    }
    
    /* Sidebar Link */
    .sidebar-link {
        color: var(--text-muted);
        border-radius: 8px;
        font-weight: 600;
        font-size: 1rem;
        padding: 12px 20px;
        margin-bottom: 8px;
        border: 1px solid transparent; /* Prevents layout shift on hover */
    }
    
    .sidebar-link:hover, .sidebar-link.active {
        background-color: #374151; /* Gray 700 */
        color: #ffffff;
        border-left: 5px solid var(--accent-primary);
        padding-left: 25px; /* Animazione smooth */
    }
    
    /* Tables: Cells Spaziose e No-Wrap per Azioni */
    .table-dark-custom th {
        background-color: #111827;
        color: #f3f4f6;
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        border-bottom: 2px solid #4b5563;
        padding: 16px;
    }
    .table-dark-custom td {
        background-color: #1f2937;
        border-color: #374151;
        vertical-align: middle;
        padding: 16px; /* Hitting area confortevole */
        color: var(--text-main);
        font-size: 0.95rem;
    }
    
    /* Prevent wrapping on Action columns */
    .td-actions {
        white-space: nowrap;
        width: 1%; /* Shrink to fit content */
        min-width: 150px; /* Min width for buttons */
    }
    
    .hover-row:hover td { 
        background-color: #374151 !important; 
    }

    /* Common Utilities */
    .fw-bold { font-weight: 700 !important; }
    .text-muted { color: #9ca3af !important; }
    
    /* Card Body Expansion */
    .card-body { padding: 24px !important; }

    /* Input Fields più leggibili */
    .form-control, .form-select {
        background-color: #111827 !important;
        border: 1px solid #4b5563 !important;
        color: #fff !important;
        padding: 10px 14px;
    }
    .form-control:focus {
        border-color: var(--accent-primary) !important;
        box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.25);
    }

    /* Titoli sezioni */
    .uppercase-tracking {
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-size: 0.75rem;
    }

    /* Scrollbar Personalizzata (Webkit) */
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: var(--bg-dark); }
    ::-webkit-scrollbar-thumb { background: var(--border-color); border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: #64748b; }
</style>

<!-- ######################################################################################## -->
<!-- LAYOUT PRINCIPALE -->
<div class="d-flex min-vh-100 bg-black">
    
