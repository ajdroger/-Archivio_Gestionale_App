                    <div class="card-header bg-transparent border-bottom border-secondary border-opacity-25 py-3">
                        <h6 class="text-white mb-0 fw-bold"><i class="fa-solid fa-server me-2 text-secondary"></i>AMBIENTE SERVER & CONFIGURAZIONE PHP</h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-4 text-center">
                            <div class="col-md-3 col-6 border-end border-secondary border-opacity-25">
                                <h6 class="text-muted small uppercase-tracking mb-1">MEMORY LIMIT</h6>
                                <div class="fs-4 fw-bold font-monospace text-white">{{system.memory_limit}}</div>
                            </div>
                            <div class="col-md-3 col-6 border-end border-secondary border-opacity-25">
                                <h6 class="text-muted small uppercase-tracking mb-1">MAX UPLOAD</h6>
                                <div class="fs-4 fw-bold font-monospace text-white">{{system.upload_max}}</div>
                            </div>
                            <div class="col-md-3 col-6 border-end border-secondary border-opacity-25">
                                <h6 class="text-muted small uppercase-tracking mb-1">MAX EXECUTION</h6>
                                <div class="fs-4 fw-bold font-monospace text-white">{{system.max_execution}}</div>
                            </div>
                            <div class="col-md-3 col-6">
                                <h6 class="text-muted small uppercase-tracking mb-1">SERVER SW</h6>
                                <div class="fs-6 fw-bold text-white text-truncate" title="{{system.server_software}}">{{system.server_software}}</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 
                ************* TAB 2: SECURITY CENTER ************* 
                Gestione Utenti, 2FA e Ispezione Sessione.
            -->
            <div class="tab-pane fade" id="v-pills-security" role="tabpanel">
                 <div class="row g-4">
                     <!-- RIGA 1: Lista Utenti (FULL WIDTH per massima visibilità) -->
                     <div class="col-12">
                         <div class="card glass-panel border-0 h-100">
                             <div class="card-header bg-transparent border-bottom border-secondary border-opacity-25 d-flex justify-content-between align-items-center py-3">
                                 <h6 class="text-white mb-0 fw-bold"><i class="fa-solid fa-users-gear me-2"></i>IDENTITY MANAGEMENT</h6>
                                 <button class="btn btn-sm btn-dark border-secondary bg-black bg-opacity-50" onclick="loadUsers()">
                                     <i class="fa-solid fa-arrows-rotate me-1"></i> Aggiorna
                                 </button>
                             </div>
                             <div class="card-body p-0">
                                 <div class="table-responsive h-100 p-2">
                                     <table class="table table-dark-custom table-hover mb-0 w-100 align-middle">
                                         <thead>
                                             <tr>
                                                 <th class="ps-4" style="width: 30%;">Username</th>
                                                 <th style="width: 20%;">Ruolo</th>
                                                 <th style="width: 20%;">Stato 2FA</th>
                                                 <th class="text-end pe-4 td-actions" style="width: 30%;">Azioni</th>
                                             </tr>
                                         </thead>
                                         <tbody id="user-list-body">
