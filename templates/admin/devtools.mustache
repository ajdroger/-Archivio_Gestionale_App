                         </div>
                     </div>

                     <!-- Card: Session Inspector -->
                     <div class="col-xl-6 col-12">
                         <div class="card glass-panel border-0 h-100">
                             <div class="card-header bg-transparent border-bottom border-secondary border-opacity-25 py-3 d-flex justify-content-between">
                                  <h6 class="text-white mb-0 fw-bold"><i class="fa-solid fa-bug me-2 text-warning"></i>SESSION INSPECTOR</h6>
                                  <span class="badge bg-dark border border-secondary text-secondary code-font small">{{session_debug.status}}</span>
                             </div>
                             <div class="card-body">
                                 <div class="d-flex justify-content-between align-items-center mb-3 p-3 bg-black bg-opacity-40 rounded border border-secondary border-opacity-25">
                                     <div>
                                         <div class="small text-muted mb-1">SESSION ID</div>
                                         <code class="text-info fs-6">{{session_debug.id}}</code>
                                     </div>
                                     <div class="text-end">
                                          <div class="small text-muted mb-1">ULTIMA ATTIVITÀ</div>
                                          <span class="text-white">{{session_debug.meta.last_activity}}</span>
                                     </div>
                                 </div>
                                 
                                 <h6 class="text-muted small fw-bold mb-2 uppercase-tracking">DATA PAYLOAD (MASKED)</h6>
                                 <div class="overflow-auto custom-scrollbar bg-black bg-opacity-40 rounded p-3" style="max-height: 250px; border: 1px solid rgba(255,255,255,0.1);">
                                     <table class="table table-sm table-borderless text-light mb-0 code-font small">
