                                             <tr><td colspan="4" class="text-center p-5 text-muted"><i class="fa-solid fa-spinner fa-spin me-2"></i>Caricamento utenti...</td></tr>
                                         </tbody>
                                     </table>
                                 </div>
                             </div>
                         </div>
                     </div>

                     <!-- RIGA 2: Strumenti Provisioning & Debug -->
                     <!-- Card: Provisioning (Aggiungi Utente) -->
                     <div class="col-xl-6 col-12">
                         <div class="card glass-panel border-0 h-100">
                             <div class="card-header bg-transparent border-bottom border-secondary border-opacity-25 py-3">
                                 <h6 class="text-white mb-0 fw-bold"><i class="fa-solid fa-user-plus me-2 text-primary"></i>PROVISIONING</h6>
                             </div>
