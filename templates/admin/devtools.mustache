                                         <div class="col-md-6">
                                             <label class="form-label small text-muted">Username</label>
                                             <input type="text" name="username" class="form-control" placeholder="es. mario.rossi" required>
                                         </div>
                                         <div class="col-md-6">
                                             <label class="form-label small text-muted">Password Temp</label>
                                             <input type="password" name="password" class="form-control" placeholder="Min. 8 caratteri" required>
