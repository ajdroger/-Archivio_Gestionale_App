                <i class="fa-solid fa-code w-30px me-3 text-center"></i>Code Reactor
            </button>
        </div>

        <!-- Profilo Utente (Bottom) -->
        <div class="mt-auto pt-4 border-top border-secondary">
            <div class="d-flex align-items-center p-3 rounded" style="background-color: #1a1a1a;">
                <div class="rounded-circle bg-white d-flex align-items-center justify-content-center text-black fw-bold me-3 border border-secondary" style="width: 48px; height: 48px; font-size: 1.2rem;">
                    {{user_initial}}
                </div>
                <div class="flex-grow-1 overflow-hidden">
                    <div class="text-white fs-6 fw-bold text-truncate">{{username}}</div>
                    <div class="text-success text-truncate small fw-bold">● Online</div>
                </div>
                <a href="/fratellanza-militare-archivio/public/logout" class="btn btn-lg text-danger ms-2" title="Disconnetti">
                    <i class="fa-solid fa-right-from-bracket"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- 
        ========================================
        2. AREA CONTENUTO PRINCIPALE
        Gestisce i diversi pannelli tramite Tab-Content.
        SPAZIATURA AUMENTATA (p-5) e FULL WIDTH
        ========================================
    -->
    <div class="flex-grow-1 overflow-auto bg-black position-relative" style="padding-left: 0;">
        
        <!-- Top Bar Appiccicosa (Sticky) -->
        <header class="py-4 px-5 border-bottom border-secondary d-flex justify-content-between align-items-center sticky-top z-index-100" style="background-color: #0a0a0a;">
            <div class="d-flex align-items-center">
                <h4 class="mb-0 text-white fw-bold tracking-tight" id="page-title">SISTEMA DI CONTROLLO</h4>
            </div>
            <div class="d-flex gap-3">
                 <!-- Pulsante Toggle Terminale -->
                 <button class="btn btn-dark border-secondary text-white d-flex align-items-center px-4 py-2" onclick="toggleTerminal()">
                     <i class="fa-solid fa-terminal me-2"></i>Console
                 </button>
                 <a href="/fratellanza-militare-archivio/public/dashboard" class="btn btn-outline-light d-flex align-items-center px-4 py-2">
                     <i class="fa-solid fa-home me-2"></i>Home
                 </a>
            </div>
        </header>

        <!-- Contenitore Tab Panels -->
        <div class="p-5 tab-content w-100" id="v-pills-tabContent">
            
            <!-- 
                ************* TAB 1: DASHBOARD ************* 
                Panoramica metriche e azioni rapide.
            -->
            <div class="tab-pane fade show active" id="v-pills-dash" role="tabpanel">
                
                <!-- RIGA 1: Metriche Sistema -->
                <div class="row g-4 mb-4">
                    <!-- Integrity Card -->
                    <div class="col-xl-3 col-md-6 col-12">
                        <div class="card glass-panel h-100 border-0 metric-card">
                            <div class="card-body">
                                <h6 class="text-muted uppercase-tracking small mb-2">INTEGRITÀ DB</h6>
                                <div class="d-flex align-items-center justify-content-between">
                                    <h3 class="mb-0 code-font">{{health.database.integrity}}</h3>
                                    <i class="fa-solid fa-check-circle text-success fs-2 opacity-50"></i>
                                </div>
                                <div class="mt-2 text-success small border-top border-secondary border-opacity-10 pt-2">
                                    <i class="fa-solid fa-satellite-dish me-1"></i> Connessione Stabile
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Backups Card -->
                    <div class="col-xl-3 col-md-6 col-12">
                         <div class="card glass-panel h-100 border-0 metric-card">
                            <div class="card-body">
                                <h6 class="text-muted uppercase-tracking small mb-2">BACKUP TOTALI</h6>
                                <div class="d-flex align-items-center justify-content-between">
                                    <h3 class="mb-0 code-font">{{health.backups.count}}</h3>
                                    <i class="fa-solid fa-cloud-arrow-down text-info fs-2 opacity-50"></i>
                                </div>
                                <div class="mt-2 text-muted small border-top border-secondary border-opacity-10 pt-2">
                                    Ultimo: {{health.backups.latest_age_hours}} ore fa
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- PHP Version -->
                    <div class="col-xl-3 col-md-6 col-12">
                         <div class="card glass-panel h-100 border-0 metric-card">
                            <div class="card-body">
                                <h6 class="text-muted uppercase-tracking small mb-2">VERSIONE PHP</h6>
                                <div class="d-flex align-items-center justify-content-between">
                                    <h3 class="mb-0 code-font">{{system.php_version}}</h3>
                                    <i class="fa-brands fa-php text-primary fs-2 opacity-50"></i>
                                </div>
                                <div class="mt-2 text-muted small border-top border-secondary border-opacity-10 pt-2 text-truncate">
                                    OS: {{system.os}}
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Security Status -->
                    <div class="col-xl-3 col-md-6 col-12">
                         <div class="card glass-panel h-100 border-0 metric-card">
                            <div class="card-body">
                                <h6 class="text-muted uppercase-tracking small mb-2">SICUREZZA</h6>
                                <div class="d-flex align-items-center justify-content-between">
                                    <h3 class="mb-0 text-success fw-bold">100%</h3>
                                    <i class="fa-solid fa-shield-cat text-success fs-2 opacity-50"></i>
                                </div>
                                <div class="mt-2 text-success small border-top border-secondary border-opacity-10 pt-2">
                                    <i class="fa-solid fa-lock me-1"></i> 2FA Attiva
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- RIGA 2: Quick Actions & Status -->
                <div class="row g-4 mb-4">
                    <!-- Quick Actions -->
                    <div class="col-xl-8 col-lg-12">
                        <div class="card glass-panel border-0 h-100">
                             <div class="card-header bg-transparent border-bottom border-secondary border-opacity-25 py-3">
                                 <h6 class="text-white mb-0 fw-bold"><i class="fa-solid fa-bolt me-2 text-warning"></i>AZIONI RAPIDE DI SISTEMA</h6>
                             </div>
                             <div class="card-body">
                                 <div class="row g-3">
                                     <!-- Audit -->
                                     <div class="col-md-4 col-12">
                                         <button onclick="runQuickScript('bin/security_audit_cli.php')" class="btn btn-outline-info w-100 h-100 p-4 text-start hover-shadow position-relative" title="Esegui un'analisi completa di sicurezza (Permessi, DB, Config).">
                                            <span class="position-absolute top-0 end-0 p-3 opacity-50"><i class="fa-solid fa-user-secret fs-3"></i></span>
                                             <div class="fw-bold mb-2 fs-5">Security Audit</div>
                                             <small class="text-muted d-block lh-sm">Analisi permessi, config PHP e integrità database.</small>
                                         </button>
                                     </div>
                                     <!-- Cleanup -->
                                     <div class="col-md-4 col-12">
                                         <button onclick="runQuickScript('bin/cleanup_system.php')" class="btn btn-outline-warning w-100 h-100 p-4 text-start hover-shadow position-relative" title="Rimuove file temporanei, cache e sessioni scadute.">
                                            <span class="position-absolute top-0 end-0 p-3 opacity-50"><i class="fa-solid fa-broom fs-3"></i></span>
                                             <div class="fw-bold mb-2 fs-5">Cleanup</div>
                                             <small class="text-muted d-block lh-sm">Rimozione cache, sessioni scadute e temp.</small>
                                         </button>
                                     </div>
                                     <!-- Diagnostics -->
                                     <div class="col-md-4 col-12">
                                         <button onclick="runQuickScript('bin/check_system.php')" class="btn btn-outline-success w-100 h-100 p-4 text-start hover-shadow position-relative" title="Verifica la connettività di tutti i servizi critici.">
                                            <span class="position-absolute top-0 end-0 p-3 opacity-50"><i class="fa-solid fa-stethoscope fs-3"></i></span>
                                             <div class="fw-bold mb-2 fs-5">Diagnostica</div>
                                             <small class="text-muted d-block lh-sm">Test connettività completa servizi.</small>
                                         </button>
                                     </div>
                                 </div>
                             </div>
                        </div>
                    </div>
                    <!-- System Status Widget -->
                    <div class="col-xl-4 col-lg-12">
                         <div class="card bg-gradient-to-br from-green-900 to-black border-success border-opacity-25 h-100 glass-panel">
                             <div class="card-body text-center d-flex flex-column justify-content-center align-items-center p-5">
                                 <div class="spinner-grow text-success mb-4" role="status" style="width: 4rem; height: 4rem;">
                                     <span class="visually-hidden">Loading...</span>
                                 </div>
                                 <h4 class="text-success fw-bold uppercase-tracking mb-2 fs-4">SYSTEM OPERATIONAL</h4>
                                 <p class="text-success opacity-75 mb-0 px-4">Tutti i servizi critici attivi.</p>
                             </div>
                         </div>
                    </div>
                </div>

                <!-- RIGA 3: Server Environment Details (NEW) -->
                <!-- SECTION: ENVIRONMENT DETAILS -->
