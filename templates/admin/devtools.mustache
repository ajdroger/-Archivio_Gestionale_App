                              <input type="text" id="fs-path" class="form-control form-control-sm bg-transparent text-secondary border-0 font-monospace" value="/" readonly title="Percorso Corrente">
                          </div>
                          <div class="flex-grow-1 overflow-auto p-2 code-font small custom-scrollbar" id="fs-tree">
                              <!-- Tree popolato via JS -->
                          </div>
                      </div>

                       <!-- Pannello Editor (DX) -->
                      <div class="col-lg-9 bg-black d-flex flex-column position-relative">
                           <!-- Editor Toolbar -->
                           <div class="p-2 bg-dark border-bottom border-secondary border-opacity-25 d-flex justify-content-between align-items-center">
                               <span class="text-white small fw-bold font-monospace ps-2 d-flex align-items-center">
                                   <i class="fa-solid fa-file-code me-2 text-primary"></i> <span id="editor-filename">Nessun file selezionato</span>
                               </span>
                               <button class="btn btn-sm btn-success fw-bold px-3 d-flex align-items-center disabled" id="btn-fs-save" disabled>
                                   <i class="fa-solid fa-save me-2"></i>SALVA MODIFICHE
                               </button>
                           </div>
                           
                           <!-- Avviso Irreversibilità -->
                           <div class="alert alert-danger mb-0 rounded-0 py-1 px-3 small d-flex align-items-center bg-danger bg-opacity-10 border-bottom border-danger border-opacity-25" style="display: none;" id="editor-warning-bar">
                               <i class="fa-solid fa-triangle-exclamation me-2"></i>
                               <strong>ATTENZIONE:</strong> Le modifiche ai file sono <u>irreversibili</u> e vengono applicate immediatamente al filesystem. Procedere con cautela.
                           </div>
                           
                           <!-- Textarea Codice -->
                           <textarea id="code-editor" class="flex-grow-1 w-100 bg-black text-light p-3 code-font border-0" 
                                style="resize: none; outline: none; font-size: 0.9rem; line-height: 1.6; color: #d4d4d4;" 
                                spellcheck="false" disabled placeholder="Seleziona un file per iniziare l'editing..."></textarea>
                      </div>
                </div>
            </div>

        </div> <!-- Fine Tab Content -->

    </div> <!-- Fine Main Content Area -->
</div>

<!-- 
    ========================================
    TERMINAL DRAWER (Console Output)
    Cassetto a comparsa per log e output script.
    ========================================
-->
<div id="terminal-drawer" class="bg-black border-top border-secondary border-opacity-50 shadow-lg position-fixed bottom-0 z-index-1050" 
     style="height: 350px; display: none; left: 280px; width: calc(100% - 280px); transition: all 0.3s ease;">
     
     <div class="d-flex justify-content-between align-items-center px-3 py-2 bg-dark border-bottom border-secondary border-opacity-25">
         <div class="text-info fw-bold small"><i class="fa-solid fa-terminal me-2"></i>CONSOLE OUTPUT</div>
         <div>
             <button class="btn btn-sm text-muted hover-white me-1" onclick="document.getElementById('terminal-content').innerText='// Console Cleared.\n'" title="Pulisci">
                 <i class="fa-solid fa-eraser"></i>
             </button>
             <button class="btn btn-sm text-muted hover-white" onclick="toggleTerminal()" title="Chiudi">
                 <i class="fa-solid fa-times"></i>
             </button>
         </div>
     </div>
     <div id="terminal-content" class="p-3 code-font text-info small h-100 overflow-auto pb-5 bg-opacity-10" style="background: #050505;">
         // Console Ready. Waiting for commands...
     </div>
</div>

<!-- ######################################################################################## -->
<!-- LOGICA JAVASCRIPT APPLICATIVA -->
<!-- ######################################################################################## -->
<script>
    /* --- FUNZIONI DI UTILITÀ (Logging & API) --- */

    /**
     * Stampa un messaggio nella console (drawer) visuale.
     * @param {string} msg - Il messaggio da stampare.
     * @param {string} type - Tipo di messaggio: 'info', 'success', 'error', 'warning'.
     */
    const log = (msg, type='info') => {
        const term = document.getElementById('terminal-content');
        let colorClass = 'text-info';
        
        switch(type) {
            case 'error': colorClass = 'text-danger fw-bold'; break;
            case 'success': colorClass = 'text-success fw-bold'; break;
            case 'warning': colorClass = 'text-warning'; break;
        }

        const time = new Date().toLocaleTimeString();
        term.innerHTML += `<div class="${colorClass} mb-1 border-bottom border-secondary border-opacity-10 pb-1">
            <span class="opacity-50 text-secondary me-2">[${time}]</span><span style="white-space: pre-wrap;">${msg}</span>
        </div>`;
        
        // Auto-scroll in basso
        term.scrollTop = term.scrollHeight;

        // Se è un errore o successo importante, apri il terminale se chiuso
        if(type !== 'info') {
            const drawer = document.getElementById('terminal-drawer');
            if (drawer.style.display === 'none') drawer.style.display = 'block';
        }
    };

    /**
     * Wrapper asincrono per chiamate API interne al DevToolsController.
     * Gestisce automaticamente il CSRF token e la conversione JSON.
     * @param {string} endpoint - L'URL relativo dell'endpoint (es. '/devtools/run').
     * @param {object} data - Oggetto con i dati da inviare (POST).
     */
    const api = async (endpoint, data={}) => {
        // Inietta Token CSRF
        data.csrf_name = window.CSRF.name;
        data.csrf_value = window.CSRF.value;
        
        const formData = new URLSearchParams();
        Object.keys(data).forEach(k => formData.append(k, data[k]));

        try {
            const res = await fetch('/fratellanza-militare-archivio/public' + endpoint, { 
                method: 'POST', 
                body: formData,
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
            });
            
            const json = await res.json();
            
            if(!res.ok) throw new Error(json.error || 'Errore Server Sconosciuto');
            return json; // Ritorna il payload (es. {success: true, output: ...})
        } catch(e) {
            log(`API ERROR [${endpoint}]: ${e.message}`, 'error');
            throw e; // Rilancia per catch specifici
        }
    };

    /* --- GESTIONE UI --- */

    // Mostra/Nascondi il drawer del terminale
    function toggleTerminal() {
        const t = document.getElementById('terminal-drawer');
        t.style.display = t.style.display==='none' ? 'block' : 'none';
    }

    // Persistenza Tab attivo al refresh della pagina
    const urlParams = new URLSearchParams(window.location.search);
    const tab = urlParams.get('tab');
    if(tab) {
        const el = document.querySelector(`#v-pills-${tab}-tab`);
        if(el) {
            new bootstrap.Tab(el).show();
        }
    }

    /* --- AZIONI RAPIDE & SCRIPT --- */

    // Esegue uno script PHP lato server
    window.runQuickScript = (path) => {
        log(`>>> Avvio esecuzione script: ${path}...`, 'info');
        api('/devtools/run', {script: path}).then(d => {
            log('---------------- SCRIPT OUTPUT ----------------', 'warning');
            log(d.output || '(Nessun output testuale)');
            log('-----------------------------------------------', 'warning');
            log('Esecuzione completata con successo.', 'success');
        });
    };

    // Binding bottoni "Run" nella lista script
    document.querySelectorAll('.run-script-btn').forEach(btn => {
        btn.onclick = () => runQuickScript(btn.dataset.path);
    });

    /* --- GESTIONE UTENTI (SECURITY TAB) --- */
    
    // Carica la lista utenti via AJAX
    const loadUsers = () => {
        const b = document.getElementById('user-list-body');
        // Stato Loading
        b.innerHTML = '<tr><td colspan="4" class="text-center p-4 text-muted"><i class="fa-solid fa-circle-notch fa-spin me-2"></i>Aggiornamento lista...</td></tr>';
        
        api('/devtools/security/list').then(d => {
            b.innerHTML = '';
            if (d.users.length === 0) {
                 b.innerHTML = '<tr><td colspan="4" class="text-center">Nessun utente trovato.</td></tr>';
                 return;
            }
            d.users.forEach(u => {
                // Rendering riga tabella
                // FIX CONTRASTO: Badge solidi
                const roleBadge = u.role === 'admin' 
                    ? '<span class="badge bg-danger text-white border border-white border-opacity-25 shadow-sm">ADMIN</span>' 
                    : '<span class="badge bg-info text-dark border border-info border-opacity-25">USER</span>';
                
                const mfaStatus = u.has_2fa 
                    ? '<span class="badge bg-emerald-500 text-white bg-success"><i class="fa-solid fa-lock me-1"></i>ACTIVE</span>' 
                    : '<span class="badge bg-secondary text-light opacity-75"><i class="fa-solid fa-lock-open me-1"></i>DISABLED</span>';

                b.innerHTML += `
                <tr class="hover-row border-bottom border-secondary border-opacity-10 transition-colors">
                    <td class="ps-4 py-3 fw-bold font-monospace text-white">${u.username}</td>
                    <td>${roleBadge}</td>
                    <td>${mfaStatus}</td>
                    <td class="text-end pe-4">
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-light dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fa-solid fa-gear me-1"></i> GESTISCI
                            </button>
                            <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow-lg border-secondary">
                                <li><h6 class="dropdown-header text-muted small uppercase-tracking">Sicurezza</h6></li>
                                <li>
                                    <button class="dropdown-item text-warning" onclick="rotate2FA('${u.username}')">
                                        <i class="fa-solid fa-arrows-rotate me-2"></i>Ruota Secret 2FA
                                    </button>
                                </li>
                                <li>
                                    <button class="dropdown-item text-warning" onclick="resetUserPassword('${u.username}')">
                                        <i class="fa-solid fa-key me-2"></i>Reset Password
                                    </button>
                                </li>
                                <li><hr class="dropdown-divider border-secondary opacity-25"></li>
                                <li>
                                    <button class="dropdown-item text-danger" onclick="deleteUser('${u.username}')">
                                        <i class="fa-solid fa-trash me-2"></i>Elimina Utente
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </td>
                </tr>
                `;
            });
            log('Lista utenti aggiornata.', 'info');
        });
    };
    
    // Auto-caricamento quando si apre il tab Security
    document.getElementById('v-pills-security-tab').addEventListener('shown.bs.tab', loadUsers);

    // Form di creazione utente
    document.getElementById('form-add-user').onsubmit = (e) => {
        e.preventDefault();
        const fd = new FormData(e.target);
        api('/devtools/security/add', Object.fromEntries(fd)).then(() => {
            log(`Utente '${fd.get('username')}' creato con successo.`, 'success');
            e.target.reset();
            loadUsers(); // Refresh lista
        });
    };

    // Azioni individuali utente
    window.rotate2FA = (id) => confirm('Sei sicuro di voler resettare il segreto 2FA per questo utente? L\'utente dovrà scansionare un nuovo QR Code.') && 
        api('/devtools/security/rotate', {id}).then(() => log('Segreto 2FA rigenerato con successo (o rimosso).', 'success'));
    
    window.resetUser = (id) => {
        const p = prompt('Inserisci la nuova password per l\'utente:');
        if(p) api('/devtools/security/reset', {id, password: p}).then(() => log('Password utente aggiornata.', 'success'));
    };

    window.deleteUser = (id) => confirm('ATTENZIONE: Questa azione è irreversibile. Cancellare l\'utente?') && 
        api('/devtools/security/delete', {id}).then(() => { log('Utente eliminato definitivamente.', 'success'); loadUsers(); });


    /* --- TOOLS AGGIUNTIVI (Renamer, Trace, SQL) --- */

    // Rebranding Tool
    document.getElementById('btn-run-renamer').onclick = () => {
        const name = document.getElementById('renamer-new-name').value;
        const dry = document.getElementById('renamer-dry-run').checked;
        if(!name) return alert('Inserisci un nuovo nome progetto.');
        
        log(`>>> Avvio Rebranding su namespace '${name}' (DryRun: ${dry})...`, 'warning');
        api('/devtools/renamer', {new_name: name, dry_run: dry?'1':'0'}).then(d => {
             log(d.output);
             log('Rebranding task completato.', 'success');
        });
    };

    // Esecuzione Trace ID
    document.getElementById('btn-trace-logs').onclick = () => {
        const id = document.getElementById('trace-id-input').value;
        if(!id) return log('Inserisci un ID valido.', 'error');
        
        api('/devtools/trace', {requestId: id}).then(d => {
             if(d.logs.length) {
                 log(`Trovati ${d.logs.length} record di log per ID ${id}`, 'success');
                 d.logs.forEach(l => log(`[${l.level_name}] ${l.message}`));
             } else log('Nessuna traccia trovata per questo ID.', 'warning');
        });
    };

    // SQL Console Engine
    document.getElementById('btn-run-query').onclick = () => {
        const sql = document.getElementById('sql-input').value;
        if(!sql) return;
        
        log(`Esecuzione Query: ${sql}`, 'info');
        api('/devtools/db/query', {sql}).then(d => {
             const t = document.getElementById('sql-results');
             t.innerHTML = '';
             
             if(!d.results || d.results.length === 0) {
                 log('Query eseguita. Nessuna riga ritornata.', 'success');
                 return t.innerHTML = '<thead><tr><th>Nessun risultato (0 rows)</th></tr></thead>';
             }
             
             // Generazione dinamica header tabella
             let h = '<thead><tr>';
             Object.keys(d.results[0]).forEach(k => h+=`<th>${k}</th>`);
             h+='</tr></thead><tbody>';
             
             // Generazione righe
             d.results.forEach(r => {
                 h+='<tr>';
                 Object.values(r).forEach(v => h+=`<td>${v===null?'<span class="text-muted">NULL</span>':v}</td>`);
                 h+='</tr>';
             });
             h+='</tbody>';
             
             t.innerHTML = h;
             log(`Query OK. ${d.results.length} righe recuperate.`, 'success');
        });
    };


    /* --- FILESYSTEM BROWSER (Code Reactor) --- */

    /**
     * Carica il contenuto di una directory nel pannello laterale.
     * @param {string} path - Il percorso assoluto o relativo della cartella.
     */
    const loadDir = (path) => {
        const t = document.getElementById('fs-tree');
        t.innerHTML = '<div class="text-center p-3 opacity-50"><i class="fa-solid fa-spinner fa-spin"></i></div>';
        
        api('/devtools/fs/list', {path}).then(d => {
             document.getElementById('fs-path').value = d.current;
             t.innerHTML = '';
             
             // Tasto 'Torna su'
             if(d.current!=='/' && d.current!=='\\') {
                 const u = document.createElement('div');
                 u.className='p-1 pointer hover-text-white text-info mb-1';
                 u.innerHTML='<i class="fa-solid fa-turn-up me-2"></i> .. (Level Up)';
                 u.onclick=()=>loadDir(d.current+'/../');
                 t.appendChild(u);
             }
             
             // Rendering Items
             d.items.forEach(i => {
                 const el = document.createElement('div');
                 el.className='p-1 pointer text-nowrap d-flex align-items-center mb-1 ' + (i.type==='dir'?'text-warning':'text-muted');
                 // Icona diversa per folder/file
                 const icon = i.type==='dir' ? '<i class="fa-solid fa-folder me-2 text-warning opacity-75"></i>' : '<i class="fa-solid fa-file-code me-2 opacity-50"></i>';
                 
                 el.innerHTML=`${icon}<span>${i.name}</span>`;
                 
                 // Comportamento Click
                 el.onclick=()=>i.type==='dir' ? loadDir(i.path) : loadFile(i.path);
                 
                 // Hover effect js (opzionale, gestito da css)
                 el.onmouseenter = () => el.classList.add('text-white');
                 el.onmouseleave = () => el.classList.remove('text-white');
                 if(i.type==='dir') el.onmouseleave = () => el.classList.remove('text-white'); // keep warning color logic if needed

                 t.appendChild(el);
             });
        });
    };

    /**
     * Carica il contenuto di un file nell'editor.
     */
    const loadFile = (path) => {
        document.getElementById('editor-filename').innerText = path;
        api('/devtools/fs/read', {path}).then(d => {
            const ed = document.getElementById('code-editor');
            ed.value = d.content;
            ed.disabled = false;
            
            // Mostra avviso irreversibilità
            document.getElementById('editor-warning-bar').style.display = 'flex';
            
            // Abilita Salvataggio
            const btnSave = document.getElementById('btn-fs-save');
            btnSave.disabled = false;
            btnSave.classList.remove('disabled');
            
            btnSave.onclick = () => {
                if(confirm('ATTENZIONE: Stai per sovrascrivere permanentemente questo file.\nQuesta azione è IRREVERSIBILE e non può essere annullata.\n\nProcedere con il salvataggio?')) {
                    api('/devtools/fs/save', {path, content: ed.value}).then(()=>log(`File ${path} salvato.`, 'success'));
                }
            };
        });
    };

    // Refresh button filesystem
    document.getElementById('btn-fs-refresh').onclick = () => loadDir(document.getElementById('fs-path').value);
    
    // Inizializzazione: Carica root directory
    loadDir('/');

</script>

