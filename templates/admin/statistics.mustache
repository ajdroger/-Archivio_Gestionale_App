{{> layout_header }}

<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-end border-bottom border-secondary pb-4">
            <div>
                <h2 class="text-white fw-bold mb-0"><i class="fa-solid fa-chart-line me-3 text-primary"></i>REPORTING CENTER</h2>
                <p class="text-secondary mb-0 mt-2">Analisi strategica in tempo reale. Intelligence su anagrafica e finanze.</p>
            </div>
            <div class="text-end">
                <span id="live-indicator" class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 font-monospace me-2 animate-pulse">
                    <i class="fa-solid fa-signal me-2"></i>LIVE
                </span>
                <span class="badge bg-dark text-secondary border border-secondary px-3 py-2 font-monospace">
                    <i class="fa-solid fa-clock-rotate-left me-2"></i>REF: <span id="data-ref">{{stats.data_riferimento}}</span>
                </span>
            </div>
        </div>
    </div>
</div>

<!-- System Monitoring Grid -->
<div class="row g-4 mb-5">
    <div class="col-md-3">
        <div class="card h-100 bg-dark border-secondary shadow-lg">
            <div class="card-body text-center p-4">
                <div class="fs-1 text-primary mb-3">
                    <i class="fa-solid fa-database"></i>
                </div>
                <h6 class="text-secondary small fw-bold text-uppercase mb-2">Integrità DB</h6>
                <div id="mon-db">
                    {{#monitoring.database.status}}
                    <span class="badge bg-success-subtle text-success border border-success border-opacity-25">OPERATIVO</span>
                    {{/monitoring.database.status}}
                    {{^monitoring.database.status}}
                    <span class="badge bg-danger-subtle text-danger border border-danger border-opacity-25">ERRORE</span>
                    {{/monitoring.database.status}}
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100 bg-dark border-secondary shadow-lg">
            <div class="card-body text-center p-4">
                <div class="fs-1 text-success mb-3">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <h6 class="text-secondary small fw-bold text-uppercase mb-2">Storage Salute</h6>
                <div id="mon-storage">
                    {{#health.checks.storage.status}}
                    <span class="badge bg-success-subtle text-success border border-success border-opacity-25">{{health.checks.storage.message}}</span>
                    {{/health.checks.storage.status}}
                </div>
                <small class="text-white-50 d-block mt-2 font-monospace" style="font-size:0.6rem">{{health.checks.storage.free_space}} LIBERI</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100 bg-dark border-secondary shadow-lg">
            <div class="card-body text-center p-4">
                <div class="fs-1 text-info mb-3">
                    <i class="fa-solid fa-cloud-arrow-up"></i>
                </div>
                <h6 class="text-secondary small fw-bold text-uppercase mb-2">Backups (24h)</h6>
                <div id="mon-backups">
                    {{#monitoring.backups.status}}
                    <span class="badge bg-success-subtle text-success border border-success border-opacity-25">{{monitoring.backups.count}} BACKUPS</span>
                    {{/monitoring.backups.status}}
                    {{^monitoring.backups.status}}
                    <span class="badge bg-warning-subtle text-warning border border-warning border-opacity-25">ALERT: {{monitoring.backups.message}}</span>
                    {{/monitoring.backups.status}}
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100 bg-dark border-secondary shadow-lg">
            <div class="card-body text-center p-4">
                <div class="fs-1 text-warning mb-3">
                    <i class="fa-solid fa-server"></i>
                </div>
                <h6 class="text-secondary small fw-bold text-uppercase mb-2">Server Uptime</h6>
                <div id="mon-uptime">
                    <span class="badge bg-dark text-white border border-secondary">{{health.uptime}}</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Section -->
<div class="row g-4 mb-5">
    <!-- Membership Health Chart -->
    <div class="col-md-6 col-xl-4">
        <div class="card h-100 bg-dark border-secondary shadow-lg">
            <div class="card-header border-secondary bg-transparent py-3">
                <h6 class="text-white mb-0 fw-bold"><i class="fa-solid fa-chart-pie me-2 text-info"></i>STATO SOCI</h6>
            </div>
            <div class="card-body d-flex flex-column align-items-center justify-content-center">
                <div style="height: 250px; width: 100%;">
                    <canvas id="chartStatus"></canvas>
                </div>
                <div class="mt-3 text-center">
                    <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 me-2">ATTIVI: {{stats.attivi}}</span>
                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25">TOTALE: {{stats.totale}}</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Financial Health Chart -->
    <div class="col-md-6 col-xl-4">
        <div class="card h-100 bg-dark border-secondary shadow-lg">
            <div class="card-header border-secondary bg-transparent py-3">
                <h6 class="text-white mb-0 fw-bold"><i class="fa-solid fa-chart-pie me-2 text-success"></i>SALUTE FINANZIARIA</h6>
            </div>
            <div class="card-body d-flex flex-column align-items-center justify-content-center">
                <div style="height: 250px; width: 100%;">
                    <canvas id="chartFinancial"></canvas>
                </div>
                <div class="mt-3 text-center">
                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 me-2">IN REGOLA: {{stats.paganti}}</span>
                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">MOROSI: {{stats.morosi}}</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Metrics -->
    <div class="col-md-12 col-xl-4">
        <div class="row g-3 h-100">
            <div class="col-12">
                <div class="card h-100 bg-dark border-secondary shadow-lg p-3 d-flex align-items-center flex-row">
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3 me-3 fs-3">
                        <i class="fa-solid fa-users"></i>
                    </div>
                    <div>
                        <h3 class="text-white fw-bold mb-0">{{stats.totale}}</h3>
                        <div class="text-secondary small text-uppercase fw-bold">Soci Totali</div>
                    </div>
                </div>
            </div>
            <div class="col-6">
                <div class="card h-100 bg-dark border-secondary shadow-lg p-3 text-center" title="Percentuale di soci in regola con i pagamenti per l'anno corrente">
                    <h4 class="text-success fw-bold mb-0">{{stats.perc_paganti}}%</h4>
                    <div class="text-secondary small fw-bold">PAGANTI REGOLARI</div>
                    <div class="text-white-50" style="font-size: 0.7rem;">Compliance Aziendale</div>
                </div>
            </div>
            <div class="col-6">
                <div class="card h-100 bg-dark border-secondary shadow-lg p-3 text-center" title="Percentuale di soci con irregolarità amministrative">
                    <h4 class="text-danger fw-bold mb-0">{{stats.perc_morosi}}%</h4>
                    <div class="text-secondary small fw-bold">MOROSITÀ</div>
                    <div class="text-white-50" style="font-size: 0.7rem;">Indice di Rischio</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Detailed Data Analysis -->
<div class="row g-4 mb-5">
    <div class="col-12">
        <div class="card bg-dark border-secondary shadow-lg">
            <div class="card-header border-secondary bg-transparent py-3 d-flex justify-content-between align-items-center">
                 <h5 class="text-white mb-0 fw-bold"><i class="fa-solid fa-table-list me-2 text-warning"></i>ANALISI DETTAGLIATA</h5>
                 
                 <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                        <i class="fa-solid fa-download me-2"></i>Export
                    </button>
                    <ul class="dropdown-menu dropdown-menu-dark border-secondary shadow">
                        <li><a class="dropdown-item" href="{{base_url}}/statistiche/export/pdf?type=soci&status={{filters.status}}&payment_status={{filters.payment_status}}"><i class="fa-solid fa-file-pdf me-2 text-danger"></i>Report PDF</a></li>
                        <li><a class="dropdown-item" href="{{base_url}}/statistiche/export/excel?type=soci&status={{filters.status}}&payment_status={{filters.payment_status}}"><i class="fa-solid fa-file-csv me-2 text-success"></i>Export Excel</a></li>
                    </ul>
                </div>
            </div>
            <div class="card-body p-4">
                
                <!-- Filters -->
                <form action="" method="GET" class="row g-3 mb-4 bg-black bg-opacity-25 p-3 rounded border border-secondary align-items-end">
                    <div class="col-md-3">
                        <label class="form-label text-secondary small text-uppercase fw-bold">Stato Iscrizione</label>
                        <select name="status" class="form-select form-select-sm bg-dark text-white border-secondary">
                            <option value="">Tutti gli stati</option>
                            <option value="ATTIVO" {{#filters.status}}selected{{/filters.status}}>ATTIVO</option>
                            <option value="SOSPESO" {{#filters.status}}selected{{/filters.status}}>SOSPESO</option>
                            <option value="RADIATO" {{#filters.status}}selected{{/filters.status}}>RADIATO</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-secondary small text-uppercase fw-bold">Situazione Contabile</label>
                        <select name="payment_status" class="form-select form-select-sm bg-dark text-white border-secondary">
                            <option value="">Tutte le posizioni</option>
                            <option value="in_regola">In Regola</option>
                            <option value="moroso">Moroso</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                         <button type="submit" class="btn btn-sm btn-primary w-100 fw-bold"><i class="fa-solid fa-filter me-2"></i>APPLICA</button>
                    </div>
                    <div class="col-md-4 text-end">
                        <small class="text-secondary fst-italic">Risultati filtrati: <strong>{{filtered_count}}</strong></small>
                    </div>
                </form>

                <div class="table-responsive">
                    <table class="table table-dark table-hover table-striped align-middle bg-transparent statistics-table" style="width:100%">
                        <thead class="text-secondary small text-uppercase">
                            <tr>
                                <th title="Nome completo del socio">Socio</th>
                                <th title="Numero di matricola univoco">Matricola</th>
                                <th title="Stato attuale dell'iscrizione (Attivo, Sospeso, ecc)">Stato</th>
                                <th title="Stato dei pagamenti per l'anno corrente">Posizione</th>
                                <th class="text-end">Azioni</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#filtered_soci}}
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle bg-primary bg-opacity-25 text-primary me-3 fw-bold rounded-circle d-flex justify-content-center align-items-center" style="width:35px; height:35px;">
                                            {{DatiPersonali.Nome.0}}
                                        </div>
                                        <div>
                                            <div class="fw-bold text-white">{{DatiPersonali.Cognome}} {{DatiPersonali.Nome}}</div>
                                            <div class="small text-secondary">{{DatiPersonali.Email}}</div>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="font-monospace text-info">{{Matricola}}</span></td>
                                <td>
                                    {{#Stato.isActive}}
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">ATTIVO</span>
                                    {{/Stato.isActive}}
                                    {{^Stato.isActive}}
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25">{{Stato.name}}</span>
                                    {{/Stato.isActive}}
                                </td>
                                <td>
                                    {{#verificaMorosita}}
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25"><i class="fa-solid fa-circle-exclamation me-1"></i>MOROSO</span>
                                    {{/verificaMorosita}}
                                    {{^verificaMorosita}}
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25"><i class="fa-solid fa-check me-1"></i>IN REGOLA</span>
                                    {{/verificaMorosita}}
                                </td>
                                <td class="text-end">
                                    <a href="{{base_url}}/soci/{{CodiceFiscale}}" class="btn btn-sm btn-outline-light border-secondary text-secondary hover-white" title="Scheda"><i class="fa-solid fa-eye"></i></a>
                                </td>
                            </tr>
                            {{/filtered_soci}}
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- Scripts for Charts & DataTables -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    @keyframes pulse {
        0% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.5; transform: scale(0.95); }
        100% { opacity: 1; transform: scale(1); }
    }
    .animate-pulse {
        animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // --- 1. init DataTables ---
        const table = $('.statistics-table').DataTable({
            "paging": true,
            "pageLength": 10,
            "lengthChange": false, 
            "searching": true,
            "info": true,
            "autoWidth": false,
            "responsive": true,
            "language": {
                "search": "",
                "searchPlaceholder": "Cerca nella lista...",
                "paginate": { "previous": "<", "next": ">" },
                "info": "_START_-_END_ di _TOTAL_"
            },
            "dom": '<"d-flex justify-content-between mb-2"f>t<"d-flex justify-content-between mt-3"ip>',
            "initComplete": function() {
                $('.dataTables_filter input').addClass('form-control form-control-sm bg-dark text-white border-secondary');
            }
        });

        // --- 2. init Charts ---
        Chart.defaults.color = '#94a3b8';
        Chart.defaults.borderColor = '#334155';

        const chartStatus = new Chart(document.getElementById('chartStatus'), {
            type: 'doughnut',
            data: {
                labels: ['Attivi', 'Altri'],
                datasets: [{
                    data: [{{stats.attivi}}, {{stats.totale}} - {{stats.attivi}}],
                    backgroundColor: ['#0ea5e9', '#475569'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom', labels: { usePointStyle: true } } },
                cutout: '70%'
            }
        });

        const chartFinancial = new Chart(document.getElementById('chartFinancial'), {
            type: 'doughnut',
            data: {
                labels: ['In Regola', 'Morosi'],
                datasets: [{
                    data: [{{stats.paganti}}, {{stats.morosi}}],
                    backgroundColor: ['#22c55e', '#ef4444'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom', labels: { usePointStyle: true } } },
                cutout: '70%'
            }
        });

        // --- 3. Real-time Engine ---
        function updateUI(data) {
            // Update Headers
            document.getElementById('data-ref').textContent = data.stats.data_riferimento;
            
            // Update KPI Cards
            document.querySelector('.col-12 h3.text-white').textContent = data.stats.totale;
            document.querySelector('.col-6:nth-child(2) h4').textContent = data.stats.perc_paganti + '%';
            document.querySelector('.col-6:nth-child(3) h4').textContent = data.stats.perc_morosi + '%';

            // Update Badges in Chart sections
            document.querySelector('.badge.bg-info').textContent = 'ATTIVI: ' + data.stats.attivi;
            document.querySelector('.badge.bg-secondary').textContent = 'TOTALE: ' + data.stats.totale;
            document.querySelector('.badge.bg-success').textContent = 'IN REGOLA: ' + data.stats.paganti;
            document.querySelector('.badge.bg-danger').textContent = 'MOROSI: ' + data.stats.morosi;

            // Update Charts
            chartStatus.data.datasets[0].data = [data.stats.attivi, data.stats.totale - data.stats.attivi];
            chartStatus.update();

            chartFinancial.data.datasets[0].data = [data.stats.paganti, data.stats.morosi];
            chartFinancial.update();

            // Update Monitoring
            const dbStatus = data.monitoring.database.status ? 
                '<span class="badge bg-success-subtle text-success border border-success border-opacity-25">OPERATIVO</span>' :
                '<span class="badge bg-danger-subtle text-danger border border-danger border-opacity-25">ERRORE</span>';
            document.getElementById('mon-db').innerHTML = dbStatus;

            const storageStatus = '<span class="badge bg-success-subtle text-success border border-success border-opacity-25">' + data.health.checks.storage.message + '</span>';
            document.getElementById('mon-storage').innerHTML = storageStatus;
            document.querySelector('#mon-storage + small').textContent = data.health.checks.storage.free_space + ' LIBERI';

            const backupStatus = data.monitoring.backups.status ?
                '<span class="badge bg-success-subtle text-success border border-success border-opacity-25">' + data.monitoring.backups.count + ' BACKUPS</span>' :
                '<span class="badge bg-warning-subtle text-warning border border-warning border-opacity-25">ALERT</span>';
            document.getElementById('mon-backups').innerHTML = backupStatus;

            document.getElementById('mon-uptime').innerHTML = '<span class="badge bg-dark text-white border border-secondary">' + data.health.uptime + '</span>';
        }

        async function fetchRealTime() {
            try {
                const indicator = document.getElementById('live-indicator');
                indicator.classList.replace('text-success', 'text-warning');
                
                const response = await fetch('?action=api');
                const data = await response.json();
                
                updateUI(data);
                
                indicator.classList.replace('text-warning', 'text-success');
            } catch (error) {
                console.error('Real-time update failed:', error);
                document.getElementById('live-indicator').classList.replace('text-success', 'text-danger');
            }
        }

        // Poll every 10 seconds
        setInterval(fetchRealTime, 10000);
    });
</script>

{{> layout_footer }}

