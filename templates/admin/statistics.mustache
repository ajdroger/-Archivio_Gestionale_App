{{> layout_header }}

<!-- VIEW MODE TOGGLES (Only for Real Admins) -->
{{#real_is_admin}}
<div class="d-flex justify-content-end mb-4 gap-2">
    <a href="?view=admin" class="btn btn-sm {{^is_admin}}btn-outline-secondary{{/is_admin}}{{#is_admin}}btn-primary{{/is_admin}} fw-bold rounded-pill px-3">
        <i class="fa-solid fa-gauge-high me-2"></i>Mission Control
    </a>
    <a href="?view=user" class="btn btn-sm {{#is_admin}}btn-outline-secondary{{/is_admin}}{{^is_admin}}btn-primary{{/is_admin}} fw-bold rounded-pill px-3">
        <i class="fa-solid fa-user me-2"></i>Vista Utente
    </a>
</div>
{{/real_is_admin}}

<div class="container-fluid px-4">
    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="display-5 fw-bold text-white mb-0">
                {{#is_admin}}Financial Intelligence{{/is_admin}}
                {{^is_admin}}Trasparenza Comunità{{/is_admin}}
            </h1>
            <p class="text-secondary lead mb-0">
                {{#is_admin}}Analisi predittiva e monitoraggio asset{{/is_admin}}
                {{^is_admin}}Statistiche pubbliche dell'associazione{{/is_admin}}
            </p>
        </div>
        {{#is_admin}}
        <div class="d-flex gap-2">
            <button class="btn btn-outline-info rounded-pill"><i class="fa-solid fa-download me-2"></i>Export Report</button>
            <button class="btn btn-outline-light rounded-pill"><i class="fa-solid fa-print me-2"></i>Print</button>
        </div>
        {{/is_admin}}
    </div>

    <!-- ADMIN VIEW: HIGH LEVEL METRICS -->
    {{#is_admin}}
    <div class="row g-4 mb-5">
         <!-- Asset Value -->
        <div class="col-md-4">
            <div class="card border-0 shadow-lg h-100" style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.1), rgba(6, 78, 59, 0.4)); border: 1px solid rgba(16, 185, 129, 0.2) !important;">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-secondary fw-bold mb-3"><i class="fa-solid fa-vault me-2 text-success"></i>Valore Asset Stimato</h6>
                    <h2 class="display-4 fw-bold text-white mb-0">{{financials.asset_value}}</h2>
                    <small class="text-success"><i class="fa-solid fa-arrow-trend-up me-1"></i>{{financials.growth_rate}} vs Last Year</small>
                </div>
            </div>
        </div>
        <!-- Projected Revenue -->
        <div class="col-md-4">
             <div class="card border-0 shadow-lg h-100" style="background: linear-gradient(135deg, rgba(59, 130, 246, 0.1), rgba(30, 58, 138, 0.4)); border: 1px solid rgba(59, 130, 246, 0.2) !important;">
                <div class="card-body p-4">
                    <h6 class="text-uppercase text-secondary fw-bold mb-3"><i class="fa-solid fa-coins me-2 text-primary"></i>Revenue Proiettata (2026)</h6>
                    <h2 class="display-4 fw-bold text-white mb-0">{{financials.projected_revenue}}</h2>
                    <small class="text-primary">Basato su {{stats.attivi}} soci attivi</small>
                </div>
            </div>
        </div>
        <!-- System Health Small -->
        <div class="col-md-4">
             <div class="card border-0 shadow-lg h-100" style="background: #0f172a; border: 1px solid rgba(255,255,255,0.05) !important;">
                <div class="card-body p-4 d-flex flex-column justify-content-center">
                    <div class="d-flex justify-content-between mb-3">
                         <span class="text-secondary">System Pulse</span>
                         <span class="text-success fw-bold">OPTIMAL</span>
                    </div>
                    <div class="progress" style="height: 4px;">
                        <div class="progress-bar bg-success" style="width: 98%"></div>
                    </div>
                    <div class="mt-4 d-flex justify-content-between text-secondary small">
                        <span>DB Latency: <span class="text-white">12ms</span></span>
                        <span>Redis: <span class="text-white">Connected</span></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- CHARTS SECTION -->
    <div class="row g-4 mb-5">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg bg-dark text-white h-100">
                <div class="card-header bg-transparent border-0 pt-4 px-4">
                    <h5 class="fw-bold mb-0">Trend Iscrizioni & Proiezioni</h5>
                </div>
                <div class="card-body">
                    <canvas id="adminTrendChart" height="300"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
             <div class="card border-0 shadow-lg bg-dark text-white h-100">
                 <div class="card-header bg-transparent border-0 pt-4 px-4">
                    <h5 class="fw-bold mb-0">Composizione Demografica</h5>
                </div>
                <div class="card-body d-flex align-items-center justify-content-center">
                    <canvas id="adminDemoChart" height="250"></canvas>
                </div>
             </div>
        </div>
    </div>
    {{/is_admin}}

    <!-- USER VIEW: COMMUNITY STATS -->
    {{^is_admin}}
    <div class="row g-4 justify-content-center">
        <div class="col-md-6 col-xl-4">
            <div class="card border-0 shadow bg-dark text-white text-center p-5">
                <div class="mb-3">
                    <i class="fa-solid fa-users fa-3x text-primary"></i>
                </div>
                <h2 class="display-3 fw-bold mb-2">{{stats.totale}}</h2>
                <p class="text-secondary text-uppercase tracking-wider">Membri della Comunità</p>
            </div>
        </div>
         <div class="col-md-6 col-xl-4">
            <div class="card border-0 shadow bg-dark text-white text-center p-5">
                <div class="mb-3">
                    <i class="fa-solid fa-handshake fa-3x text-success"></i>
                </div>
                <h2 class="display-3 fw-bold mb-2">{{stats.attivi}}</h2>
                <p class="text-secondary text-uppercase tracking-wider">Soci Sostenitori Attivi</p>
            </div>
        </div>
    </div>
    <div class="row mt-5">
        <div class="col-8 mx-auto text-center">
            <p class="lead text-secondary">
                "La trasparenza è il fondamento della nostra associazione. Questi dati sono aggiornati in tempo reale per garantire la massima chiarezza verso tutti i nostri associati."
            </p>
             <div class="mt-4">
                <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-3 py-2">
                    <i class="fa-solid fa-server me-2"></i>Dati certificati dal sistema MCAG
                </span>
            </div>
        </div>
    </div>
    {{/is_admin}}

</div>

{{> layout_footer }}

<!-- Chart.js (Required for Admin View) -->
{{#is_admin}}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="{{base_url}}/js/pages/statistics.js"></script>
{{/is_admin}}
