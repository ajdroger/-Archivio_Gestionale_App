<style>
/* HOLOGRAPHIC OVERLAY */
.holographic-overlay {
    position: fixed; top: 0; left: 0; w-100; h-100;
    background: linear-gradient(180deg, rgba(0,0,0,0) 50%, rgba(56, 189, 248, 0.03) 50%), linear-gradient(90deg, rgba(255,0,0,0.03), rgba(0,255,0,0.01), rgba(0,0,255,0.03));
    background-size: 100% 2px, 3px 100%;
    pointer-events: none; z-index: 9000;
}

/* BLUR BACKDROP */
.backdrop-blur { backdrop-filter: blur(10px); }

/* NEURAL SCANLINE */
.neural-scanline {
    position: absolute; top: 0; left: 0; width: 100%; height: 5px;
    background: rgba(56, 189, 248, 0.5);
    box-shadow: 0 0 10px rgba(56, 189, 248, 0.8);
    opacity: 0.5;
    animation: scanline 3s linear infinite;
    pointer-events: none;
}
@keyframes scanline { 0% { top: 0%; } 100% { top: 100%; } }

/* TICKER ANIMATION */
.ticker-wrap { width: 100%; overflow: hidden; background-color: transparent; }
.ticker { display: inline-block; white-space: nowrap; animation: ticker 30s linear infinite; }
.ticker__item { display: inline-block; padding: 0 2rem; font-family: 'Consolas', monospace; }
@keyframes ticker { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

/* HOVER EFFECTS */
.hover-scale:hover { transform: scale(1.02); transition: transform 0.2s; box-shadow: 0 10px 20px rgba(0,0,0,0.5); }
.hover-border-primary:hover { border-color: var(--bs-primary) !important; background: rgba(13, 110, 253, 0.1); }
.hover-border-info:hover { border-color: var(--bs-info) !important; background: rgba(13, 202, 240, 0.1); }
.hover-border-danger:hover { border-color: var(--bs-danger) !important; background: rgba(220, 53, 69, 0.1); }
