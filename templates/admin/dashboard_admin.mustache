<!-- RESTORED INTERACTIVE WORKSPACE (Refitted for Holographic UI) -->
{{#is_admin}}
<div class="row g-4 mb-4">
    <!-- 1. SWITCHBOARD - SYSTEM OPERATIONS -->
    <div class="col-12 col-xl-4">
        <div class="card h-100 border-0 shadow-lg position-relative overflow-hidden" style="background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(10px); border: 1px solid rgba(56, 189, 248, 0.1) !important;">
            <div class="card-header bg-transparent border-0 pt-4 px-4">
                <h6 class="text-uppercase fw-bold text-info mb-0 tracking-widest"><i class="fa-solid fa-sliders me-2"></i>Switchboard</h6>
            </div>
