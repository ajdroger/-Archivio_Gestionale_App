                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <div class="fw-bold text-white small">Global Maintenance</div>
                        <small class="text-secondary x-small">Lockdown Mode</small>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input dashboard-toggle shadow-none bg-dark border-secondary" type="checkbox" role="switch" id="toggleMaintenance" data-setting="maintenance" {{#app_config.maintenance}}checked{{/app_config.maintenance}}>
                    </div>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                         <div class="fw-bold text-white small">New Registrations</div>
