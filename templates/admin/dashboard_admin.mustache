{{> layout_header }}

<!-- GENIUS MODE DASHBOARD (v6.0 PREVIEW) -->
<!-- Global Container for Holographic Effect -->
<div class="holographic-overlay"></div>

<!-- TOP BAR: DEFCON & STATUS -->
<div class="d-flex justify-content-between align-items-center mb-4 p-3 bg-black bg-opacity-50 border-bottom border-secondary border-opacity-50 rounded shadow-lg backdrop-blur">
    <div class="d-flex align-items-center gap-4">
        <!-- DEFCON SELECTOR -->
        <div class="defcon-selector d-flex align-items-center gap-2">
            <span class="text-secondary small fw-bold tracking-widest">DEFCON</span>
            <div class="btn-group btn-group-sm" role="group">
                <button type="button" class="btn btn-outline-danger {{#defcon_level_1}}active{{/defcon_level_1}} fw-bold">1</button>
                <button type="button" class="btn btn-outline-warning {{#defcon_level_2}}active{{/defcon_level_2}} fw-bold">2</button>
                <button type="button" class="btn btn-outline-warning {{#defcon_level_3}}active{{/defcon_level_3}} fw-bold">3</button>
                <button type="button" class="btn btn-outline-success {{#defcon_level_4}}active{{/defcon_level_4}} fw-bold">4</button>
                <button type="button" class="btn btn-primary fw-bold active shadow-primary">5</button>
            </div>
        </div>
        
        <!-- WEATHER / TIME -->
        <div class="text-white small font-monospace">
            <i class="fa-solid fa-cloud-moon me-2 text-info"></i> MILANO: 12°C | {{current_date}} <span id="clock-live">12:00:00</span>
        </div>
    </div>
    
    <div class="d-flex align-items-center gap-3">
        <a href="?view=user" class="btn btn-outline-secondary btn-sm rounded-pill px-3"><i class="fa-solid fa-user me-2"></i>User View</a>
        <div class="d-flex align-items-center text-success small fw-bold animate-pulse">
            <i class="fa-solid fa-satellite-dish me-2"></i>UPLINK STABLE
        </div>
        <div class="d-flex align-items-center text-info small fw-bold ms-3" title="Zucchetti ERP Connected">
            <i class="fa-solid fa-link me-2"></i>ERP ONLINE
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- COL 1: THREAT INTELLIGENCE (MAP) -->
    <div class="col-lg-8">
        <div class="card h-100 border-0 shadow-lg bg-dark overflow-hidden position-relative">
            <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center pt-3 px-4">
                <h6 class="text-uppercase text-secondary fw-bold tracking-widest mb-0"><i class="fa-solid fa-globe me-2 text-primary"></i>Global Threat Vector</h6>
                <span class="badge bg-transparent text-danger border border-danger border-opacity-25 rounded-pill animate-pulse">LIVE FEED</span>
            </div>
            <div class="card-body p-0 position-relative" style="min-height: 400px; background: radial-gradient(circle at center, #1e293b 0%, #0f172a 100%);">
                <!-- GEO MAP PLACEHOLDER (Canvas would go here) -->
                <div id="threat-map-canvas" class="w-100 h-100 position-absolute top-0 start-0 opacity-50" style="background-image: url('https://upload.wikimedia.org/wikipedia/commons/e/ec/World_map_blank_without_borders.svg'); background-size: cover; background-position: center; filter: invert(1) opacity(0.2);"></div>
                
                <!-- THREAT BLIPS (Dynamic JS) -->
                <div id="threat-container">
                    <!-- Injected via JS -->
                </div>
                
                <!-- OVERLAY METRICS -->
                <div class="position-absolute bottom-0 start-0 p-3">
                    <div class="bg-black bg-opacity-75 p-2 rounded border border-secondary border-opacity-25 text-white x-small font-monospace">
                        <div class="mb-1"><span class="text-secondary">PACKETS:</span> <span class="text-success">24.5 TB/s</span></div>
                        <div><span class="text-secondary">LATENCY:</span> <span class="text-info">12ms</span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- COL 2: NEURAL UPLINK & METRICS -->
    <div class="col-lg-4">
        <div class="d-flex flex-column gap-4 h-100">
            <!-- NEURAL LOGS -->
            <div class="card border-0 shadow-lg bg-black font-monospace small" style="flex: 1; border: 1px solid rgba(56, 189, 248, 0.2) !important;">
                <div class="card-header bg-transparent border-0 pt-3 px-3">
                     <h6 class="text-uppercase text-info fw-bold tracking-widest mb-0 opacity-75"><i class="fa-solid fa-brain me-2"></i>Neural Uplink</h6>
                </div>
                <div class="card-body p-3 overflow-hidden position-relative">
                    <div class="neural-scanline"></div>
                    <div id="neural-log-container" class="d-flex flex-column gap-1" style="height: 250px; overflow-hidden; mask-image: linear-gradient(to bottom, transparent, black 10%, black 90%, transparent);">
                        {{#neural_logs}}
                        <div class="d-flex gap-2 opacity-75">
                            <span class="text-secondary">[{{time}}]</span>
                            <span class="text-warning">[{{module}}]</span>
                            <span class="text-light">{{msg}}</span>
                        </div>
                        {{/neural_logs}}
                    </div>
                </div>
            </div>

            <!-- KEY METRICS GRID -->
            <div class="row g-2">
                <div class="col-6">
                    <div class="card bg-dark border-0 p-3 text-center h-100 shadow-sm hover-scale">
                        <small class="text-secondary text-uppercase x-small fw-bold">Soci Attivi</small>
                        <h3 class="text-white fw-bold mb-0 mt-1">{{stats.active}}</h3>
                        <small class="text-success x-small"><i class="fa-solid fa-user-check me-1"></i>Confirm</small>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card bg-dark border-0 p-3 text-center h-100 shadow-sm hover-scale">
                        <small class="text-secondary text-uppercase x-small fw-bold">Valore Asset</small>
                        <h3 class="text-info fw-bold mb-0 mt-1">€1.08M</h3>
                        <small class="text-success x-small"><i class="fa-solid fa-certificate me-1"></i>Certified</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

</div>

