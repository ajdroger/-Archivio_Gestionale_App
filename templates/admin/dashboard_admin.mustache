                    <div class="form-check form-switch">
                        <input class="form-check-input dashboard-toggle shadow-none bg-dark border-secondary" type="checkbox" role="switch" id="toggleRegistrations" data-setting="registrations" {{#app_config.registrations}}checked{{/app_config.registrations}}>
                    </div>
                </div>
                 <div class="d-flex justify-content-between align-items-center">
                    <div>
                         <div class="fw-bold text-white small">Strict 2FA</div>
                        <small class="text-secondary x-small">Force OTP</small>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input dashboard-toggle shadow-none bg-dark border-secondary" type="checkbox" role="switch" id="toggle2FA" data-setting="strict_2fa" {{#app_config.strict_2fa}}checked{{/app_config.strict_2fa}}>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. WORKFLOW INBOX -->
    <div class="col-12 col-xl-4">
        <div class="card h-100 border-0 shadow-lg position-relative overflow-hidden" style="background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(10px); border: 1px solid rgba(16, 185, 129, 0.1) !important;">
             <div class="card-header bg-transparent border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                <h6 class="text-uppercase fw-bold text-success mb-0 tracking-widest"><i class="fa-solid fa-inbox me-2"></i>Inbox</h6>
                <span class="badge bg-transparent text-danger border border-danger border-opacity-25 rounded-pill x-small">3 Pending</span>
            </div>
            <div class="list-group list-group-flush bg-transparent mt-2">
                <!-- Item 1 -->
                <div class="list-group-item bg-transparent border-bottom border-secondary border-opacity-10 px-4 py-3">
                    <div class="d-flex justify-content-between align-items-start mb-1">
                        <small class="text-warning fw-bold x-small">ACCESS REQUEST</small>
                        <small class="text-secondary x-small font-monospace">14:02</small>
                    </div>
                    <p class="text-white small mb-2 text-opacity-75">Utente <strong>M.Rossi</strong> richiede reset password.</p>
                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-success bg-opacity-10 text-success border border-success border-opacity-25 flex-grow-1 py-0 x-small fw-bold">APPROVE</button>
                        <button class="btn btn-sm btn-outline-secondary py-0 x-small"><i class="fa-solid fa-xmark"></i></button>
                    </div>
                </div>
                <!-- Item 2 -->
                <div class="list-group-item bg-transparent border-0 px-4 py-3">
                     <div class="d-flex justify-content-between align-items-start mb-1">
