{{> layout_header }}

<!-- VIEW MODE TOGGLES (Only for Real Admins) -->
{{#real_is_admin}}
<div class="d-flex justify-content-end mb-3 gap-2">
    <a href="?view=admin" class="btn btn-sm {{^is_admin}}btn-outline-secondary{{/is_admin}}{{#is_admin}}btn-primary{{/is_admin}} fw-bold rounded-pill px-3">
        <i class="fa-solid fa-gauge-high me-2"></i>Mission Control
    </a>
    <a href="?view=user" class="btn btn-sm {{#is_admin}}btn-outline-secondary{{/is_admin}}{{^is_admin}}btn-primary{{/is_admin}} fw-bold rounded-pill px-3">
        <i class="fa-solid fa-user me-2"></i>Vista Utente
    </a>
</div>
{{/real_is_admin}}

<div class="row mb-5">
    <div class="col-12">
        <div class="card border-0 shadow-lg overflow-hidden" style="background: linear-gradient(135deg, rgba(56, 189, 248, 0.1), rgba(30, 41, 59, 0.8)); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.05) !important;">
            <div class="card-body p-4 p-md-5 d-flex align-items-center">
                <div class="flex-shrink-0 d-none d-md-block me-4">
                    <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                        <i class="fa-solid fa-user-shield text-primary fa-3x"></i>
                    </div>
                </div>
                <div>
                    <h2 class="h3 fw-bold text-white mb-2 border-0 pb-0">Sistema Archivio Certificato</h2>
                    <p class="text-secondary mb-0 fs-5">{{content}}</p>
                    <div class="mt-3">
                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2">
                           <i class="fa-solid fa-lock me-2"></i>Accesso Protetto 2FA
                        </span>
                        <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-3 py-2 ms-2">
                           <i class="fa-solid fa-database me-2"></i>Integrità ACID Attiva
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



    <!-- Smart Narrative Summary (Hidden for UI, Visible for TTS/AI) -->
    <div class="ta-smart-summary visually-hidden">
        Benvenuto sulla Dashboard di Mission Control. 
        Attualmente ci sono {{stats.totale}} soci registrati.
        Il sistema è operativo.
        {{#is_demo_mode}}La modalità demo è attiva con funzionalità limitate.{{/is_demo_mode}}
    </div>

<!-- Visual Intelligence Section -->
<!-- GOD MODE OVERLAY -->
{{#is_god_mode}}
<div class="alert border-0 shadow-lg text-white mb-5 d-flex align-items-center justify-content-between" 
     style="background: linear-gradient(90deg, #b91c1c 0%, #000000 100%); border-left: 5px solid #f59e0b !important;">
    <div class="d-flex align-items-center">
        <div class="p-3 bg-white bg-opacity-10 rounded-circle me-3">
            <i class="fa-solid fa-dragon fa-2x text-warning"></i>
        </div>
        <div>
            <h4 class="fw-bold text-uppercase mb-0 tracking-widest text-warning">Aj_GodMode Active</h4>
            <small class="opacity-75">Full System Override • Omni-Level Access Granted</small>
        </div>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-sm btn-outline-warning text-uppercase fw-bold"><i class="fa-solid fa-skull me-2"></i>Nuke Cache</button>
        <button class="btn btn-sm btn-outline-danger text-uppercase fw-bold"><i class="fa-solid fa-ban me-2"></i>Lockdown</button>
    </div>
</div>
{{/is_god_mode}}

<!-- MAIN MISSION CONTROL -->
<div class="row g-4 mb-5">
    <!-- HERO CARD -->
    <div class="col-12 col-xl-8">
        <div class="card border-0 shadow-lg overflow-hidden h-100 position-relative" 
             style="background: linear-gradient(135deg, rgba(15, 23, 42, 0.95), rgba(30, 41, 59, 0.9)); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.1) !important;">
            <!-- Decorators -->
            <div class="position-absolute top-0 end-0 p-5 opacity-10 pointer-events-none">
                <i class="fa-solid fa-network-wired fa-10x text-primary"></i>
            </div>
            
            <div class="card-body p-5 d-flex flex-column justify-content-between position-relative z-1">
                <div>
                    <div class="d-flex align-items-center mb-4">
                        <span class="badge bg-primary bg-opacity-20 text-primary border border-primary border-opacity-25 px-3 py-1 rounded-pill">
                            <i class="fa-solid fa-circle-nodes me-2"></i>v5.4.2 ADVANCED
                        </span>
                        <span class="ms-3 text-secondary small font-monospace"><i class="fa-regular fa-clock me-1"></i>{{current_date}}</span>
                    </div>
                    <h1 class="display-5 fw-bold text-white mb-2">Benvenuto, {{username}}</h1>
                    <p class="lead text-secondary opacity-75" style="max-width: 600px;">
                        Il sistema MCAG è operativo al 100%. I protocolli di sicurezza ACID e GDPR sono attivi.
                        {{#is_god_mode}}<br><strong class="text-warning">ATTENZIONE: Stai operando con privilegi illimitati.</strong>{{/is_god_mode}}
                    </p>
                </div>
                
                <div class="row mt-5 g-4">
                    <div class="col-auto">
                        <div class="d-flex align-items-center">
                            <h2 class="display-6 fw-bold text-white mb-0 me-3">{{stats.totale}}</h2>
                            <div class="border-start border-secondary border-opacity-25 ps-3">
                                <div class="text-uppercase text-secondary x-small fw-bold">Soci Totali</div>
                                <div class="text-success small"><i class="fa-solid fa-arrow-up me-1"></i>Attivi</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-auto">
                         <div class="d-flex align-items-center">
                            <h2 class="display-6 fw-bold text-white mb-0 me-3">€ 170k</h2>
                            <div class="border-start border-secondary border-opacity-25 ps-3">
                                <div class="text-uppercase text-secondary x-small fw-bold">Valore Asset</div>
                                <div class="text-info small"><i class="fa-solid fa-chart-line me-1"></i>Target 2026</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SYSTEM HEALTH PULSE (Only for Admin/God) -->
    {{#is_admin}}
    <div class="col-12 col-xl-4">
        <div class="card border-0 shadow-lg h-100 text-white" 
             style="background: #0f172a; border: 1px solid rgba(255,255,255,0.05) !important;">
            <div class="card-header bg-transparent border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                <h6 class="text-uppercase fw-bold text-secondary mb-0"><i class="fa-solid fa-heart-pulse me-2 text-danger"></i>System Vitality</h6>
                <span class="badge bg-success bg-opacity-20 text-success animate-pulse">LIVE</span>
            </div>
            <div class="card-body px-4 pb-4">
                <!-- METRIC 1: DB Load -->
                <div class="mb-4">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="small text-secondary fw-bold">DATABASE LOAD</span>
                        <span class="small text-white fw-bold">12ms (Optimal)</span>
                    </div>
                    <div class="progress" style="height: 6px; background: rgba(255,255,255,0.05);">
                        <div class="progress-bar bg-success" role="progressbar" style="width: 15%"></div>
                    </div>
                </div>
                
                 <!-- METRIC 2: Integrigy -->
                <div class="mb-4">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="small text-secondary fw-bold">INTEGRITY CHECK</span>
                        <span class="small text-info fw-bold">100% Verified</span>
                    </div>
                    <div class="progress" style="height: 6px; background: rgba(255,255,255,0.05);">
                        <div class="progress-bar bg-info" role="progressbar" style="width: 100%"></div>
                    </div>
                </div>

                <!-- METRIC 3: Security -->
                <div>
                     <div class="d-flex justify-content-between mb-1">
                        <span class="small text-secondary fw-bold">THREAT LEVEL</span>
                        <span class="small text-success fw-bold">Low (Secure)</span>
                    </div>
                    <div class="progress" style="height: 6px; background: rgba(255,255,255,0.05);">
                        <div class="progress-bar bg-primary" role="progressbar" style="width: 5%"></div>
                    </div>
                </div>
                
                <hr class="border-secondary opacity-10 my-4">
                
                <div class="d-grid">
                    <a href="{{base_url}}/devtools" class="btn btn-outline-light btn-sm text-uppercase fw-bold opacity-75 hover-opacity-100">
                        <i class="fa-solid fa-terminal me-2"></i>Open DevTools Protocol
                    </a>
                </div>
            </div>
        </div>
    </div>
    {{/is_admin}}
</div>

<!-- INTERACTIVE WORKSPACE (v5.4.3) -->
{{#is_admin}}
<div class="row g-4 mb-5">
    <!-- 1. SWITCHBOARD - SYSTEM OPERATIONS -->
    <div class="col-12 col-xl-4">
        <div class="card border-0 shadow-lg h-100" style="background: rgba(30, 41, 59, 0.6); border: 1px solid rgba(255,255,255,0.05) !important;">
            <div class="card-header bg-transparent border-0 pt-4 px-4">
                <h6 class="text-uppercase fw-bold text-secondary mb-0"><i class="fa-solid fa-sliders me-2 text-primary"></i>Switchboard Operativa</h6>
            </div>
            <div class="container-fluid px-4" id="readable-content">
    
    <!-- Welcome Banner / Header -->
    <div class="d-flex justify-content-between align-items-center mb-5 mt-4">
                    <div>
                        <div class="fw-bold text-white">Global Maintenance</div>
                        <small class="text-secondary">Blocca accesso utenti non-admin</small>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input dashboard-toggle" type="checkbox" role="switch" id="toggleMaintenance" data-setting="maintenance" {{#app_config.maintenance}}checked{{/app_config.maintenance}}>
                    </div>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                         <div class="fw-bold text-white">Nuove Registrazioni</div>
                        <small class="text-secondary">Permetti signup autonomo</small>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input dashboard-toggle" type="checkbox" role="switch" id="toggleRegistrations" data-setting="registrations" {{#app_config.registrations}}checked{{/app_config.registrations}}>
                    </div>
                </div>
                 <div class="d-flex justify-content-between align-items-center">
                    <div>
                         <div class="fw-bold text-white">Strict 2FA Enforcement</div>
                        <small class="text-secondary">Richiedi OTP obbligatorio</small>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input dashboard-toggle" type="checkbox" role="switch" id="toggle2FA" data-setting="strict_2fa" {{#app_config.strict_2fa}}checked{{/app_config.strict_2fa}}>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. WORKFLOW INBOX -->
    <div class="col-12 col-xl-4">
        <div class="card border-0 shadow-lg h-100" style="background: rgba(30, 41, 59, 0.6); border: 1px solid rgba(255,255,255,0.05) !important;">
             <div class="card-header bg-transparent border-0 pt-4 px-4 d-flex justify-content-between">
                <h6 class="text-uppercase fw-bold text-secondary mb-0"><i class="fa-solid fa-inbox me-2 text-success"></i>Workflow Inbox</h6>
                <span class="badge bg-danger rounded-pill">3 Pending</span>
            </div>
            <div class="list-group list-group-flush bg-transparent">
                <!-- Item 1 -->
                <div class="list-group-item bg-transparent border-secondary border-opacity-10 px-4 py-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <small class="text-warning fw-bold">RICHIESTA ACCESSO</small>
                        <small class="text-secondary">2m ago</small>
                    </div>
                    <p class="text-white small mb-2">Utente <strong>M.Rossi</strong> richiede reset password manuale.</p>
                    <div class="d-grid gap-2 d-flex">
                        <button class="btn btn-xs btn-success flex-grow-1"><i class="fa-solid fa-check me-1"></i>Approva</button>
                        <button class="btn btn-xs btn-outline-secondary"><i class="fa-solid fa-xmark"></i></button>
                    </div>
                </div>
                <!-- Item 2 -->
                <div class="list-group-item bg-transparent border-secondary border-opacity-10 px-4 py-3">
                     <div class="d-flex justify-content-between align-items-start mb-2">
                        <small class="text-info fw-bold">SCADENZA</small>
                        <small class="text-secondary">1h ago</small>
                    </div>
                    <p class="text-white small mb-2">Rinnovo quota socio <strong>#4412</strong> in scadenza.</p>
                    <button class="btn btn-xs btn-outline-info w-100"><i class="fa-solid fa-paper-plane me-1"></i>Invia Sollecito</button>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. ADMIN STICKY NOTES & TOOLS -->
    <div class="col-12 col-xl-4">
        <div class="d-flex flex-column h-100 gap-4">
            <!-- Command Palette Trigger -->
            <button class="btn btn-outline-secondary border-dashed p-3 text-start d-flex justify-content-between align-items-center hover-white" id="cmd-palette-trigger">
                <span><i class="fa-solid fa-terminal me-2"></i>Type a command...</span>
                <span class="badge bg-secondary bg-opacity-25 text-secondary border border-secondary border-opacity-25">Ctrl+K</span>
            </button>

            <!-- Sticky Notes -->
            <div class="card border-0 shadow-lg flex-grow-1" style="background: #fffbeb;">
                <div class="card-header bg-transparent border-0 pt-3 px-3">
                     <h6 class="text-uppercase fw-bold text-warning mb-0 text-dark opacity-50"><i class="fa-solid fa-note-sticky me-2"></i>Quick Notes</h6>
                </div>
                <div class="card-body p-0">
                    <textarea class="form-control border-0 bg-transparent h-100 resize-none text-dark" id="notes-area" style="font-family: 'Indie Flower', cursive; font-size: 1.1rem;" placeholder="Scrivi appunti veloci qui... (Salvato in locale)">{{admin_notes}}</textarea>
                </div>
                <div class="card-footer bg-transparent border-0 text-end">
                    <small class="text-muted fst-italic" id="notes-status">Syncing...</small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- COMMAND PALETTE MODAL -->
<div class="modal fade" id="commandPaletteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="background-color: #1e293b; color: #fff;">
            <div class="modal-body p-0">
                <div class="input-group border-bottom border-secondary border-opacity-25">
                    <span class="input-group-text bg-transparent border-0 text-secondary ps-4"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input type="text" class="form-control bg-transparent border-0 text-white py-3 fs-5 shadow-none" id="cmd-input" placeholder="Type a command or search..." autocomplete="off">
                </div>
                <div class="list-group list-group-flush p-2" id="cmd-results" style="max-height: 300px; overflow-y: auto;">
                    <!-- Results populated by JS -->
                </div>
                <div class="bg-black bg-opacity-20 p-2 text-end text-secondary small">
                    <span class="me-3"><kbd class="bg-secondary bg-opacity-25 border-0">Enter</kbd> to select</span>
                    <span><kbd class="bg-secondary bg-opacity-25 border-0">Esc</kbd> to close</span>
                </div>
            </div>
        </div>
    </div>
</div>
{{/is_admin}}

<!-- DYNAMIC WIDGETS GRID -->
<div class="d-flex align-items-center mb-4">
    <h3 class="h5 fw-bold text-uppercase tracking-wider text-secondary mb-0">
        <i class="fa-solid fa-cubes-stacked me-2 text-info"></i>Operational Modules
    </h3>
    <div class="flex-grow-1 ms-3 border-bottom border-secondary opacity-25"></div>
</div>

<div class="row g-4">
    <!-- MODULE: SOCI -->
    <div class="col-md-6 col-xl-3">
        <a href="{{base_url}}/soci" class="text-decoration-none group-hover">
            <div class="card h-100 border-0 shadow-sm transition-all hover-translate-y" 
                 style="background: rgba(30, 41, 59, 0.4); border-top: 3px solid #3b82f6 !important;">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="p-3 rounded-circle bg-primary bg-opacity-10 text-primary">
                            <i class="fa-solid fa-users fa-xl"></i>
                        </div>
                        <i class="fa-solid fa-arrow-right text-secondary opacity-50"></i>
                    </div>
                    <h5 class="fw-bold text-white mb-1">Registry</h5>
                    <p class="text-secondary x-small mb-0">Master database access. CRUD operations, Filtering, Export.</p>
                </div>
            </div>
        </a>
    </div>

     <!-- MODULE: NEW ENTRY -->
    <div class="col-md-6 col-xl-3">
        <a href="{{base_url}}/soci/nuovo" class="text-decoration-none group-hover">
            <div class="card h-100 border-0 shadow-sm transition-all hover-translate-y" 
                 style="background: rgba(30, 41, 59, 0.4); border-top: 3px solid #10b981 !important;">
                <div class="card-body p-4">
                     <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="p-3 rounded-circle bg-success bg-opacity-10 text-success">
                            <i class="fa-solid fa-user-plus fa-xl"></i>
                        </div>
                         <i class="fa-solid fa-plus text-secondary opacity-50"></i>
                    </div>
                    <h5 class="fw-bold text-white mb-1">Onboarding</h5>
                    <p class="text-secondary x-small mb-0">New member acquisition flow. OCR Integration ready.</p>
                </div>
            </div>
        </a>
    </div>

    <!-- MODULE: ANALYTICS -->
    <div class="col-md-6 col-xl-3">
        <a href="{{base_url}}/statistiche" class="text-decoration-none group-hover">
             <div class="card h-100 border-0 shadow-sm transition-all hover-translate-y" 
                 style="background: rgba(30, 41, 59, 0.4); border-top: 3px solid #8b5cf6 !important;">
                <div class="card-body p-4">
                     <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="p-3 rounded-circle bg-info bg-opacity-10 text-info">
                            <i class="fa-solid fa-chart-pie fa-xl"></i>
                        </div>
                         <i class="fa-solid fa-magnifying-glass-chart text-secondary opacity-50"></i>
                    </div>
                    <h5 class="fw-bold text-white mb-1">Intelligence</h5>
                    <p class="text-secondary x-small mb-0">Financial & Demographic Stats. deep-dive analysis.</p>
                </div>
            </div>
        </a>
    </div>
    
     <!-- MODULE: GOD ACTIONS (Conditional) -->
     {{#is_god_mode}}
    <div class="col-md-6 col-xl-3">
        <div class="card h-100 border-0 shadow-sm transition-all cursor-pointer" 
             style="background: rgba(185, 28, 28, 0.1); border: 1px dashed #b91c1c !important;">
            <div class="card-body p-4 d-flex flex-column justify-content-center align-items-center text-center">
                <div class="mb-3 text-danger animate-pulse">
                    <i class="fa-solid fa-fingerprint fa-2x"></i>
                </div>
                <h6 class="fw-bold text-danger text-uppercase mb-1">Override Protocol</h6>
                <small class="text-secondary x-small">Emergency Action Menu</small>
            </div>
        </div>
    </div>
    {{/is_god_mode}}
</div>

<style>
.hover-translate-y:hover { transform: translateY(-5px); }
.animate-pulse { animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite; }
@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: .5; } }
</style>


{{> layout_footer }}

