                     <h6 class="text-uppercase fw-bold text-warning mb-0 tracking-widest opacity-75"><i class="fa-solid fa-note-sticky me-2"></i>Field Notes</h6>
                </div>
                <div class="card-body p-0">
                    <textarea class="form-control border-0 bg-transparent h-100 resize-none text-white small" id="notes-area" style="font-family: 'Consolas', monospace; line-height: 1.5;" placeholder="// Enter operational notes here...">{{admin_notes}}</textarea>
