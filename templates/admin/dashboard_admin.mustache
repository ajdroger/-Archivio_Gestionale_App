                        <small class="text-secondary x-small font-monospace">10:45</small>
                    </div>
                    <p class="text-white small mb-2 text-opacity-75">Rinnovo quota socio <strong>#4412</strong> in scadenza.</p>
                    <button class="btn btn-sm btn-outline-info w-100 py-0 x-small fw-bold">NOTIFY USER</button>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. ADMIN TOOLS & NOTES -->
    <div class="col-12 col-xl-4">
        <div class="d-flex flex-column h-100 gap-4">
            <!-- Command Palette Trigger -->
            <button class="btn btn-outline-secondary border-secondary border-opacity-25 border-dashed p-3 text-start d-flex justify-content-between align-items-center hover-border-primary transition-all text-white bg-dark bg-opacity-50" id="cmd-palette-trigger">
                <span><i class="fa-solid fa-terminal me-2 text-primary opacity-75"></i>Execute Command...</span>
                <span class="badge bg-secondary bg-opacity-25 text-secondary border border-secondary border-opacity-25 font-monospace">Ctrl+K</span>
            </button>

            <!-- Sticky Notes -->
            <div class="card border-0 shadow-lg flex-grow-1 position-relative overflow-hidden" style="background: rgba(255, 251, 235, 0.05); border: 1px solid rgba(251, 191, 36, 0.2) !important;">
