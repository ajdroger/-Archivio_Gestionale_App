{{> layout_header }}
<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card border-0 shadow-lg" style="background: rgba(30, 41, 59, 0.4); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.05) !important;">
            <div class="card-header bg-transparent py-4 border-bottom border-secondary">
                <h5 class="mb-0 text-white fw-bold"><i class="fa-solid fa-user-shield me-2 text-primary"></i>SECURITY & ACCOUNT CONTROL</h5>
            </div>
            <div class="card-body p-4 p-md-5">
                <div class="d-flex align-items-center mb-5 p-4 rounded bg-black bg-opacity-20 border border-secondary border-opacity-25">
                    <div class="avatar-initial rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fw-bold fs-2 shadow-sm border border-primary border-opacity-25" style="width: 80px; height: 80px;">
                        {{user_initial}}
                    </div>
                    <div class="ms-4">
                        <h3 class="mb-1 text-white fw-bold">{{user.username}}</h3>
                        <div class="d-flex gap-2">
                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25">{{user.role}}</span>
                            <span class="badge bg-dark text-secondary border border-secondary px-2"><i class="fa-solid fa-history me-1"></i>ULTIMO ACCESSO: {{user.last_login}}</span>
                        </div>
                    </div>
                </div>

                <form class="mt-4">
                    <div class="row g-4">
                        <div class="col-md-6 border-end border-secondary border-opacity-25">
                            <h5 class="mc-section-title mb-4"><i class="fa-solid fa-envelope me-2 text-primary"></i>IDENTITÀ DIGITALE</h5>
                            <div class="form-group mb-4">
                                <label class="mc-label">E-MAIL DI SISTEMA (READ-ONLY)</label>
                                <div class="mc-code-box text-secondary">
                                    <i class="fa-solid fa-lock me-2 small"></i>{{user.email}}
                                </div>
                                <div class="form-text text-secondary opacity-50 small mt-2">I parametri di identità sono gestiti globalmente dal root administrator.</div>
                            </div>
                        </div>

                        <div class="col-md-6 px-md-4">
                            <h5 class="mc-section-title mb-4"><i class="fa-solid fa-key me-2 text-warning"></i>AGGIORNAMENTO CREDENZIALI</h5>
                            <div class="form-group mb-3">
                                <label class="mc-label" for="old_pass">PASSWORD ATTUALE</label>
                                <input type="password" id="old_pass" class="mc-input text-white" placeholder="••••••••">
                            </div>
                            <div class="form-group mb-3">
                                <label class="mc-label" for="new_pass">NUOVA PASSWORD</label>
                                <input type="password" id="new_pass" class="mc-input text-white" placeholder="Certificata 12+ char">
                            </div>
                            <div class="form-group mb-4">
                                <label class="mc-label" for="conf_pass">CONFERMA NUOVA PASSWORD</label>
                                <input type="password" id="conf_pass" class="mc-input text-white" placeholder="Ripeti password">
                            </div>
                        </div>
                    </div>

                    <div class="text-end border-top border-secondary mt-5 pt-4">
                        <button type="submit" class="btn btn-primary btn-lg px-5 shadow-primary fw-bold">
                            <i class="fa-solid fa-save me-2"></i>SALVA CONFIGURAZIONE SICUREZZA
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Styles moved to style.css -->

{{> layout_footer }}
