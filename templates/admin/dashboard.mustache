{{> layout_header }}
<div class="row mb-5">
    <div class="col-12">
        <div class="card border-0 shadow-lg overflow-hidden" style="background: linear-gradient(135deg, rgba(56, 189, 248, 0.1), rgba(30, 41, 59, 0.8)); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.05) !important;">
            <div class="card-body p-4 p-md-5 d-flex align-items-center">
                <div class="flex-shrink-0 d-none d-md-block me-4">
                    <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                        <i class="fa-solid fa-user-shield text-primary fa-3x"></i>
                    </div>
                </div>
                <div>
                    <h2 class="h3 fw-bold text-white mb-2 border-0 pb-0">Sistema Archivio Certificato</h2>
                    <p class="text-secondary mb-0 fs-5">{{content}}</p>
                    <div class="mt-3">
                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2">
                           <i class="fa-solid fa-lock me-2"></i>Accesso Protetto 2FA
                        </span>
                        <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-3 py-2 ms-2">
                           <i class="fa-solid fa-database me-2"></i>Integrità ACID Attiva
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- Visual Intelligence Section -->
<div class="row g-4 mb-5">
    <!-- Chart 1: Status Distribution -->
    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm h-100" style="background: rgba(30, 41, 59, 0.5); border: 1px solid rgba(255,255,255,0.05) !important;">
            <div class="card-body position-relative">
                <h6 class="text-secondary text-uppercase fw-bold small mb-3"><i class="fa-solid fa-pie-chart me-2"></i>Salute Archivio</h6>
                <div style="height: 250px;">
                    <canvas id="chartStatus"></canvas>
                </div>
                <div class="position-absolute top-50 start-50 translate-middle text-center pointer-events-none">
                    <div class="h3 fw-bold text-white mb-0">{{stats.totale}}</div>
                    <div class="small text-secondary">TOTALE</div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Chart 2: Financial Trend -->
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm h-100" style="background: rgba(30, 41, 59, 0.5); border: 1px solid rgba(255,255,255,0.05) !important;">
             <div class="card-body">
                <h6 class="text-secondary text-uppercase fw-bold small mb-3"><i class="fa-solid fa-arrow-trend-up me-2"></i>Trend Iscrizioni (Anno Corrente)</h6>
                <div style="height: 250px; width: 100%;">
                    <canvas id="chartTrend"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="d-flex align-items-center mb-4">
    <h3 class="h5 fw-bold text-uppercase tracking-wider text-secondary mb-0"><i class="fa-solid fa-bolt-lightning me-2 text-warning"></i>Azioni di Sistema</h3>
    <div class="flex-grow-1 ms-3 border-bottom border-secondary opacity-25"></div>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <a href="{{base_url}}/soci" class="text-decoration-none">
            <div class="card h-100 border-0 shadow-sm hover-up" style="background: rgba(30, 41, 59, 0.5); border: 1px solid rgba(255,255,255,0.05) !important; transition: all 0.3s ease;">
                <div class="card-body p-4 text-center">
                    <div class="display-5 text-primary mb-3"><i class="fa-solid fa-users-viewfinder"></i></div>
                    <h5 class="fw-bold text-white">Anagrafica Soci</h5>
                    <p class="text-secondary small">Gestione completa dell'elenco soci, filtri avanzati e monitoraggio morosità.</p>
                </div>
            </div>
        </a>
    </div>
    
    <div class="col-md-4">
        <a href="{{base_url}}/soci/nuovo" class="text-decoration-none">
            <div class="card h-100 border-0 shadow-sm hover-up" style="background: rgba(30, 41, 59, 0.5); border: 1px solid rgba(255,255,255,0.05) !important; transition: all 0.3s ease;">
                 <div class="card-body p-4 text-center">
                    <div class="display-5 text-success mb-3"><i class="fa-solid fa-user-plus"></i></div>
                    <h5 class="fw-bold text-white">Nuova Iscrizione</h5>
                    <p class="text-secondary small">Processo guidato di registrazione per nuovi membri con supporto OCR.</p>
                </div>
            </div>
        </a>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script type="application/json" id="dashboard-data">
        {{{stats_json}}}
    </script>
    <script src="{{base_url}}/js/devtools/admin_dashboard.js"></script>
    
    <div class="col-md-4">
        <a href="{{base_url}}/statistiche" class="text-decoration-none">
            <div class="card h-100 border-0 shadow-sm hover-up" style="background: rgba(30, 41, 59, 0.5); border: 1px solid rgba(255,255,255,0.05) !important; transition: all 0.3s ease;">
                 <div class="card-body p-4 text-center">
                    <div class="display-5 text-info mb-3"><i class="fa-solid fa-chart-line"></i></div>
                    <h5 class="fw-bold text-white">Advanced Insights</h5>
                    <p class="text-secondary small">Analisi demografica e flussi finanziari con reportistica exportabile.</p>
                </div>
            </div>
        </a>
    </div>
</div>


{{> layout_footer }}


