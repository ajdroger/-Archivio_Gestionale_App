<!DOCTYPE html>
<html lang="it" class="h-100">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MCAG | Mission Control</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="{{base_url}}/css/premium.css">
    
    <!-- Custom CSS (Consolidated) -->
    <link rel="stylesheet" href="{{base_url}}/css/style.css">

    <script>
        window.BASE_URL = "{{base_url}}";
    </script>
</head>
<body class="d-flex flex-column h-100 {{body_class}}">
    <!-- NO NAVBAR, NO CONTAINER - Pure Canvas for DevTools -->
    {{#flash_message}}
    <div class="position-absolute top-0 end-0 p-3" style="z-index: 9999;">
        <div class="alert alert-{{type}} alert-dismissible fade show shadow border-0 bg-dark text-white" role="alert" style="border-left: 5px solid var(--bs-{{type}}) !important;">
            <i class="fa-solid fa-circle-info me-2"></i>{{message}}
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    </div>
    {{/flash_message}}
