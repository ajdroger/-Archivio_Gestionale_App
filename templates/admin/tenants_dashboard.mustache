<!DOCTYPE html>
<html lang="it" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <title>SaaS Super Admin Dashboard - MCAG v9.0</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        body { background-color: #000; color: #fff; font-family: 'Inter', sans-serif; }
        .glass-card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
        }
        .status-active { color: #10b981; }
        .status-suspended { color: #ef4444; }
    </style>
</head>
<body class="p-4">
    
    <div class="container-fluid">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-5">
            <div>
                <h1 class="fw-bold"><i class="fas fa-network-wired text-info me-2"></i>SaaS Control Center</h1>
                <p class="text-secondary mb-0">Gestione Centralizzata Multi-Tenant (Schema-per-Tenant)</p>
            </div>
            <div>
                <a href="/admin/dashboard" class="btn btn-outline-secondary me-2">Torna ad Admin Locale</a>
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newTenantModal">
                    <i class="fas fa-plus me-2"></i>Nuovo Tenant
                </button>
            </div>
        </div>

        <!-- Stats Row -->
        <div class="row g-4 mb-5">
            <div class="col-md-3">
                <div class="glass-card p-4">
                    <h3 class="display-6 fw-bold">{{stats.total}}</h3>
                    <div class="text-secondary small text-uppercase">Totale Clienti</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="glass-card p-4 border-start border-4 border-success">
                    <h3 class="display-6 fw-bold text-success">{{stats.active}}</h3>
                    <div class="text-secondary small text-uppercase">Attivi</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="glass-card p-4 border-start border-4 border-danger">
                    <h3 class="display-6 fw-bold text-danger">{{stats.suspended}}</h3>
                    <div class="text-secondary small text-uppercase">Sospesi (Billing)</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="glass-card p-4 border-start border-4 border-warning">
                    <h3 class="display-6 fw-bold text-warning">€{{stats.revenue}}</h3>
                    <div class="text-secondary small text-uppercase">ARR Stimato</div>
                </div>
            </div>
        </div>

        {{#error}}
        <div class="alert alert-danger mb-4">{{error}}</div>
        {{/error}}

        <!-- Tenant List -->
        <div class="glass-card p-0 overflow-hidden">
            <table class="table table-dark table-hover mb-0 align-middle">
                <thead>
                    <tr class="bg-secondary bg-opacity-10">
                        <th class="p-3">Tenant Name</th>
                        <th class="p-3">Subdomain</th>
                        <th class="p-3">Database</th>
                        <th class="p-3">Plan</th>
                        <th class="p-3">Status</th>
                        <th class="p-3">Created</th>
                        <th class="p-3 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{#tenants}}
                    <tr>
                        <td class="p-3 fw-bold">{{name}}</td>
                        <td class="p-3"><a href="https://{{subdomain}}.mcag-system.com" target="_blank" class="text-info">{{subdomain}}.mcag-system.com</a></td>
                        <td class="p-3 font-monospace text-muted small">{{db_name}}</td>
                        <td class="p-3"><span class="badge bg-secondary">{{plan_id}}</span></td>
                        <td class="p-3">
                            {{#status_active}}
                                <span class="badge bg-success bg-opacity-25 text-success"><i class="fas fa-check-circle me-1"></i> Active</span>
                            {{/status_active}}
                            {{^status_active}}
                                <span class="badge bg-danger bg-opacity-25 text-danger"><i class="fas fa-ban me-1"></i> Suspended</span>
                            {{/status_active}}
                        </td>
                        <td class="p-3 text-secondary small">{{created_at}}</td>
                        <td class="p-3 text-end">
                            <form action="/super-admin/toggle/{{id}}" method="POST" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-warning" title="Sospendi/Attiva">
                                    <i class="fas fa-power-off"></i>
                                </button>
                            </form>
                            <button class="btn btn-sm btn-outline-info ms-1" title="Login As SuperAdmin">
                                <i class="fas fa-key"></i>
                            </button>
                        </td>
                    </tr>
                    {{/tenants}}
                    {{^tenants}}
                    <tr>
                        <td colspan="7" class="p-5 text-center text-secondary">
                            <i class="fas fa-database mb-3 fa-2x"></i><br>
                            Nessun Tenant trovato. Crea il primo cliente!
                        </td>
                    </tr>
                    {{/tenants}}
                </tbody>
            </table>
        </div>
    </div>

    <!-- Create Modal -->
    <div class="modal fade" id="newTenantModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass-card bg-dark">
                <div class="modal-header border-secondary border-opacity-25">
                    <h5 class="modal-title">Nuovo Tenant</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form action="/super-admin/create" method="POST">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label text-secondary">Nome Cliente</label>
                            <input type="text" name="name" class="form-control bg-black text-white border-secondary" required placeholder="Es. Associazione Nazionale Alpini">
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-secondary">Sottodominio</label>
                            <div class="input-group">
                                <input type="text" name="subdomain" class="form-control bg-black text-white border-secondary" required placeholder="alpini">
                                <span class="input-group-text bg-secondary bg-opacity-10 text-secondary border-secondary">.mcag-system.com</span>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-secondary">Piano</label>
                            <select name="plan" class="form-select bg-black text-white border-secondary">
                                <option value="professional">Professional License</option>
                                <option value="enterprise">Enterprise License</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer border-secondary border-opacity-25">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annulla</button>
                        <button type="submit" class="btn btn-primary">Provisioning Database</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
