<script>
    function toggleMobileMenu() {
        const overlay = document.getElementById('mobile-menu-overlay');
        const sidebar = document.getElementById('mobile-menu-sidebar');
        if (sidebar.classList.contains('hidden')) {
            overlay.classList.remove('hidden');
            sidebar.classList.remove('hidden');
            setTimeout(() => sidebar.classList.remove('translate-x-full'), 10);
        } else {
            sidebar.classList.add('translate-x-full');
            setTimeout(() => {
                overlay.classList.add('hidden');
                sidebar.classList.add('hidden');
            }, 300);
        }
    }

    // Apps Menu Toggle (Click based)
    function toggleAppsMenu(e) {
        e.stopPropagation();
        const menu = document.getElementById('apps-dropdown-menu');
        const btn = document.getElementById('apps-dropdown-btn');
        menu.classList.toggle('hidden');
        
        // Toggle active state style
        if (!menu.classList.contains('hidden')) {
            btn.classList.add('bg-gray-800', 'text-white');
        } else {
            btn.classList.remove('bg-gray-800', 'text-white');
        }
    }

    // Close menus on click outside
    document.addEventListener('click', function(e) {
         const appsMenu = document.getElementById('apps-dropdown-menu');
         const appsBtn = document.getElementById('apps-dropdown-btn');
         
         if (appsMenu && !appsMenu.classList.contains('hidden') && !appsMenu.contains(e.target) && e.target !== appsBtn) {
             appsMenu.classList.add('hidden');
             appsBtn.classList.remove('bg-gray-800', 'text-white');
         }
    });

    document.getElementById('mobile-menu-btn').addEventListener('click', toggleMobileMenu);
</script>
