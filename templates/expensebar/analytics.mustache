<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link rel="stylesheet" href="{{base_url}}/css/tailwind-external.css">
    <link rel="stylesheet" href="{{base_url}}/assets/expensebar/style.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/feather-icons"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        window.MCAG_BASE_URL = "{{base_url}}";
        window.MCAG_API_URL = "{{base_url}}/expensebar/api";
    </script>
</head>
<body class="bg-[#020617] text-slate-200 min-h-screen flex flex-col font-sans selection:bg-emerald-500/30 overflow-x-hidden">

    <!-- Ambient Background -->
    <div class="fixed inset-0 -z-10 bg-[radial-gradient(circle_at_50%_0%,_rgba(124,58,237,0.15),_transparent_70%)]" style="z-index: -10;"></div>
    <div class="fixed top-0 left-0 w-full h-[1px] bg-gradient-to-r from-transparent via-violet-500/50 to-transparent" style="z-index: -10;"></div>

    <!-- Global MCAG Navbar -->
    {{> expensebar/navbar}}

    <main class="container mx-auto px-4 py-8 max-w-7xl relative z-10 flex-grow">
        <!-- Header -->
        <div class="mb-8 animate-fade-in">
            <h1 class="text-3xl font-bold text-white mb-2 flex items-center gap-2">
                Advanced Analytics
                <span class="px-2 py-0.5 rounded text-xs font-medium bg-violet-500/10 text-violet-400 border border-violet-500/20">Pro</span>
            </h1>
            <p class="text-gray-400">Deep insights into your spending patterns</p>
        </div>

        <!-- Controls -->
        <div class="flex justify-end mb-6">
            <select id="analyticsYear" class="bg-gray-900 border border-gray-700 text-sm text-gray-300 rounded-xl px-4 py-2 focus:ring-2 focus:ring-violet-500/50">
                <option value="2026" selected>2026</option>
                <option value="2025">2025</option>
                <option value="2024">2024</option>
            </select>
        </div>

        <!-- Analytics Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
            <!-- Major Category Breakdown -->
            <div class="glass-panel p-6 rounded-2xl border border-white/5 relative group">
                 <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                    <i data-feather="pie-chart" class="w-24 h-24 text-violet-500"></i>
                </div>
                <h2 class="text-xl font-bold text-white mb-6 flex items-center gap-2">
                    <i data-feather="pie-chart" class="w-5 h-5 text-violet-500"></i>
                    Ripartizione Categorie
                </h2>
                <div class="h-80 relative flex justify-center">
                    <canvas id="categoryChart"></canvas>
                </div>
            </div>

            <!-- Yearly Trend -->
            <div class="glass-panel p-6 rounded-2xl border border-white/5 relative group">
                 <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                    <i data-feather="trending-up" class="w-24 h-24 text-emerald-500"></i>
                </div>
                <h2 class="text-xl font-bold text-white mb-6 flex items-center gap-2">
                    <i data-feather="trending-up" class="w-5 h-5 text-emerald-500"></i>
                    Trend Annuale
                </h2>
                <div class="h-80 relative">
                    <canvas id="yearlyChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Detailed Stats Table -->
        <div class="glass-panel p-6 rounded-2xl border border-white/5">
            <h2 class="text-xl font-bold text-white mb-6 flex items-center gap-2">
                <i data-feather="grid" class="w-5 h-5 text-blue-500"></i>
                Statistiche Dettagliate
            </h2>
            <div class="overflow-x-auto">
                <table class="w-full text-sm text-left">
                    <thead class="text-xs text-gray-500 uppercase bg-gray-900/50 rounded-lg">
                        <tr>
                            <th class="px-4 py-3 rounded-l-lg">Categoria</th>
                            <th class="px-4 py-3 text-right">Totale</th>
                            <th class="px-4 py-3 text-right">Media/Mese</th>
                            <th class="px-4 py-3 text-right rounded-r-lg">% Budget</th>
                        </tr>
                    </thead>
                    <tbody id="categoryStatsTable" class="divide-y divide-gray-800">
                         <tr>
                            <td colspan="4" class="px-4 py-8 text-center text-gray-500">Caricamento dati...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    {{> expensebar/footer}}

    <!-- Scripts -->
    <script src="{{base_url}}/js/lib/sweetalert2.all.min.js"></script>
    <script src="{{base_url}}/js/pages/expensebar-analytics.js"></script>
    <script>
        feather.replace();
    </script>
</body>
</html>
