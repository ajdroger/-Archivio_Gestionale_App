<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <!-- Core Styles (Mirroring Workshift) -->
    <link rel="stylesheet" href="{{base_url}}/css/tailwind-external.css">
    <link rel="stylesheet" href="{{base_url}}/assets/expensebar/style.css">
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Scripts -->
    <script src="https://unpkg.com/feather-icons"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        window.MCAG_BASE_URL = "{{base_url}}";
        window.MCAG_API_URL = "{{base_url}}/expensebar/api";
    </script>
</head>
<body class="bg-[#020617] text-slate-200 min-h-screen flex flex-col font-sans selection:bg-emerald-500/30 overflow-x-hidden">

    <!-- Ambient Background (Mirroring Workshift) -->
    <div class="fixed inset-0 -z-10 bg-[radial-gradient(circle_at_50%_0%,_rgba(16,185,129,0.15),_transparent_70%)]" style="z-index: -10;"></div>
    <div class="fixed top-0 left-0 w-full h-[1px] bg-gradient-to-r from-transparent via-emerald-500/50 to-transparent" style="z-index: -10;"></div>

    <!-- Global MCAG Navbar -->
    <!-- Global MCAG Navbar -->
    {{> expensebar/navbar}}

    <main class="container mx-auto px-4 py-8 max-w-7xl relative z-10 flex-grow">
        
        <!-- Controls & Date Filter -->
        <div class="flex flex-col md:flex-row justify-between items-end md:items-center mb-8 gap-4 animate-fade-in-down">
            <div>
                <h1 class="text-3xl font-bold text-white mb-2 flex items-center gap-2">
                    Panoramica Mensile
                    <span class="px-2 py-0.5 rounded text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">Live</span>
                </h1>
                <p class="text-gray-400">Analisi dettagliata delle tue spese e trend finanziari.</p>
            </div>
            
            <div class="flex items-center gap-3 bg-gray-900/50 p-1.5 rounded-xl border border-white/10 backdrop-blur-sm">
                <button id="prevMonth" class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-white/10 text-gray-400 hover:text-white transition-colors">
                    <i data-feather="chevron-left" class="w-4 h-4"></i>
                </button>
                <div class="px-4 py-1 text-sm font-medium text-white min-w-[140px] text-center" id="currentMonthDisplay">
                    Caricamento...
                </div>
                <button id="nextMonth" class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-white/10 text-gray-400 hover:text-white transition-colors">
                    <i data-feather="chevron-right" class="w-4 h-4"></i>
                </button>
            </div>
        </div>

        <!-- KPI Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <!-- Total Spent -->
            <div class="glass-panel p-6 rounded-2xl relative overflow-hidden group">
                <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                    <i data-feather="dollar-sign" class="w-24 h-24 text-emerald-500"></i>
                </div>
                <p class="text-gray-400 text-sm font-medium mb-1">Totale Spese</p>
                <h3 class="text-4xl font-bold text-white mb-2 tracking-tight" id="totalAmount">€0.00</h3>
                <div class="flex items-center gap-2 text-sm text-emerald-400 bg-emerald-500/10 px-2 py-1 rounded w-fit">
                    <i data-feather="trending-up" class="w-3 h-3"></i>
                    <span>Aggiornato</span>
                </div>
            </div>

            <!-- Categories Count -->
            <div class="glass-panel p-6 rounded-2xl relative overflow-hidden group">
                <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                    <i data-feather="grid" class="w-24 h-24 text-violet-500"></i>
                </div>
                <p class="text-gray-400 text-sm font-medium mb-1">Categorie Attive</p>
                <h3 class="text-4xl font-bold text-white mb-2 tracking-tight" id="activeCategories">0</h3>
                <div class="text-xs text-gray-500">Distribuzione diversificata</div>
            </div>

            <!-- Daily Average -->
            <div class="glass-panel p-6 rounded-2xl relative overflow-hidden group">
                <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                    <i data-feather="activity" class="w-24 h-24 text-blue-500"></i>
                </div>
                <p class="text-gray-400 text-sm font-medium mb-1">Media Giornaliera</p>
                <h3 class="text-4xl font-bold text-white mb-2 tracking-tight" id="dailyAverage">€0.00</h3>
                <div class="text-xs text-gray-500">Basato sui giorni trascorsi</div>
            </div>
        </div>

        <!-- Charts Layout -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">
            <!-- Main Trend Chart -->
            <div class="lg:col-span-2 glass-panel p-6 rounded-2xl border border-white/5">
                <div class="flex justify-between items-center mb-6">
                    <h3 class="text-lg font-semibold text-white flex items-center gap-2">
                        <i data-feather="bar-chart" class="w-4 h-4 text-emerald-500"></i>
                        Trend Annuale
                    </h3>
                    <select id="trendYearMock" class="bg-gray-900 border border-gray-700 text-xs text-gray-300 rounded-lg px-2 py-1 focus:ring-1 focus:ring-emerald-500">
                        <option value="2026" selected>2026</option>
                        <option value="2025">2025</option>
                        <option value="2024">2024</option>
                    </select>
                </div>
                <div class="h-80 w-full relative">
                    <canvas id="trendChart"></canvas>
                </div>
            </div>

            <!-- Category Breakdown -->
            <div class="glass-panel p-6 rounded-2xl border border-white/5">
                <h3 class="text-lg font-semibold text-white mb-6 flex items-center gap-2">
                    <i data-feather="pie-chart" class="w-4 h-4 text-violet-500"></i>
                    Ripartizione
                </h3>
                <div class="h-64 w-full relative flex items-center justify-center">
                    <canvas id="categoryChart"></canvas>
                </div>
                <!-- Legend Container (Custom) -->
                <div id="categoryLegend" class="mt-4 space-y-2 max-h-32 overflow-y-auto custom-scrollbar"></div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Recent Transactions Table -->
            <div class="lg:col-span-2 glass-panel p-6 rounded-2xl border border-white/5">
                <div class="flex justify-between items-center mb-6">
                    <h3 class="text-lg font-semibold text-white">Transazioni Recenti</h3>
                    <button class="text-xs text-emerald-400 hover:text-emerald-300 transition-colors">Vedi tutte</button>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left">
                        <thead class="text-xs text-gray-500 uppercase bg-gray-900/50 rounded-lg">
                            <tr>
                                <th class="px-4 py-3 rounded-l-lg">Data</th>
                                <th class="px-4 py-3">Descrizione</th>
                                <th class="px-4 py-3">Categoria</th>
                                <th class="px-4 py-3 text-right rounded-r-lg">Importo</th>
                                <th class="px-4 py-3 text-center">Azioni</th>
                            </tr>
                        </thead>
                        <tbody id="transactionTableBody" class="divide-y divide-gray-800">
                            <!-- Dynamic Rows -->
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Quick Add Form -->
            <div class="glass-panel p-6 rounded-2xl border border-white/5 bg-gradient-to-b from-gray-900 to-gray-900/50">
                <h3 class="text-lg font-semibold text-white mb-4">Nuova Spesa</h3>
                <form id="quickExpenseForm" class="space-y-4">
                    <div>
                        <label class="block text-xs font-medium text-gray-400 mb-1">Descrizione</label>
                        <input type="text" id="descInput" placeholder="Es. Cena Sushi" class="w-full bg-gray-800 border border-gray-700 rounded-xl px-4 py-2.5 text-white placeholder-gray-600 focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 transition-all text-sm">
                    </div>
                    
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-medium text-gray-400 mb-1">Importo (€)</label>
                            <input type="number" step="0.01" id="amountInput" placeholder="0.00" class="w-full bg-gray-800 border border-gray-700 rounded-xl px-4 py-2.5 text-white placeholder-gray-600 focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 transition-all text-sm font-mono">
                        </div>
                        <div>
                             <label class="block text-xs font-medium text-gray-400 mb-1">Categoria</label>
                            <select id="categoryInput" class="w-full bg-gray-800 border border-gray-700 rounded-xl px-4 py-2.5 text-white focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 transition-all text-sm">
                                <option value="Food & Dining">🍽️ Cibo</option>
                                <option value="Transportation">🚗 Trasporti</option>
                                <option value="Shopping">🛍️ Shopping</option>
                                <option value="Entertainment">🎬 Svago</option>
                                <option value="Bills & Utilities">📄 Bollette</option>
                                <option value="Healthcare">🏥 Salute</option>
                                <option value="Travel">✈️ Viaggi</option>
                                <option value="Education">📚 Scuola</option>
                                <option value="Other" selected>📦 Altro</option>
                            </select>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-medium text-gray-400 mb-1">Data e Ora</label>
                        <input type="datetime-local" id="dateInput" class="w-full bg-gray-800 border border-gray-700 rounded-xl px-4 py-2.5 text-white focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 transition-all text-sm">
                    </div>

                    <button type="submit" class="w-full bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-white font-bold py-3 rounded-xl shadow-lg shadow-emerald-500/20 active:scale-95 transition-all duration-200 mt-2 flex items-center justify-center gap-2">
                        <i data-feather="plus" class="w-4 h-4"></i>
                        Aggiungi Spesa
                    </button>
                </form>
            </div>
        </div>
    </main>

    {{> expensebar/footer}}

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="{{base_url}}/js/lib/sweetalert2.all.min.js"></script>
    <script src="{{base_url}}/js/pages/expensebar.js"></script>
    <script>
        // Init Date Input with Today's Date and Time
        const dateInput = document.getElementById('dateInput');
        if(dateInput) {
            const now = new Date();
            now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
            dateInput.value = now.toISOString().slice(0, 16);
        }
    </script>
</body>
</html>
