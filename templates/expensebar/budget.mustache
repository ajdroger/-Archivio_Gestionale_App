<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link rel="stylesheet" href="{{base_url}}/css/tailwind-external.css"> 
    <link rel="stylesheet" href="{{base_url}}/assets/expensebar/style.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'mcag-slate': '#0f172a',
                        'mcag-blue': '#3b82f6',
                    }
                }
            }
        }
    </script>
    <script src="https://unpkg.com/feather-icons"></script>
</head>
<body class="bg-[#020617] text-slate-200 min-h-screen flex flex-col font-sans selection:bg-emerald-500/30 overflow-x-hidden">

    <!-- Ambient Background -->
    <div class="fixed inset-0 -z-10 bg-[radial-gradient(circle_at_50%_0%,_rgba(16,185,129,0.15),_transparent_70%)]" style="z-index: -10;"></div>
    <div class="fixed top-0 left-0 w-full h-[1px] bg-gradient-to-r from-transparent via-emerald-500/50 to-transparent" style="z-index: -10;"></div>

    {{> expensebar/navbar}}

    <main class="container mx-auto px-4 py-8 max-w-7xl relative z-10 flex-grow">
        
        <!-- Genius Header -->
        <div class="flex flex-col md:flex-row justify-between items-end md:items-center mb-8 gap-4 animate-fade-in-down">
            <div>
                <h1 class="text-3xl font-bold text-white mb-2 flex items-center gap-2">
                    <span class="bg-gradient-to-r from-emerald-400 to-cyan-400 bg-clip-text text-transparent">Genius Budget</span>
                    <span class="px-2 py-0.5 rounded text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">AI Enhanced</span>
                </h1>
                <p class="text-gray-400">Controllo totale delle tue finanze. Imposta limiti, traccia in tempo reale.</p>
            </div>
            
             <!-- Aggregate Pulse -->
             <div class="glass-panel px-6 py-2 rounded-2xl border border-white/5 bg-gray-900/40 flex items-center gap-6">
                <div>
                    <span class="text-xs text-gray-500 uppercase tracking-wider block">Budget Totale</span>
                    <span class="text-xl font-bold text-white" id="totalLimit">€0.00</span>
                </div>
                 <div class="h-8 w-px bg-gray-700"></div>
                <div>
                    <span class="text-xs text-gray-500 uppercase tracking-wider block">Disponibile</span>
                    <span class="text-xl font-bold text-emerald-400" id="totalRemaining">€0.00</span>
                </div>
                 <div class="hidden md:flex items-center gap-2">
                     <div class="radial-progress text-emerald-500 text-xs" style="--value:0; --size:2.5rem;" id="healthIndicator">0%</div>
                 </div>
            </div>
        </div>

        <!-- Live Monitor Grid -->
        <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4">Live Monitor</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12" id="budgetOverview">
            <!-- Dynamic Content -->
            <div class="col-span-full text-center py-12 animate-pulse">
                <p class="text-gray-500">Inizializzazione Genius System...</p>
            </div>
        </div>

        <!-- Control Center -->
        <div class="glass-panel p-8 rounded-3xl border border-white/5 bg-gray-900/30 backdrop-blur-xl">
             <div class="flex justify-between items-center mb-8">
                <h2 class="text-xl font-bold text-white flex items-center gap-2">
                    <i data-feather="sliders" class="w-5 h-5 text-emerald-500"></i>
                    Control Center
                </h2>
                <div class="text-xs text-gray-500">
                    <i data-feather="info" class="w-3 h-3 inline mr-1"></i>
                    Le modifiche vengono salvate automaticamente
                </div>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="budgetControls">
                 <!-- Dynamic Controls -->
            </div>
        </div>

    </main>

    {{> expensebar/footer}}

    <script src="{{base_url}}/js/lib/sweetalert2.all.min.js"></script>
    <script>
        window.MCAG_BASE_URL = "{{base_url}}";
        window.MCAG_API_URL = "{{base_url}}/expensebar/api";
    </script>
    <script src="{{base_url}}/js/pages/expensebar_budget.js"></script>
    <script>
        feather.replace();
    </script>
</body>
</html>
