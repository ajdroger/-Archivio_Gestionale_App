<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /MCAG_Militare-Civile-Archivio-Gestionale/

    # If the request already contains "public", stop rewriting
    RewriteCond %{REQUEST_URI} /public/
    RewriteRule ^ - [L]

    # Forward everything else to public folder
    RewriteRule ^$ public/ [L]
    RewriteRule (.*) public/$1 [L]
</IfModule>
