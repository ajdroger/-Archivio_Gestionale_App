# ----------------------------------------------------------------------
# SECURITY: BLOCK SENSITIVE FILES
# ----------------------------------------------------------------------

# Disable Directory Browsing
Options -Indexes

# Block access to SQLite databases, Environment files, Logs, Git, Configs, Text Logs
<FilesMatch "\.(sqlite|sqlite3|db|env|log|txt|ini|git|yml|xml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Block access to Dependency Manager files
<FilesMatch "^(composer\.json|composer\.lock|package\.json|package-lock\.json|phinx\.php|phpunit\.xml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Block access to Root Debug Scripts (if any remain)
<FilesMatch "^debug_.*\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
