APP_ENV=production
APP_DEBUG=false
APP_URL=https://tuo-dominio.com

# Database Configuration (SQLite by default for portability)
DB_CONNECTION=sqlite
DB_DATABASE=../database.sqlite
# For MySQL:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=fratellanza
# DB_USERNAME=root
# DB_PASSWORD=secret

# Security
SESSION_SECURE=true
# Generate a strong 32-char string for encryption keys if needed

# Mail Server (SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=null
SMTP_PASS=null
SMTP_FROM_EMAIL=noreply@fratellanza.it
SMTP_FROM_NAME="Fratellanza Militare Archivio"

# Logging & Monitoring
SENTRY_DSN=
LOG_LEVEL=error

# Performance (Redis)
# Leave empty to use File Cache
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
